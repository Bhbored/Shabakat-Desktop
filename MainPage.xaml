<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Shabakat"
             xmlns:components="clr-namespace:Shabakat.Components"
             x:Class="Shabakat.MainPage">

    <BlazorWebView x:Name="blazorWebView"
                   HostPage="wwwroot/index.html"
                   BlazorWebViewInitializing="OnWebViewInitializing">
        <BlazorWebView.RootComponents>
            <RootComponent Selector="#app" ComponentType="{x:Type components:AppRoot}" />
        </BlazorWebView.RootComponents>
    </BlazorWebView>

</ContentPage>
