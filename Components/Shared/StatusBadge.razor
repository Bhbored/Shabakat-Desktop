@namespace Shabakat.Components.Shared
@inject IStringLocalizer<SharedResource> L

@{
    var key = (Status ?? string.Empty).Trim().ToLowerInvariant() switch
    {
        "paid" => "paid",
        "unpaid" => "unpaid",
        "overdue" => "overdue",
        "partiallypaid" or "partial" => "partiallyPaid",
        "active" => "active",
        "suspended" => "suspended",
        "terminated" => "terminated",
        _ => ""
    };
}

@switch (key)
{
    case "paid":
        <span class="inline-flex items-center gap-1 rounded-full border border-emerald-400/20 bg-emerald-400/10 px-2 py-0.5 text-xs font-medium text-emerald-600">
            @L["Status.Paid"]
        </span>
        break;
    case "unpaid":
        <span class="inline-flex items-center gap-1 rounded-full border border-amber-400/20 bg-amber-400/10 px-2 py-0.5 text-xs font-medium text-amber-600">
            @L["Status.Unpaid"]
        </span>
        break;
    case "overdue":
        <span class="inline-flex items-center gap-1 rounded-full border border-red-400/20 bg-red-400/10 px-2 py-0.5 text-xs font-medium text-red-500">
            @L["Status.Overdue"]
        </span>
        break;
    case "partiallyPaid":
        <span class="inline-flex items-center gap-1 rounded-full border border-blue-400/20 bg-blue-400/10 px-2 py-0.5 text-xs font-medium text-blue-500">
            @L["Status.PartiallyPaid"]
        </span>
        break;
    case "active":
        <span class="inline-flex items-center gap-1 rounded-full border border-emerald-400/20 bg-emerald-400/10 px-2 py-0.5 text-xs font-medium text-emerald-600">
            @L["Status.Active"]
        </span>
        break;
    case "suspended":
        <span class="inline-flex items-center gap-1 rounded-full border border-amber-400/20 bg-amber-400/10 px-2 py-0.5 text-xs font-medium text-amber-600">
            @L["Status.Suspended"]
        </span>
        break;
    case "terminated":
        <span class="inline-flex items-center gap-1 rounded-full border border-red-400/20 bg-red-400/10 px-2 py-0.5 text-xs font-medium text-red-500">
            @L["Status.Terminated"]
        </span>
        break;
    default:
        <span class="text-xs text-muted-foreground">@(string.IsNullOrWhiteSpace(Status) ? L["Common.Dash"] : Status)</span>
        break;
}

@code {
    [Parameter] public string Status { get; set; } = "";
}
