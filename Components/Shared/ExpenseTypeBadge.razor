@* Expense category badge *@

@switch (Category)
{
    case "Fuel":
        <span class="inline-flex items-center rounded-full bg-amber-400/10 px-2.5 py-0.5 text-xs font-semibold text-amber-400">Fuel</span>
        break;
    case "Maintenance":
        <span class="inline-flex items-center rounded-full bg-blue-400/10 px-2.5 py-0.5 text-xs font-semibold text-blue-400">Maintenance</span>
        break;
    case "Parts":
        <span class="inline-flex items-center rounded-full bg-purple-400/10 px-2.5 py-0.5 text-xs font-semibold text-purple-400">Parts</span>
        break;
    case "Employees":
        <span class="inline-flex items-center rounded-full bg-emerald-400/10 px-2.5 py-0.5 text-xs font-semibold text-emerald-400">Employees</span>
        break;
    case "Other":
        <span class="inline-flex items-center rounded-full bg-muted px-2.5 py-0.5 text-xs font-semibold text-muted-foreground">Other</span>
        break;
    default:
        <span class="inline-flex items-center rounded-full bg-muted px-2.5 py-0.5 text-xs font-semibold text-muted-foreground">@Category</span>
        break;
}

@code {
    [Parameter] public string Category { get; set; } = "";
}
