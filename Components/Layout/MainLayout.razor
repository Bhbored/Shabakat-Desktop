@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager NavigationManager
@inject IAppUserService AppUserService
@inject IThemeService ThemeService
@inject ICultureService CultureService
@inject IStringLocalizer<SharedResource> L
@inject IJSRuntime Js

<div class="flex min-h-dvh bg-background">
    <aside class="w-[250px] shrink-0 hidden md:flex md:flex-col md:sticky md:top-0 md:h-screen border-r border-border bg-sidebar">
        <NavMenu DisplayName="@_displayName" Initials="@_initials" LogoSrc="@_logoSrc" />
    </aside>

    <div class="flex min-w-0 flex-1 flex-col">
        <header class="sticky top-0 z-30 flex h-16 items-center gap-4 border-b border-border bg-background/85 px-4 backdrop-blur-xl md:px-6">
            <button class="md:hidden rounded-lg p-1 text-muted-foreground hover:text-foreground" @onclick="ToggleMobileNav">
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                    <line x1="9" y1="3" x2="9" y2="21"/>
                </svg>
            </button>

            <div class="min-w-0 flex-1">
                <h1 class="truncate text-base font-semibold text-foreground">@CurrentPageTitle</h1>
                <p class="hidden text-xs text-muted-foreground sm:block">@CurrentPageSubtitle</p>
            </div>

            <div class="flex items-center gap-2">
                <a href="subscribers" class="relative hidden md:flex items-center">
                    <svg class="absolute start-3 top-1/2 h-4 w-4 -translate-y-1/2 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                    <span class="w-60 rounded-xl border border-border bg-secondary py-2 pe-4 ps-9 text-sm text-muted-foreground">@L["Nav.QuickSearch"]</span>
                </a>
                <a href="audit"
                   class="inline-flex h-8 w-8 items-center justify-center rounded-full border border-border bg-card text-muted-foreground transition hover:bg-muted hover:text-foreground"
                   title="@L["Nav.AuditLogs"]"
                   aria-label="@L["Nav.OpenAuditLogs"]">
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/><path d="M12 7v5l4 2"/></svg>
                </a>
                <div class="flex h-8 w-8 items-center justify-center overflow-hidden rounded-full text-white text-xs font-semibold" style="background-color: @FormatHelper.AvatarColor(_displayName);">
                    @if (!string.IsNullOrWhiteSpace(_logoSrc))
                    {
                        <img src="@_logoSrc" alt="" class="h-full w-full object-cover" />
                    }
                    else
                    {
                        @_initials
                    }
                </div>
            </div>
        </header>

        <main class="flex-1 overflow-y-auto px-4 pb-24 pt-4 md:px-6 md:pb-6">
            @Body
        </main>
    </div>

    <BottomNavigation />

    @if (_mobileNavOpen)
    {
        <div class="md:hidden fixed inset-0 z-50">
            <div class="fixed inset-0 bg-black/50" @onclick="ToggleMobileNav"></div>
            <aside class="fixed inset-y-0 start-0 w-[280px] bg-sidebar border-e border-sidebar-border shadow-xl flex flex-col">
                <NavMenu DisplayName="@_displayName" Initials="@_initials" LogoSrc="@_logoSrc" OnNavigate="CloseMobileNav" />
            </aside>
        </div>
    }
</div>

@code {
    private bool _mobileNavOpen;
    private string _displayName = "Admin";
    private string _initials = "AD";
    private string? _logoSrc;

    protected override async Task OnInitializedAsync()
    {
        ThemeService.Changed += OnThemeChanged;
        CultureService.Changed += OnCultureChanged;
        AppUserService.Changed += OnProfileChanged;
        await ApplyThemeAsync();
        await LoadProfileAsync();
    }

    private void OnProfileChanged() => _ = InvokeAsync(async () =>
    {
        await LoadProfileAsync();
        StateHasChanged();
    });

    private async Task LoadProfileAsync()
    {
        var profile = await AppUserService.GetAsync();
        if (profile is null)
        {
            _logoSrc = null;
            return;
        }

        if (!string.IsNullOrWhiteSpace(profile.BusinessName))
        {
            _displayName = profile.BusinessName;
            _initials = FormatHelper.Initials(profile.BusinessName);
        }

        _logoSrc = CompanyLogoStore.ToDataUri(profile.LogoUrl);
    }

    private void OnThemeChanged() => _ = InvokeAsync(ApplyThemeAsync);

    private void OnCultureChanged() => _ = InvokeAsync(StateHasChanged);

    private async Task ApplyThemeAsync()
    {
        var theme = ThemeService.ResolvedTheme;
        await Js.InvokeVoidAsync("eval", $@"
            document.documentElement.setAttribute('data-theme', '{theme}');
            try {{ localStorage.setItem('shabakat-theme-ui', '{theme}'); }} catch (_) {{}}
        ");
    }

    private string CurrentPageTitle => CurrentPageCopy.Title;
    private string CurrentPageSubtitle => CurrentPageCopy.Subtitle;

    private (string Title, string Subtitle) CurrentPageCopy
    {
        get
        {
            var relative = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
            var query = relative.IndexOf('?', StringComparison.Ordinal);
            if (query >= 0)
                relative = relative[..query];

            var path = relative.Trim('/').ToLowerInvariant();
            if (path.StartsWith("subscribers", StringComparison.Ordinal))
                return (L["Page.Subscribers.Title"].Value, L["Page.Subscribers.Subtitle"].Value);
            if (path.StartsWith("settings/pricing/", StringComparison.Ordinal))
            {
                return path switch
                {
                    "settings/pricing/price-per-kilowatt" => (L["Page.SettingsPricePerKw.Title"].Value, L["Page.SettingsPricePerKw.Subtitle"].Value),
                    "settings/pricing/price-per-amp" => (L["Page.SettingsPricePerAmp.Title"].Value, L["Page.SettingsPricePerAmp.Subtitle"].Value),
                    "settings/pricing/fixed-charge" => (L["Page.SettingsFixedCharge.Title"].Value, L["Page.SettingsFixedCharge.Subtitle"].Value),
                    "settings/pricing/tva" => (L["Page.SettingsTva.Title"].Value, L["Page.SettingsTva.Subtitle"].Value),
                    _ => (L["Page.Settings.Title"].Value, L["Page.Settings.Subtitle"].Value)
                };
            }

            return path switch
            {
                "areas" => (L["Page.Areas.Title"].Value, L["Page.Areas.Subtitle"].Value),
                "ampere-schedules" => (L["Page.AmpereSchedules.Title"].Value, L["Page.AmpereSchedules.Subtitle"].Value),
                "boxes" => (L["Page.Boxes.Title"].Value, L["Page.Boxes.Subtitle"].Value),
                "invoices" => (L["Page.Invoices.Title"].Value, L["Page.Invoices.Subtitle"].Value),
                "calculator" => (L["Page.Calculator.Title"].Value, L["Page.Calculator.Subtitle"].Value),
                "expenses" => (L["Page.Expenses.Title"].Value, L["Page.Expenses.Subtitle"].Value),
                "audit" => (L["Page.Audit.Title"].Value, L["Page.Audit.Subtitle"].Value),
                "settings" => (L["Page.Settings.Title"].Value, L["Page.Settings.Subtitle"].Value),
                "settings/due-date" => (L["Page.SettingsDueDate.Title"].Value, L["Page.SettingsDueDate.Subtitle"].Value),
                "settings/language" => (L["Page.SettingsLanguage.Title"].Value, L["Page.SettingsLanguage.Subtitle"].Value),
                "settings/ampere-schedule-pricing" => (L["Page.SettingsAmpereSchedulePricing.Title"].Value, L["Page.SettingsAmpereSchedulePricing.Subtitle"].Value),
                "settings/ampere-proration" => (L["Page.SettingsAmpereProration.Title"].Value, L["Page.SettingsAmpereProration.Subtitle"].Value),
                "settings/whatsapp" => (L["Page.SettingsWhatsApp.Title"].Value, L["Page.SettingsWhatsApp.Subtitle"].Value),
                "settings/company-logo" => (L["Page.SettingsCompanyLogo.Title"].Value, L["Page.SettingsCompanyLogo.Subtitle"].Value),
                "settings/excel-export" => (L["Page.SettingsExcelExport.Title"].Value, L["Page.SettingsExcelExport.Subtitle"].Value),
                "settings/backup" => (L["Page.SettingsBackup.Title"].Value, L["Page.SettingsBackup.Subtitle"].Value),
                "settings/testing" => (L["Page.SettingsTesting.Title"].Value, L["Page.SettingsTesting.Subtitle"].Value),
                _ => (L["Page.Dashboard.Title"].Value, L["Page.Dashboard.Subtitle"].Value)
            };
        }
    }

    private void ToggleMobileNav() => _mobileNavOpen = !_mobileNavOpen;

    private void CloseMobileNav() => _mobileNavOpen = false;

    public void Dispose()
    {
        ThemeService.Changed -= OnThemeChanged;
        CultureService.Changed -= OnCultureChanged;
        AppUserService.Changed -= OnProfileChanged;
    }
}
