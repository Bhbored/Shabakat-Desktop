@using Shabakat.Components.Shared

<NavLink href="" Match="NavLinkMatch.All" class="flex items-center gap-2.5 min-h-[3.5rem] bg-sidebar px-4 border-b border-sidebar-border no-underline hover:bg-sidebar-accent/50">
    <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-primary text-primary-foreground shrink-0" style="box-shadow: 0 0 16px rgba(230,196,58,0.35);">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" stroke="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M13 2L3 14h6l-2 8 10-12h-6l2-8z"/>
        </svg>
    </div>
    <div class="min-w-0">
        <p class="text-sm font-bold leading-tight text-sidebar-foreground">Shabakat</p>
        <p class="text-xs leading-tight text-muted-foreground">Operator Management</p>
    </div>
</NavLink>

<div class="flex-1 overflow-y-auto px-2">
