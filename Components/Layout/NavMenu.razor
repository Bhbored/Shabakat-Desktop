        <div class="flex h-9 w-9 items-center justify-center rounded-full text-white text-sm font-semibold shrink-0" style="background-color: #7c3aed;">AS</div>
        <div class="min-w-0">
            <p class="truncate text-sm font-medium text-sidebar-foreground">Admin User</p>
            <p class="truncate text-xs text-muted-foreground">Owner · Shabakat</p>
        </div>
    </div>
    <button class="flex w-full items-center justify-center gap-2 rounded-xl border border-sidebar-border px-3 py-2 mt-3 text-sm text-muted-foreground hover:text-sidebar-foreground hover:bg-sidebar-accent transition-colors">
        <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
