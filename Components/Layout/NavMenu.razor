@using Shabakat.Components.Shared

<NavLink href="" Match="NavLinkMatch.All" class="flex items-center gap-2.5 min-h-[3.5rem] bg-sidebar px-4 border-b border-sidebar-border no-underline hover:bg-sidebar-accent/50" @onclick="HandleNavigate">
    <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-primary text-primary-foreground shrink-0" style="box-shadow: 0 0 16px rgba(230,196,58,0.35);">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" stroke="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M13 2L3 14h6l-2 8 10-12h-6l2-8z"/>
        </svg>
    </div>
    <div class="min-w-0">
        <p class="text-sm font-bold leading-tight text-sidebar-foreground">Shabakat</p>
        <p class="text-xs leading-tight text-muted-foreground">Operator Management</p>
    </div>
</NavLink>

<div class="flex-1 overflow-y-auto px-2">
    <div class="pt-4 pb-2">
        <p class="px-3 pb-2 text-[10px] font-semibold uppercase tracking-[0.25em] text-muted-foreground">Main Menu</p>
        <nav class="flex flex-col space-y-1.5">
            <NavLink href="" Match="NavLinkMatch.All" class="@LinkClass" @onclick="HandleNavigate">
                <svg class="h-4 w-4 shrink-0 mr-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
                Dashboard
            </NavLink>
            <NavLink href="areas" class="@LinkClass" @onclick="HandleNavigate">
                <svg class="h-4 w-4 shrink-0 mr-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                Areas
            </NavLink>
            <NavLink href="ampere-schedules" class="@LinkClass" @onclick="HandleNavigate">
                <svg class="h-4 w-4 shrink-0 mr-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                Ampere Schedules
            </NavLink>
            <NavLink href="boxes" class="@LinkClass" @onclick="HandleNavigate">
                <svg class="h-4 w-4 shrink-0 mr-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
                Boxes
            </NavLink>
            <NavLink href="subscribers" class="@LinkClass" @onclick="HandleNavigate">
                <svg class="h-4 w-4 shrink-0 mr-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                Subscribers
            </NavLink>
            <NavLink href="invoices" class="@LinkClass" @onclick="HandleNavigate">
                <svg class="h-4 w-4 shrink-0 mr-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
                Invoices
            </NavLink>
            <NavLink href="calculator" class="@LinkClass" @onclick="HandleNavigate">
                <svg class="h-4 w-4 shrink-0 mr-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="2" width="16" height="20" rx="2"/><line x1="8" y1="6" x2="16" y2="6"/><line x1="8" y1="10" x2="8" y2="10.01"/><line x1="12" y1="10" x2="12" y2="10.01"/><line x1="16" y1="10" x2="16" y2="10.01"/><line x1="8" y1="14" x2="8" y2="14.01"/><line x1="12" y1="14" x2="12" y2="14.01"/><line x1="16" y1="14" x2="16" y2="14.01"/><line x1="8" y1="18" x2="8" y2="18.01"/><line x1="12" y1="18" x2="16" y2="18"/></svg>
                Calculator
            </NavLink>
            <NavLink href="expenses" class="@LinkClass" @onclick="HandleNavigate">
                <svg class="h-4 w-4 shrink-0 mr-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12V7H5a2 2 0 0 1 0-4h14v4"/><path d="M3 5v14a2 2 0 0 0 2 2h16v-5"/><path d="M18 12a2 2 0 0 0 0 4h4v-4h-4z"/></svg>
                Expenses
            </NavLink>
            <NavLink href="settings" class="@LinkClass" @onclick="HandleNavigate">
                <svg class="h-4 w-4 shrink-0 mr-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
                Settings
            </NavLink>
        </nav>
    </div>
</div>

<div class="border-t border-sidebar-border px-4 py-4">
    <div class="flex items-center gap-3">
        <div class="flex h-9 w-9 items-center justify-center overflow-hidden rounded-full text-white text-sm font-semibold shrink-0" style="background-color: @FormatHelper.AvatarColor(DisplayName);">
            @if (!string.IsNullOrWhiteSpace(LogoSrc))
            {
                <img src="@LogoSrc" alt="" class="h-full w-full object-cover" />
            }
            else
            {
                @Initials
            }
        </div>
        <div class="min-w-0">
            <p class="truncate text-sm font-medium text-sidebar-foreground">@DisplayName</p>
            <p class="truncate text-xs text-muted-foreground">Operator · Shabakat</p>
        </div>
    </div>
</div>

@code {
    [Parameter] public string DisplayName { get; set; } = "Admin";
    [Parameter] public string Initials { get; set; } = "AD";
    [Parameter] public string? LogoSrc { get; set; }
    [Parameter] public EventCallback OnNavigate { get; set; }

    private const string LinkClass =
        "flex items-center h-11 w-full no-underline rounded-xl px-3 text-sm text-muted-foreground hover:bg-sidebar-accent hover:text-sidebar-foreground [&.active]:bg-primary [&.active]:text-primary-foreground";

    private async Task HandleNavigate()
    {
        if (OnNavigate.HasDelegate)
            await OnNavigate.InvokeAsync();
    }
}
