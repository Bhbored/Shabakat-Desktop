@namespace Shabakat.Components
@implements IDisposable
@inject ICultureService CultureService
@inject ILicenseService LicenseService
@inject IStringLocalizer<SharedResource> L
@inject IJSRuntime Js

<div class="h-full min-h-full bg-background">
    @if (_status == LicenseStatus.SetupRequired)
    {
        <LicenseGate IsSetup="true" />
    }
    else if (_status == LicenseStatus.Expired)
    {
        <LicenseGate IsSetup="false" />
    }
    else if (_status == LicenseStatus.Active)
    {
        <Routes @key="CultureService.Language" />
    }

    @if (!_splashDone)
    {
        <AppSplash OnFinished="HideSplash" />
    }

    <Toaster />

    <ConfirmDialog Open="_contactOpen"
                   Title="@L["License.Contact.Title"]"
                   OnClose="DismissContact">
        <ChildContent>
            <p>@ContactMessage</p>
        </ChildContent>
        <Footer>
            <button type="button"
                    class="rounded-xl bg-secondary px-4 py-2.5 text-sm font-medium text-foreground"
                    @onclick="DismissContact">
                @L["Common.Done"]
            </button>
        </Footer>
    </ConfirmDialog>
</div>

@code {
    private bool _splashDone;
    private bool _contactOpen;
    private LicenseStatus? _status;
    private LicenseRestoreNotice _restoreNotice;

    protected override void OnInitialized()
    {
        CultureService.Changed += OnCultureChanged;
        LicenseService.Changed += OnLicenseChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        await RefreshStatusAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await ApplyDocumentCultureAsync();
    }

    private void HideSplash() => _splashDone = true;

    private void OnCultureChanged() => _ = InvokeAsync(async () =>
    {
        await ApplyDocumentCultureAsync();
        StateHasChanged();
    });

    private void OnLicenseChanged() => _ = InvokeAsync(async () =>
    {
        await RefreshStatusAsync();
        _restoreNotice = LicenseService.TakeRestoreNotice();
        _contactOpen = _restoreNotice != LicenseRestoreNotice.None;
        StateHasChanged();
    });

    private void DismissContact() => _contactOpen = false;

    private string ContactMessage => _restoreNotice switch
    {
        LicenseRestoreNotice.Expired => L["License.Contact.Expired"],
        LicenseRestoreNotice.Tampered => L["License.Contact.Tampered"],
        LicenseRestoreNotice.Missing => L["License.Contact.Missing"],
        _ => L["License.Contact.Expired"]
    };

    private async Task RefreshStatusAsync()
    {
        _status = await LicenseService.GetStatusAsync();
    }

    private async Task ApplyDocumentCultureAsync()
    {
        var lang = CultureService.IsRtl ? "ar" : "en";
        var dir = CultureService.IsRtl ? "rtl" : "ltr";
        await Js.InvokeVoidAsync("eval", $@"
            document.documentElement.setAttribute('lang', '{lang}');
            document.documentElement.setAttribute('dir', '{dir}');
            try {{ localStorage.setItem('shabakat-lang', '{lang}'); }} catch (_) {{}}
        ");
    }

    public void Dispose()
    {
        CultureService.Changed -= OnCultureChanged;
        LicenseService.Changed -= OnLicenseChanged;
    }
}
