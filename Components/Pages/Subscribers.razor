@page "/subscribers"
@using Shabakat.Components.Shared
@using System.Linq

<div class="space-y-4">
    <div class="flex flex-wrap items-center gap-3 xl:flex-nowrap">
        <div class="flex min-w-72 flex-1 gap-2">
            <select class="w-36 shrink-0 rounded-xl border border-border bg-card px-3 py-2.5 text-sm text-foreground" @bind="searchField">
                <option value="name">Name</option>
                <option value="phone">Phone</option>
            </select>
            <input type="text" class="w-full rounded-xl border border-border bg-card px-4 py-2.5 text-sm text-foreground outline-none focus:border-primary" placeholder="@(searchField == "name" ? "Search by name..." : "Search by phone...")" @bind="searchTerm" @bind:event="oninput" />
        </div>
        <select class="min-w-56 rounded-xl border border-border bg-card px-3 py-2.5 text-sm text-foreground" @bind="areaFilter">
            <option value="">All Areas</option>
            @foreach (var area in areas)
            {
                <option value="@area">@area</option>
            }
        </select>
        <select class="min-w-40 rounded-xl border border-border bg-card px-3 py-2.5 text-sm text-foreground" @bind="planFilter">
            <option value="">All Plans</option>
            <option value="Ampere">Ampere</option>
            <option value="Kilowatt">Kilowatt</option>
            <option value="FixedKilowatt">Fixed Kilowatt</option>
        </select>
        <button class="rounded-xl bg-primary px-4 py-2.5 text-sm font-medium text-primary-foreground" style="box-shadow: 0 0 16px rgba(230,196,58,0.25);">+ Add Subscriber</button>
    </div>

    <div class="flex flex-wrap items-center gap-3">
        <select class="min-w-40 rounded-xl border border-border bg-card px-3 py-2.5 text-sm text-foreground" @bind="statusFilter">
            <option value="">All Statuses</option>
            <option value="paid">Paid</option>
            <option value="unpaid">Unpaid</option>
            <option value="overdue">Overdue</option>
        </select>
        <span class="text-xs text-muted-foreground">@filteredData.Count() subscriber@(filteredData.Count() != 1 ? "s" : "") found</span>
    </div>

    <section class="rounded-2xl border border-border bg-card overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full min-w-[860px]">
                <thead>
                    <tr class="border-b border-border">
                        <th class="px-4 py-3.5 text-left text-xs font-semibold uppercase tracking-[0.18em] text-muted-foreground">Name</th>
                        <th class="px-4 py-3.5 text-left text-xs font-semibold uppercase tracking-[0.18em] text-muted-foreground">Phone</th>
                        <th class="px-4 py-3.5 text-left text-xs font-semibold uppercase tracking-[0.18em] text-muted-foreground">Area</th>
                        <th class="px-4 py-3.5 text-left text-xs font-semibold uppercase tracking-[0.18em] text-muted-foreground">Plan</th>
                        <th class="px-4 py-3.5 text-left text-xs font-semibold uppercase tracking-[0.18em] text-muted-foreground">Since</th>
                        <th class="px-4 py-3.5 text-left text-xs font-semibold uppercase tracking-[0.18em] text-muted-foreground">Status</th>
                        <th class="px-4 py-3.5 text-left text-xs font-semibold uppercase tracking-[0.18em] text-muted-foreground">Amount Due</th>
                        <th class="px-4 py-3.5"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var sub in pagedData)
                    {
                        <tr class="border-b border-border hover:bg-muted/30">
                            <td class="px-4 py-3.5">
                                <div class="flex items-center gap-3">
                                    <div class="flex h-8 w-8 items-center justify-center rounded-full text-white text-xs font-semibold shrink-0" style="background-color: @GetAvatarColor(sub.Name)">@GetInitials(sub.Name)</div>
                                    <span class="whitespace-nowrap text-sm font-medium text-foreground">@sub.Name</span>
                                </div>
                            </td>
                            <td class="px-4 py-3.5 font-mono text-sm text-muted-foreground">@(sub.Phone ?? "—")</td>
                            <td class="px-4 py-3.5 text-sm text-foreground">@(sub.Area ?? "Unassigned")</td>
                            <td class="px-4 py-3.5">
                                <span class="font-mono text-sm font-bold text-primary">
                                    @(sub.Plan == "Ampere" ? $"{sub.PlanValue}A" : sub.Plan == "FixedKilowatt" ? $"{sub.PlanValue}kW prepaid" : $"{sub.PlanValue}kW")
                                </span>
                            </td>
                            <td class="px-4 py-3.5 whitespace-nowrap text-sm text-muted-foreground">@MockData.FormatDate(sub.SubscriptionDate)</td>
                            <td class="px-4 py-3.5"><StatusBadge Status="@sub.Status" /></td>
                            <td class="px-4 py-3.5 font-mono text-sm font-semibold text-foreground">@MockData.FormatCurrency(sub.AmountDue)</td>
                            <td class="px-4 py-3.5">
                                <button class="rounded-lg p-1 text-muted-foreground hover:text-foreground">
                                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="1"/><circle cx="19" cy="12" r="1"/><circle cx="5" cy="12" r="1"/></svg>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="flex flex-col gap-3 border-t border-border px-4 py-3 text-sm text-muted-foreground md:flex-row md:items-center md:justify-between">
            <span>Showing @(currentPage * pageSize + 1)–@Math.Min((currentPage + 1) * pageSize, filteredData.Count()) of @filteredData.Count() subscribers</span>
            <div class="flex items-center gap-2 self-end md:self-auto">
                <select class="h-9 w-28 rounded-xl border border-border bg-card px-2 text-sm" @bind="pageSize" @bind:after="GoToFirstPage">
                    <option value="10">10 / page</option>
                    <option value="20">20 / page</option>
                    <option value="50">50 / page</option>
                </select>
                <button class="rounded-xl border border-border px-3 py-1.5 text-sm disabled:opacity-40" disabled="@(currentPage == 0)" @onclick="PrevPage">Previous</button>
                <span class="min-w-24 text-center">Page @(currentPage + 1) of @totalPages</span>
                <button class="rounded-xl border border-border px-3 py-1.5 text-sm disabled:opacity-40" disabled="@(currentPage >= totalPages - 1)" @onclick="NextPage">Next</button>
            </div>
        </div>
    </section>
</div>

@code {
    private string searchTerm = "";
    private string searchField = "name";
    private string areaFilter = "";
    private string planFilter = "";
    private string statusFilter = "";
    private int currentPage = 0;
    private int pageSize = 10;

    private string[] areas = MockData.Subscribers.Select(s => s.Area ?? "").Where(a => !string.IsNullOrEmpty(a)).Distinct().OrderBy(a => a).ToArray();

    private IEnumerable<SubscriberData> filteredData
    {
        get
        {
            var query = MockData.Subscribers.AsEnumerable();
            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                var term = searchTerm.Trim().ToLower();
                query = searchField == "name"
                    ? query.Where(s => s.Name.ToLower().Contains(term))
                    : query.Where(s => (s.Phone ?? "").ToLower().Contains(term));
            }
            if (!string.IsNullOrEmpty(areaFilter)) query = query.Where(s => s.Area == areaFilter);
            if (!string.IsNullOrEmpty(planFilter)) query = query.Where(s => s.Plan == planFilter);
            if (!string.IsNullOrEmpty(statusFilter)) query = query.Where(s => s.Status == statusFilter);
            return query;
        }
    }

    private SubscriberData[] pagedData => filteredData.Skip(currentPage * pageSize).Take(pageSize).ToArray();
    private int totalPages => Math.Max(1, (int)Math.Ceiling((double)filteredData.Count() / pageSize));

    private void NextPage() { if (currentPage < totalPages - 1) currentPage++; }
    private void PrevPage() { if (currentPage > 0) currentPage--; }
    private void GoToFirstPage() { currentPage = 0; }

    private static readonly string[] AvatarColors = new[] { "#7c3aed", "#2563eb", "#059669", "#db2777", "#ea580c", "#0891b2", "#d97706" };
    private string GetAvatarColor(string name) => AvatarColors[Math.Abs(name.GetHashCode()) % AvatarColors.Length];
    private string GetInitials(string name) => string.Join("", name.Split(' ').Take(2).Select(w => w[0])).ToUpperInvariant();
}
