@page "/settings/trigger-message"

<div class="space-y-5">
    <NavLink href="settings" class="inline-flex items-center gap-1 text-xs text-muted-foreground hover:text-foreground no-underline mb-2">
        <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
        Back to Settings
    </NavLink>
    <h1 class="text-xl font-bold text-foreground">Reminder Message</h1>
    <p class="text-xs text-muted-foreground">Customize the payment reminder message sent to subscribers</p>

    <section class="rounded-2xl border border-border bg-card p-5 space-y-4">
        <div>
            <label class="text-sm font-medium text-foreground">Message Template</label>
            <textarea class="mt-2 w-full rounded-xl border border-border bg-muted px-4 py-3 text-sm text-foreground min-h-32" rows="4">
Dear {Name}, your invoice #{Number} for ${Amount} is due on {DueDate}. Please pay before the due date to avoid service interruption. Thank you - Shabakat</textarea>
            <p class="mt-1 text-xs text-muted-foreground">Available variables: {'{'}Name{'}'}, {'{'}Number{'}'}, {'{'}Amount{'}'}, {'{'}DueDate{'}'}</p>
        </div>
    </section>
    <button class="rounded-xl bg-primary px-4 py-2.5 text-sm font-medium text-primary-foreground">Save Changes</button>
</div>
