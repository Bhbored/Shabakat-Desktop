@page "/settings"

<div class="space-y-5">
    <div>
        <h1 class="text-xl font-bold text-foreground">Settings</h1>
        <p class="text-xs text-muted-foreground">Configure your application preferences</p>
    </div>

    <section class="rounded-2xl border border-border bg-card p-5">
        <h2 class="text-sm font-semibold text-foreground">Pricing Configuration</h2>
        <p class="mt-1 text-xs text-muted-foreground">Manage billing rates and charges</p>
        <div class="mt-5 space-y-3">
            <NavLink href="settings/pricing" class="flex items-center justify-between rounded-xl bg-muted/50 px-4 py-3 no-underline hover:bg-muted">
                <span class="text-sm text-foreground">Price per Kilowatt</span>
                <span class="font-mono text-sm text-muted-foreground">$0.12/kWh</span>
            </NavLink>
            <NavLink href="settings/pricing" class="flex items-center justify-between rounded-xl bg-muted/50 px-4 py-3 no-underline hover:bg-muted">
                <span class="text-sm text-foreground">Price per Amp</span>
                <span class="font-mono text-sm text-muted-foreground">$17.00/A</span>
            </NavLink>
            <NavLink href="settings/pricing" class="flex items-center justify-between rounded-xl bg-muted/50 px-4 py-3 no-underline hover:bg-muted">
                <span class="text-sm text-foreground">Fixed Charge</span>
                <span class="font-mono text-sm text-muted-foreground">$15.00</span>
            </NavLink>
            <NavLink href="settings/pricing" class="flex items-center justify-between rounded-xl bg-muted/50 px-4 py-3 no-underline hover:bg-muted">
                <span class="text-sm text-foreground">TVA Rate</span>
                <span class="font-mono text-sm text-muted-foreground">11%</span>
            </NavLink>
        </div>
    </section>

    <section class="rounded-2xl border border-border bg-card p-5">
        <h2 class="text-sm font-semibold text-foreground">Billing Schedule</h2>
        <p class="mt-1 text-xs text-muted-foreground">Configure billing cycles and payment triggers</p>
        <div class="mt-5 space-y-3">
            <NavLink href="settings/due-date" class="flex items-center justify-between rounded-xl bg-muted/50 px-4 py-3 no-underline hover:bg-muted">
                <span class="text-sm text-foreground">Due Date</span>
                <span class="font-mono text-sm text-muted-foreground">15th of each month</span>
            </NavLink>
            <NavLink href="settings/trigger-date" class="flex items-center justify-between rounded-xl bg-muted/50 px-4 py-3 no-underline hover:bg-muted">
                <span class="text-sm text-foreground">Trigger Date</span>
                <span class="font-mono text-sm text-muted-foreground">1st of each month</span>
            </NavLink>
            <NavLink href="settings/trigger-message" class="flex items-center justify-between rounded-xl bg-muted/50 px-4 py-3 no-underline hover:bg-muted">
                <span class="text-sm text-foreground">Trigger Message</span>
                <span class="font-mono text-sm text-muted-foreground">Enabled</span>
            </NavLink>
            <NavLink href="settings/whatsapp" class="flex items-center justify-between rounded-xl bg-muted/50 px-4 py-3 no-underline hover:bg-muted">
                <span class="text-sm text-foreground">WhatsApp Notifications</span>
                <span class="font-mono text-sm text-muted-foreground">Configured</span>
            </NavLink>
        </div>
    </section>

    <div class="grid gap-4 md:grid-cols-2">
        <section class="rounded-2xl border border-border bg-card p-5">
            <h2 class="text-sm font-semibold text-foreground">Company</h2>
            <p class="mt-1 text-xs text-muted-foreground">Your business information</p>
            <div class="mt-5 space-y-3">
                <NavLink href="settings/company-logo" class="flex items-center justify-between rounded-xl bg-muted/50 px-4 py-3 no-underline hover:bg-muted">
                    <span class="text-sm text-foreground">Company Logo</span>
                    <span class="text-sm text-muted-foreground">Shabakat</span>
                </NavLink>
                <NavLink href="settings/language" class="flex items-center justify-between rounded-xl bg-muted/50 px-4 py-3 no-underline hover:bg-muted">
                    <span class="text-sm text-foreground">Language</span>
                    <span class="text-sm text-muted-foreground">English</span>
                </NavLink>
            </div>
        </section>

        <section class="rounded-2xl border border-border bg-card p-5">
            <h2 class="text-sm font-semibold text-foreground">Advanced</h2>
            <p class="mt-1 text-xs text-muted-foreground">Additional pricing options</p>
            <div class="mt-5 space-y-3">
                <NavLink href="settings/ampere-schedule-pricing" class="flex items-center justify-between rounded-xl bg-muted/50 px-4 py-3 no-underline hover:bg-muted">
                    <span class="text-sm text-foreground">Schedule-Based Pricing</span>
                    <span class="font-mono text-sm text-muted-foreground">Enabled</span>
                </NavLink>
                <NavLink href="settings/ampere-proration" class="flex items-center justify-between rounded-xl bg-muted/50 px-4 py-3 no-underline hover:bg-muted">
                    <span class="text-sm text-foreground">Proration</span>
                    <span class="font-mono text-sm text-muted-foreground">Disabled</span>
                </NavLink>
            </div>
        </section>
    </div>

    <section class="rounded-2xl border border-border bg-card p-5">
        <h2 class="text-sm font-semibold text-foreground">Appearance</h2>
        <p class="mt-1 text-xs text-muted-foreground">Customize the look and feel</p>
        <div class="mt-5 flex items-center gap-3">
            <button class="rounded-xl border-2 border-primary bg-primary/10 px-5 py-2.5 text-sm font-medium text-primary">Light</button>
            <button class="rounded-xl border border-border bg-card px-5 py-2.5 text-sm font-medium text-muted-foreground">Dark</button>
            <button class="rounded-xl border border-border bg-card px-5 py-2.5 text-sm font-medium text-muted-foreground">System</button>
        </div>
    </section>
</div>
