@page "/settings/company-logo"

<div class="space-y-5">
    <NavLink href="settings" class="inline-flex items-center gap-1 text-xs text-muted-foreground hover:text-foreground no-underline mb-2">
        <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
        Back to Settings
    </NavLink>
    <h1 class="text-xl font-bold text-foreground">Company Logo</h1>
    <p class="text-xs text-muted-foreground">Upload or change your company logo</p>

    <section class="rounded-2xl border border-border bg-card p-5">
        <div class="flex flex-col items-center gap-4 py-8">
            <div class="flex h-24 w-24 items-center justify-center rounded-2xl bg-primary text-primary-foreground" style="box-shadow: 0 0 30px rgba(230,196,58,0.3);">
                <svg class="h-10 w-10" viewBox="0 0 24 24" fill="currentColor" stroke="none"><path d="M13 2L3 14h6l-2 8 10-12h-6l2-8z"/></svg>
            </div>
            <p class="text-sm text-muted-foreground">No custom logo uploaded</p>
            <button class="rounded-xl border border-border bg-card px-4 py-2.5 text-sm font-medium text-foreground">Upload Logo</button>
        </div>
    </section>
</div>
