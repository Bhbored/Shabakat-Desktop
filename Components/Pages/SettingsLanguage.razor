@page "/settings/language"

<div class="space-y-5">
    <NavLink href="settings" class="inline-flex items-center gap-1 text-xs text-muted-foreground hover:text-foreground no-underline mb-2">
        <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
        Back to Settings
    </NavLink>
    <h1 class="text-xl font-bold text-foreground">Language</h1>
    <p class="text-xs text-muted-foreground">Choose your preferred language</p>

    <section class="rounded-2xl border border-border bg-card p-5">
        <div class="flex items-center gap-3">
            <button class="rounded-xl border-2 border-primary bg-primary/10 px-5 py-3 text-sm font-medium text-primary flex-1">
                English
            </button>
            <button class="rounded-xl border border-border bg-card px-5 py-3 text-sm font-medium text-muted-foreground flex-1">
                العربية
            </button>
        </div>
    </section>
</div>
