@page "/invoices"
@using Shabakat.Components.Shared
@using System.Linq

<div class="space-y-4">
    <div class="flex flex-wrap items-center gap-3 xl:flex-nowrap">
        <select class="min-w-56 rounded-xl border border-border bg-card px-3 py-2.5 text-sm text-foreground" @bind="customerFilter">
            <option value="">All Customers</option>
            @foreach (var cust in customers)
            {
                <option value="@cust">@cust</option>
            }
        </select>
        <select class="min-w-40 rounded-xl border border-border bg-card px-3 py-2.5 text-sm text-foreground" @bind="statusFilter">
            <option value="">All Statuses</option>
            <option value="paid">Paid</option>
            <option value="unpaid">Unpaid</option>
            <option value="partiallyPaid">Partially Paid</option>
            <option value="overdue">Overdue</option>
        </select>
        <div class="flex gap-2">
            <input type="date" class="rounded-xl border border-border bg-card px-3 py-2.5 text-sm text-foreground w-40" @bind="dateFrom" @bind:format="yyyy-MM-dd" />
            <span class="self-center text-muted-foreground">to</span>
            <input type="date" class="rounded-xl border border-border bg-card px-3 py-2.5 text-sm text-foreground w-40" @bind="dateTo" @bind:format="yyyy-MM-dd" />
        </div>
        <div class="flex gap-2 ml-auto">
            <button class="rounded-xl border border-border bg-card px-4 py-2.5 text-sm text-foreground hover:bg-muted">Bulk Create</button>
            <button class="rounded-xl bg-primary px-4 py-2.5 text-sm font-medium text-primary-foreground" style="box-shadow: 0 0 16px rgba(230,196,58,0.25);">+ Create Invoice</button>
        </div>
    </div>

    <div class="flex items-center gap-3 text-xs text-muted-foreground">
        <span>@filteredData.Count() invoice@(filteredData.Count() != 1 ? "s" : "") found</span>
    </div>

    <div class="grid gap-4 md:grid-cols-4">
        <section class="rounded-2xl border border-border bg-card p-4">
            <p class="text-xs font-semibold uppercase tracking-[0.22em] text-muted-foreground">Total Paid</p>
            <p class="mt-2 font-mono text-2xl font-bold text-emerald-600">@MockData.FormatCurrency(filteredData.Where(i => i.Status == "paid").Sum(i => i.TotalAmount))</p>
        </section>
        <section class="rounded-2xl border border-border bg-card p-4">
            <p class="text-xs font-semibold uppercase tracking-[0.22em] text-muted-foreground">Unpaid</p>
            <p class="mt-2 font-mono text-2xl font-bold text-amber-600">@MockData.FormatCurrency(filteredData.Where(i => i.Status == "unpaid").Sum(i => i.AmountDue))</p>
        </section>
        <section class="rounded-2xl border border-border bg-card p-4">
            <p class="text-xs font-semibold uppercase tracking-[0.22em] text-muted-foreground">Partially Paid</p>
            <p class="mt-2 font-mono text-2xl font-bold text-blue-400">@MockData.FormatCurrency(filteredData.Where(i => i.Status == "partiallyPaid").Sum(i => i.AmountDue))</p>
        </section>
        <section class="rounded-2xl border border-border bg-card p-4">
            <p class="text-xs font-semibold uppercase tracking-[0.22em] text-muted-foreground">Overdue</p>
            <p class="mt-2 font-mono text-2xl font-bold text-red-500">@MockData.FormatCurrency(filteredData.Where(i => i.Status == "overdue").Sum(i => i.AmountDue))</p>
        </section>
    </div>

    <section class="rounded-2xl border border-border bg-card overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full min-w-[860px]">
                <thead>
                    <tr class="border-b border-border">
                        <th class="px-4 py-3.5 text-left text-xs font-semibold uppercase tracking-[0.18em] text-muted-foreground">Invoice #</th>
                        <th class="px-4 py-3.5 text-left text-xs font-semibold uppercase tracking-[0.18em] text-muted-foreground">Customer</th>
                        <th class="px-4 py-3.5 text-left text-xs font-semibold uppercase tracking-[0.18em] text-muted-foreground">Total</th>
                        <th class="px-4 py-3.5 text-left text-xs font-semibold uppercase tracking-[0.18em] text-muted-foreground">Paid</th>
                        <th class="px-4 py-3.5 text-left text-xs font-semibold uppercase tracking-[0.18em] text-muted-foreground">Due</th>
                        <th class="px-4 py-3.5 text-left text-xs font-semibold uppercase tracking-[0.18em] text-muted-foreground">Issue Date</th>
                        <th class="px-4 py-3.5 text-left text-xs font-semibold uppercase tracking-[0.18em] text-muted-foreground">Status</th>
                        <th class="px-4 py-3.5"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var inv in pagedData)
                    {
                        <tr class="border-b border-border hover:bg-muted/30">
                            <td class="px-4 py-3.5 font-mono text-sm font-medium text-foreground">#@inv.InvoiceNumber</td>
                            <td class="px-4 py-3.5 text-sm text-foreground">@inv.CustomerName</td>
                            <td class="px-4 py-3.5 font-mono text-sm text-foreground">@MockData.FormatCurrency(inv.TotalAmount)</td>
                            <td class="px-4 py-3.5 font-mono text-sm text-emerald-600">@MockData.FormatCurrency(inv.PaidAmount)</td>
                            <td class="px-4 py-3.5 font-mono text-sm font-semibold text-foreground">@MockData.FormatCurrency(inv.AmountDue)</td>
                            <td class="px-4 py-3.5 whitespace-nowrap text-sm text-muted-foreground">@MockData.FormatDate(inv.IssueDate)</td>
                            <td class="px-4 py-3.5"><InvoiceStatusBadge Status="@inv.Status" /></td>
                            <td class="px-4 py-3.5">
                                <button class="rounded-lg p-1 text-muted-foreground hover:text-foreground">
                                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="1"/><circle cx="19" cy="12" r="1"/><circle cx="5" cy="12" r="1"/></svg>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="flex flex-col gap-3 border-t border-border px-4 py-3 text-sm text-muted-foreground md:flex-row md:items-center md:justify-between">
            <span>Showing @(currentPage * pageSize + 1)–@Math.Min((currentPage + 1) * pageSize, filteredData.Count()) of @filteredData.Count()</span>
            <div class="flex items-center gap-2 self-end md:self-auto">
                <select class="h-9 w-28 rounded-xl border border-border bg-card px-2 text-sm" @bind="pageSize" @bind:after="GoToFirstPage">
                    <option value="10">10 / page</option>
                    <option value="20">20 / page</option>
                    <option value="50">50 / page</option>
                </select>
                <button class="rounded-xl border border-border px-3 py-1.5 text-sm disabled:opacity-40" disabled="@(currentPage == 0)" @onclick="PrevPage">Previous</button>
                <span class="min-w-24 text-center">Page @(currentPage + 1) of @totalPages</span>
                <button class="rounded-xl border border-border px-3 py-1.5 text-sm disabled:opacity-40" disabled="@(currentPage >= totalPages - 1)" @onclick="NextPage">Next</button>
            </div>
        </div>
    </section>
</div>

@code {
    private string customerFilter = "";
    private string statusFilter = "";
    private DateTime? dateFrom;
    private DateTime? dateTo;
    private int currentPage = 0;
    private int pageSize = 10;

    private string[] customers = MockData.Invoices.Select(i => i.CustomerName).Distinct().OrderBy(c => c).ToArray();

    private IEnumerable<InvoiceData> filteredData
    {
        get
        {
            var query = MockData.Invoices.AsEnumerable();
            if (!string.IsNullOrEmpty(customerFilter)) query = query.Where(i => i.CustomerName == customerFilter);
            if (!string.IsNullOrEmpty(statusFilter))
            {
                if (statusFilter == "overdue")
                    query = query.Where(i => i.DueDate.HasValue && MockData.IsOverdue(i.DueDate.Value) && i.Status != "paid");
                else
                    query = query.Where(i => i.Status == statusFilter);
            }
            if (dateFrom.HasValue) query = query.Where(i => i.IssueDate >= dateFrom.Value);
            if (dateTo.HasValue) query = query.Where(i => i.IssueDate <= dateTo.Value);
            return query;
        }
    }

    private InvoiceData[] pagedData => filteredData.Skip(currentPage * pageSize).Take(pageSize).ToArray();
    private int totalPages => Math.Max(1, (int)Math.Ceiling((double)filteredData.Count() / pageSize));

    private void NextPage() { if (currentPage < totalPages - 1) currentPage++; }
    private void PrevPage() { if (currentPage > 0) currentPage--; }
    private void GoToFirstPage() { currentPage = 0; }
}
