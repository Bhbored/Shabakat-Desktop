@page "/boxes"
@using Shabakat.Components.Shared
@using System.Linq

<div class="space-y-4">
    <div class="flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between">
        <div class="flex flex-1 flex-col gap-3 sm:flex-row">
            <input type="text" class="h-11 min-w-60 flex-1 rounded-xl border border-border bg-card px-4 text-sm text-foreground outline-none focus:border-primary" placeholder="Search boxes..." @bind="searchTerm" @bind:event="oninput" />
            <select class="h-11 w-full sm:w-60 rounded-xl border border-border bg-card px-3 text-sm text-foreground" @bind="areaFilter">
                <option value="">All Areas</option>
                @foreach (var area in areas)
                {
                    <option value="@area.Id">@area.Name</option>
                }
            </select>
        </div>
        <button class="rounded-xl bg-primary px-4 py-2.5 text-sm font-medium text-primary-foreground" style="box-shadow: 0 0 16px rgba(230,196,58,0.25);">+ Add Box</button>
    </div>
    <p class="text-xs text-muted-foreground">@filteredBoxes.Length box@(filteredBoxes.Length != 1 ? "es" : "") found</p>

    <div class="grid gap-4 xl:grid-cols-2">
        @foreach (var box in filteredBoxes)
        {
            <section class="rounded-2xl border border-border bg-card/80 p-5 hover:bg-card transition-colors">
                <div class="flex items-start gap-4">
                    <div class="flex h-10 w-10 items-center justify-center rounded-full text-white text-sm font-semibold shrink-0" style="background-color: @GetAvatarColor(box.Name)">@GetInitials(box.Name)</div>
                    <button type="button" class="min-w-0 flex-1 text-left">
                        <p class="truncate text-base font-semibold text-foreground">@box.Name</p>
                        <p class="mt-1 text-sm text-muted-foreground">@box.AreaName</p>
                        <div class="mt-4 flex flex-wrap items-center gap-3 text-xs text-muted-foreground">
                            <span class="inline-flex items-center gap-1.5 rounded-full border border-border bg-muted/50 px-3 py-1">
                                <svg class="h-3.5 w-3.5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
                                @box.CustomerCount subscriber@(box.CustomerCount != 1 ? "s" : "")
                            </span>
                            <span class="inline-flex items-center gap-1.5 rounded-full border border-border bg-muted/50 px-3 py-1">
                                <svg class="h-3.5 w-3.5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                                @(box.LocationNote ?? "No location")
                            </span>
                        </div>
                        <div class="mt-4 grid gap-3 text-sm text-muted-foreground sm:grid-cols-2">
                            <div class="rounded-xl border border-border bg-muted/50 px-3 py-2">
                                <div class="mb-1 flex items-center gap-2 text-xs uppercase tracking-[0.18em] text-muted-foreground">
                                    <svg class="h-3.5 w-3.5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>
                                    Area
                                </div>
                                <p class="truncate text-sm text-foreground">@box.AreaName</p>
                            </div>
                            <div class="rounded-xl border border-border bg-muted/50 px-3 py-2">
                                <div class="mb-1 flex items-center gap-2 text-xs uppercase tracking-[0.18em] text-muted-foreground">
                                    <svg class="h-3.5 w-3.5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                                    Created
                                </div>
                                <p class="text-sm text-foreground">@MockData.FormatDate(box.CreatedAt)</p>
                            </div>
                        </div>
                    </button>
                    <button class="rounded-lg p-1 text-muted-foreground hover:text-foreground">
                        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="1"/><circle cx="19" cy="12" r="1"/><circle cx="5" cy="12" r="1"/></svg>
                    </button>
                </div>
            </section>
        }
    </div>
</div>

@code {
    private string searchTerm = "";
    private string areaFilter = "";

    private AreaData[] areas = MockData.Areas;

    private BoxData[] filteredBoxes
    {
        get
        {
            var query = MockData.Boxes.AsEnumerable();
            if (!string.IsNullOrEmpty(areaFilter)) query = query.Where(b => b.AreaId == areaFilter);
            var term = searchTerm.Trim().ToLower();
            if (!string.IsNullOrEmpty(term))
                query = query.Where(b => b.Name.ToLower().Contains(term) || b.AreaName.ToLower().Contains(term) || (b.LocationNote ?? "").ToLower().Contains(term));
            return query.ToArray();
        }
    }

    private static readonly string[] AvatarColors = new[] { "#7c3aed", "#2563eb", "#059669", "#db2777", "#ea580c", "#0891b2", "#d97706" };
    private string GetAvatarColor(string name) => AvatarColors[Math.Abs(name.GetHashCode()) % AvatarColors.Length];
    private string GetInitials(string name) => string.Join("", name.Split(' ').Take(2).Select(w => w[0])).ToUpperInvariant();
}
