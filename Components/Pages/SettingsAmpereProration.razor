@page "/settings/ampere-proration"

<div class="space-y-5">
    <NavLink href="settings" class="inline-flex items-center gap-1 text-xs text-muted-foreground hover:text-foreground no-underline mb-2">
        <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
        Back to Settings
    </NavLink>
    <h1 class="text-xl font-bold text-foreground">Ampere Proration</h1>
    <p class="text-xs text-muted-foreground">Prorate ampere charges based on days remaining in billing cycle</p>

    <section class="rounded-2xl border border-border bg-card p-5">
        <div class="flex items-center justify-between">
            <div>
                <p class="text-sm font-medium text-foreground">Day-Based Proration</p>
                <p class="text-xs text-muted-foreground">When enabled, charges are prorated based on days remaining in the month</p>
            </div>
            <input type="checkbox" class="h-5 w-5 rounded accent-primary" />
        </div>
    </section>
    <button class="rounded-xl bg-primary px-4 py-2.5 text-sm font-medium text-primary-foreground">Save Changes</button>
</div>
