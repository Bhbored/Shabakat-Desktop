@page "/areas"
@using Shabakat.Components.Shared
@using System.Linq

<div class="space-y-4">
    <div class="flex flex-wrap items-center gap-3">
        <input type="text" class="min-w-72 flex-1 max-w-[600px] rounded-xl border border-border bg-card px-4 py-2.5 text-sm text-foreground outline-none focus:border-primary" placeholder="Search areas..." @bind="searchTerm" @bind:event="oninput" />
        <button class="rounded-xl bg-primary px-4 py-2.5 text-sm font-medium text-primary-foreground" style="box-shadow: 0 0 16px rgba(230,196,58,0.25);">+ Add Area</button>
    </div>
    <p class="text-xs text-muted-foreground">@filteredAreas.Length area@(filteredAreas.Length != 1 ? "s" : "") found</p>

    <div class="grid gap-4 xl:grid-cols-2">
        @foreach (var area in filteredAreas)
        {
            <section class="rounded-2xl border border-border bg-card/80 p-5 hover:bg-card transition-colors">
                <div class="flex items-start gap-4">
                    <div class="flex h-10 w-10 items-center justify-center rounded-full text-white text-sm font-semibold shrink-0" style="background-color: @GetAvatarColor(area.Name)">@GetInitials(area.Name)</div>
                    <button type="button" class="min-w-0 flex-1 text-left">
                        <p class="truncate text-base font-semibold text-foreground">@area.Name</p>
                        <p class="mt-1 text-sm text-muted-foreground">Created @MockData.FormatDate(area.CreatedAt)</p>
                        <div class="mt-4 flex flex-wrap items-center gap-3 text-xs text-muted-foreground">
                            <span class="inline-flex items-center gap-1.5 rounded-full border border-border bg-muted/50 px-3 py-1">
                                <svg class="h-3.5 w-3.5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                                @area.CustomerCount subscriber@(area.CustomerCount != 1 ? "s" : "")
                            </span>
                            <span class="inline-flex items-center gap-1.5 rounded-full border border-border bg-muted/50 px-3 py-1">
                                <svg class="h-3.5 w-3.5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                                Area
                            </span>
                        </div>
                    </button>
                    <button class="rounded-lg p-1 text-muted-foreground hover:text-foreground">
                        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="1"/><circle cx="19" cy="12" r="1"/><circle cx="5" cy="12" r="1"/></svg>
                    </button>
                </div>
            </section>
        }
    </div>
</div>

@code {
    private string searchTerm = "";

    private AreaData[] filteredAreas
    {
        get
        {
            var term = searchTerm.Trim().ToLower();
            return string.IsNullOrEmpty(term)
                ? MockData.Areas
                : MockData.Areas.Where(a => a.Name.ToLower().Contains(term)).ToArray();
        }
    }

    private static readonly string[] AvatarColors = new[] { "#7c3aed", "#2563eb", "#059669", "#db2777", "#ea580c", "#0891b2", "#d97706" };
    private string GetAvatarColor(string name) => AvatarColors[Math.Abs(name.GetHashCode()) % AvatarColors.Length];
    private string GetInitials(string name) => string.Join("", name.Split(' ').Take(2).Select(w => w[0])).ToUpperInvariant();
}
