@page "/areas"
@inject IAreaService AreaService
@inject IToastService Toast

<div class="space-y-4" @onclick="CloseMenu">
    <div class="space-y-4">
        <div class="flex flex-wrap items-center gap-3">
            <div class="min-w-72 flex-1">
                <input type="text"
                       class="w-full max-w-[600px] rounded-xl border border-border bg-card px-4 py-2.5 text-sm text-foreground outline-none transition focus:border-primary"
                       placeholder="Search areas..."
                       @bind="_searchTerm"
                       @bind:event="oninput"
                       @bind:after="ApplyFilter" />
            </div>
            <button type="button"
                    class="rounded-xl bg-primary px-4 py-2.5 text-sm font-medium text-primary-foreground disabled:opacity-50"
                    style="box-shadow: 0 0 16px rgba(245,192,0,0.25);"
                    disabled="@_loading"
                    @onclick="OpenCreate">
                + Add Area
            </button>
        </div>
        <p class="text-xs text-muted-foreground">
            @_filtered.Count area@(_filtered.Count != 1 ? "s" : "") found
        </p>
    </div>

    @if (_loading)
    {
        <section class="rounded-2xl border border-border bg-card px-4 py-10 text-sm text-muted-foreground">
            Loading areas...
        </section>
    }
    else if (_filtered.Count == 0)
    {
        <section class="rounded-2xl border border-border bg-card px-4 py-10 text-sm text-muted-foreground">
            No areas found.
        </section>
    }
    else
    {
        <div class="grid gap-4 xl:grid-cols-2">
            @foreach (var area in _filtered)
            {
                <section class="rounded-2xl border border-border bg-card/80 p-5 transition-colors hover:bg-card">
                    <div class="flex items-start gap-4">
                        <div class="flex h-10 w-10 items-center justify-center rounded-full text-sm font-semibold text-white shrink-0"
                             style="background-color: @FormatHelper.AvatarColor(area.Name)">
                            @FormatHelper.Initials(area.Name)
                        </div>

                        <button type="button"
                                class="min-w-0 flex-1 text-left"
                                @onclick="() => OpenDetails(area)">
                            <p class="truncate text-base font-semibold text-foreground">@area.Name</p>
                            <p class="mt-1 text-sm text-muted-foreground">Created @FormatHelper.Date(area.CreatedAt)</p>
                            <div class="mt-4 flex flex-wrap items-center gap-3 text-xs text-muted-foreground">
                                <span class="inline-flex items-center gap-1.5 rounded-full border border-border bg-muted/50 px-3 py-1">
                                    <svg class="h-3.5 w-3.5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                                    @area.CustomerCount subscriber@(area.CustomerCount != 1 ? "s" : "")
                                </span>
                                <span class="inline-flex items-center gap-1.5 rounded-full border border-border bg-muted/50 px-3 py-1">
                                    <svg class="h-3.5 w-3.5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                                    Area
                                </span>
                            </div>
                        </button>

                        <div class="relative shrink-0">
                            <button type="button"
                                    class="rounded-lg p-2 text-muted-foreground hover:bg-muted hover:text-foreground"
                                    aria-label="Actions"
                                    @onclick="() => ToggleMenu(area.Id)"
                                    @onclick:stopPropagation="true">
                                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="1"/><circle cx="19" cy="12" r="1"/><circle cx="5" cy="12" r="1"/></svg>
                            </button>
                            @if (_menuAreaId == area.Id)
                            {
                                <div class="absolute end-0 z-20 mt-1 w-44 overflow-hidden rounded-xl border border-border bg-popover py-1 shadow-lg"
                                     @onclick:stopPropagation="true">
                                    <button type="button" class="flex w-full items-center gap-2 px-3 py-2 text-sm text-foreground hover:bg-muted" @onclick="() => OpenDetails(area)">
                                        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                                        View details
                                    </button>
                                    <button type="button" class="flex w-full items-center gap-2 px-3 py-2 text-sm text-foreground hover:bg-muted" @onclick="() => OpenEdit(area)">
                                        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
                                        Edit
                                    </button>
                                    <button type="button"
                                            class="flex w-full items-center gap-2 px-3 py-2 text-sm text-red-500 hover:bg-red-500/10 disabled:opacity-40"
                                            disabled="@(area.CustomerCount > 0)"
                                            @onclick="() => OpenDelete(area)">
                                        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                                        Delete
                                    </button>
                                </div>
                            }
                        </div>
                    </div>
                </section>
            }
        </div>
    }
</div>

@* Details side panel *@
<SideSheet Open="_showDetails"
           Title="@(_selected?.Name ?? "Area details")"
           Description="Service area overview and assigned subscribers."
           MaxWidthClass="sm:max-w-xl"
           OnClose="CloseDetails">
    @if (_selected is not null)
    {
        <div class="space-y-4">
            <div class="grid gap-4 md:grid-cols-2">
                <div class="rounded-2xl border border-border bg-card p-4">
                    <p class="text-xs uppercase tracking-[0.18em] text-muted-foreground">Subscribers</p>
                    <p class="mt-2 text-xl font-semibold text-foreground">
                        @_selected.CustomerCount subscriber@(_selected.CustomerCount != 1 ? "s" : "")
                    </p>
                </div>
                <div class="rounded-2xl border border-border bg-card p-4">
                    <p class="text-xs uppercase tracking-[0.18em] text-muted-foreground">Created</p>
                    <p class="mt-2 text-xl font-semibold text-foreground">@FormatHelper.Date(_selected.CreatedAt)</p>
                </div>
            </div>

            <div class="space-y-4 rounded-2xl border border-border bg-card p-5">
                <div class="flex items-start gap-3">
                    <div class="rounded-lg border border-border bg-muted/40 p-2 text-primary">
                        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                    </div>
                    <div>
                        <p class="text-xs uppercase tracking-[0.18em] text-muted-foreground">Name</p>
                        <p class="mt-1 text-sm text-foreground">@_selected.Name</p>
                    </div>
                </div>
                <div class="flex items-start gap-3">
                    <div class="rounded-lg border border-border bg-muted/40 p-2 text-primary">
                        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
                    </div>
                    <div>
                        <p class="text-xs uppercase tracking-[0.18em] text-muted-foreground">Assigned subscribers</p>
                        <p class="mt-1 text-sm text-foreground">@_selected.CustomerCount</p>
                    </div>
                </div>
                <div class="flex items-start gap-3">
                    <div class="rounded-lg border border-border bg-muted/40 p-2 text-primary">
                        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                    </div>
                    <div>
                        <p class="text-xs uppercase tracking-[0.18em] text-muted-foreground">Created at</p>
                        <p class="mt-1 text-sm text-foreground">@FormatHelper.Date(_selected.CreatedAt)</p>
                    </div>
                </div>
            </div>
        </div>
    }
</SideSheet>

@* Create / Edit side panel *@
<SideSheet Open="_showForm"
           Title="@(_editingId is null ? "Add Area" : "Edit Area")"
           Description="@(_editingId is null ? "Create a new service area." : "Update the area name.")"
           MaxWidthClass="sm:max-w-lg"
           OnClose="CloseForm">
    <TitleIcon>
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
    </TitleIcon>
    <ChildContent>
        <EditForm Model="_form" OnValidSubmit="SaveAsync" class="space-y-6">
            <DataAnnotationsValidator />
            <div>
                <label class="mb-1.5 block text-sm font-medium text-foreground">Name</label>
                <InputText @bind-Value="_form.Name"
                           class="w-full rounded-xl border border-border bg-background px-3 py-2.5 text-sm text-foreground outline-none focus:border-primary"
                           placeholder="e.g. Downtown" />
                <ValidationMessage For="() => _form.Name" class="mt-1 text-xs text-red-500" />
            </div>
            <div class="flex flex-wrap items-center justify-between gap-3 border-t border-border pt-5">
                <p class="text-sm text-muted-foreground">Areas group subscribers for billing and routing.</p>
                <div class="flex items-center gap-3">
                    <button type="button"
                            class="rounded-xl border border-border px-4 py-2.5 text-sm font-medium text-foreground hover:bg-muted"
                            disabled="@_saving"
                            @onclick="CloseForm">
                        Cancel
                    </button>
                    <button type="submit"
                            class="rounded-xl bg-primary px-4 py-2.5 text-sm font-medium text-primary-foreground disabled:opacity-50"
                            disabled="@_saving">
                        @(_saving ? "Saving..." : (_editingId is null ? "Create" : "Save"))
                    </button>
                </div>
            </div>
        </EditForm>
    </ChildContent>
</SideSheet>

<ConfirmDialog Open="_showDelete"
               Title="Delete area"
               OnClose="CloseDelete">
    <ChildContent>
        @if (_pendingDelete is not null)
        {
            <p>
                Delete <span class="font-medium text-foreground">@_pendingDelete.Name</span>? This cannot be undone.
            </p>
        }
    </ChildContent>
    <Footer>
        <button type="button"
                class="rounded-xl border border-border px-4 py-2.5 text-sm font-medium text-foreground hover:bg-muted"
                disabled="@_saving"
                @onclick="CloseDelete">
            Cancel
        </button>
        <button type="button"
                class="rounded-xl bg-red-500 px-4 py-2.5 text-sm font-medium text-white hover:bg-red-500/90 disabled:opacity-50"
                disabled="@_saving"
                @onclick="ConfirmDeleteAsync">
            @(_saving ? "Deleting..." : "Delete")
        </button>
    </Footer>
</ConfirmDialog>

@code {
    private readonly List<AreaResponse> _items = [];
    private List<AreaResponse> _filtered = [];
    private string _searchTerm = "";
    private bool _loading = true;
    private bool _saving;
    private bool _showForm;
    private bool _showDetails;
    private bool _showDelete;
    private Guid? _editingId;
    private Guid? _menuAreaId;
    private AreaResponse? _selected;
    private AreaResponse? _pendingDelete;
    private AreaFormModel _form = new();

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        var result = await UiActions.RunAsync(Toast, () => AreaService.GetAllAsync());
        _items.Clear();
        if (result is not null)
            _items.AddRange(result.OrderBy(a => a.Name));
        ApplyFilter();
        _loading = false;
    }

    private void ApplyFilter()
    {
        var term = _searchTerm.Trim();
        _filtered = string.IsNullOrEmpty(term)
            ? _items.ToList()
            : _items.Where(a => a.Name.Contains(term, StringComparison.OrdinalIgnoreCase)).ToList();
    }

    private void ToggleMenu(Guid id)
    {
        _menuAreaId = _menuAreaId == id ? null : id;
    }

    private void CloseMenu() => _menuAreaId = null;

    private void OpenDetails(AreaResponse area)
    {
        CloseMenu();
        _selected = area;
        _showDetails = true;
    }

    private void CloseDetails()
    {
        _showDetails = false;
        _selected = null;
    }

    private void OpenCreate()
    {
        CloseMenu();
        _editingId = null;
        _form = new AreaFormModel();
        _showForm = true;
    }

    private void OpenEdit(AreaResponse area)
    {
        CloseMenu();
        _editingId = area.Id;
        _form = new AreaFormModel { Name = area.Name };
        _showForm = true;
    }

    private void CloseForm()
    {
        if (_saving) return;
        _showForm = false;
        _editingId = null;
    }

    private void OpenDelete(AreaResponse area)
    {
        CloseMenu();
        if (area.CustomerCount > 0)
        {
            Toast.Error("Cannot delete an area that has customers assigned to it.");
            return;
        }

        _pendingDelete = area;
        _showDelete = true;
    }

    private void CloseDelete()
    {
        if (_saving) return;
        _showDelete = false;
        _pendingDelete = null;
    }

    private async Task SaveAsync()
    {
        if (_saving) return;
        _saving = true;

        var ok = false;
        if (_editingId is null)
        {
            var created = await UiActions.RunAsync(
                Toast,
                () => AreaService.CreateAsync(new CreateAreaRequest(_form.Name)),
                "Area created.");
            ok = created is not null;
        }
        else
        {
            var updated = await UiActions.RunAsync(
                Toast,
                () => AreaService.UpdateAsync(_editingId.Value, new UpdateAreaRequest(_form.Name)),
                "Area updated.");
            ok = updated is not null;
        }

        _saving = false;
        if (!ok) return;

        _showForm = false;
        _editingId = null;
        await LoadAsync();
    }

    private async Task ConfirmDeleteAsync()
    {
        if (_pendingDelete is null || _saving) return;
        _saving = true;

        await UiActions.RunAsync(
            Toast,
            () => AreaService.DeleteAsync(_pendingDelete.Id),
            "Area deleted.");

        _saving = false;
        _showDelete = false;
        _pendingDelete = null;
        await LoadAsync();
    }

    private sealed class AreaFormModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Name is required.")]
        [System.ComponentModel.DataAnnotations.MaxLength(200)]
        public string Name { get; set; } = "";
    }
}
