@page "/settings/whatsapp"

<div class="space-y-5">
    <NavLink href="settings" class="inline-flex items-center gap-1 text-xs text-muted-foreground hover:text-foreground no-underline mb-2">
        <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
        Back to Settings
    </NavLink>
    <h1 class="text-xl font-bold text-foreground">WhatsApp Connection</h1>
    <p class="text-xs text-muted-foreground">Connect WhatsApp for automated payment reminders and notifications</p>

    <section class="rounded-2xl border border-border bg-card p-5">
        <div class="flex flex-col items-center gap-4 py-6">
            <div class="rounded-2xl border border-border bg-muted/50 p-6">
                <div class="h-40 w-40 bg-muted-foreground/20 rounded-xl flex items-center justify-center">
                    <span class="text-xs text-muted-foreground">QR Code Placeholder</span>
                </div>
            </div>
            <p class="text-sm font-medium text-foreground">Scan with WhatsApp to connect</p>
            <p class="text-xs text-muted-foreground text-center max-w-xs">Open WhatsApp on your phone, go to Linked Devices, and scan this QR code to enable automated messaging.</p>
            <div class="flex items-center gap-2 px-3 py-1.5 rounded-full border border-emerald-400/20 bg-emerald-400/10">
                <span class="h-2 w-2 rounded-full bg-emerald-400"></span>
                <span class="text-xs font-medium text-emerald-400">Connected</span>
            </div>
            <button class="rounded-xl border border-red-400/20 bg-red-400/10 px-4 py-2.5 text-sm font-medium text-red-400">Disconnect</button>
        </div>
    </section>
</div>
