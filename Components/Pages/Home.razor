@page "/"
@using Shabakat.Components.Shared

<div class="space-y-5">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-xl font-bold text-foreground">Dashboard</h1>
            <p class="text-xs text-muted-foreground">Welcome back, Admin · Shabakat</p>
        </div>
        <select class="rounded-xl border border-border bg-card px-4 py-2.5 text-sm text-foreground min-w-56">
            <option value="all">All Time</option>
            <option value="jun-2025">June 2025</option>
            <option value="may-2025">May 2025</option>
            <option value="apr-2025">April 2025</option>
        </select>
    </div>

    <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
        <section class="rounded-2xl border border-border bg-card p-5">
            <div class="flex items-start justify-between">
                <div>
                    <p class="text-xs font-semibold uppercase tracking-[0.22em] text-muted-foreground">Total Subscribers</p>
                    <p class="mt-2 font-mono text-3xl font-bold text-foreground">1,245</p>
                    <p class="mt-1 text-xs text-muted-foreground">1,180 active · 65 suspended</p>
                </div>
                <div class="rounded-xl bg-muted p-2.5">
                    <svg class="h-5 w-5 text-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                </div>
            </div>
        </section>

        <section class="rounded-2xl border border-border bg-card p-5">
            <div class="flex items-start justify-between">
                <div>
                    <p class="text-xs font-semibold uppercase tracking-[0.22em] text-muted-foreground">Collected (All Time)</p>
                    <p class="mt-2 font-mono text-3xl font-bold text-emerald-600">$847,230</p>
                    <p class="mt-1 text-xs text-muted-foreground">92% collection rate · $920,500 billed</p>
                </div>
                <div class="rounded-xl bg-muted p-2.5">
                    <svg class="h-5 w-5 text-emerald-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                </div>
            </div>
        </section>

        <section class="rounded-2xl border border-border bg-card p-5">
            <div class="flex items-start justify-between">
                <div>
                    <p class="text-xs font-semibold uppercase tracking-[0.22em] text-muted-foreground">Outstanding Invoices</p>
                    <p class="mt-2 font-mono text-3xl font-bold text-red-500">203</p>
                    <p class="mt-1 text-xs text-muted-foreground">142 unpaid · 61 partially paid</p>
                </div>
                <div class="rounded-xl bg-muted p-2.5">
                    <svg class="h-5 w-5 text-red-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                </div>
            </div>
        </section>

        <section class="rounded-2xl border border-primary/30 bg-primary p-5 text-primary-foreground shadow-[0_0_30px_rgba(230,196,58,0.18)]">
            <div class="flex items-start justify-between">
                <div>
                    <p class="text-xs font-semibold uppercase tracking-[0.22em] text-primary-foreground/70">Net Income (All Time)</p>
                    <p class="mt-2 font-mono text-3xl font-bold">$624,810</p>
                    <p class="mt-1 flex items-center gap-1 text-xs text-primary-foreground/70">
                        <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/></svg>
                        $92,420 still outstanding
                    </p>
                </div>
                <div class="rounded-xl bg-black/10 p-2.5">
                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                </div>
            </div>
        </section>
    </div>

    <section class="rounded-2xl border border-border bg-card p-5">
        <div class="mb-5 flex flex-wrap items-center justify-between gap-3">
            <div>
                <h2 class="text-lg font-semibold text-foreground">Revenue Overview</h2>
                <p class="text-xs text-muted-foreground">Billed vs collected vs expenses</p>
            </div>
        </div>
        <div class="h-60 flex items-end gap-2 px-2">
            @foreach (var (label, billed, collected) in revenueChartData)
            {
                var maxVal = revenueChartData.Max(d => Math.Max(d.billed, d.collected));
                var billedH = billed / maxVal * 100;
                var collectedH = collected / maxVal * 100;
                <div class="flex-1 flex flex-col items-center gap-1">
                    <div class="w-full flex items-end gap-1 h-48">
                        <div class="flex-1 bg-primary/70 rounded-t-lg" style="height: @billedH%" title="@label Billed: @MockData.FormatCompactCurrency(billed)"></div>
                        <div class="flex-1 bg-emerald-500/70 rounded-t-lg" style="height: @collectedH%" title="@label Collected: @MockData.FormatCompactCurrency(collected)"></div>
                    </div>
                    <span class="text-[10px] text-muted-foreground">@label</span>
                </div>
            }
        </div>
        <div class="mt-4 flex items-center gap-5 text-xs text-muted-foreground">
            <span class="flex items-center gap-1.5"><span class="h-2 w-2 rounded-full bg-primary"></span>Billed</span>
            <span class="flex items-center gap-1.5"><span class="h-2 w-2 rounded-full bg-emerald-500"></span>Collected</span>
        </div>
        <div class="mt-5 grid gap-3 md:grid-cols-4">
            @foreach (var (label, value) in expenseBreakdown)
            {
                <div class="rounded-2xl border border-border bg-muted/50 px-4 py-3">
                    <p class="text-[11px] font-semibold uppercase tracking-[0.2em] text-muted-foreground">@label</p>
                    <p class="mt-1 font-mono text-sm font-semibold text-foreground">@MockData.FormatCurrency(value)</p>
                </div>
            }
        </div>
    </section>

    <div class="grid gap-4 lg:grid-cols-5">
        <section class="rounded-2xl border border-border bg-card p-5 lg:col-span-3">
            <div class="mb-4 flex items-center justify-between">
                <h2 class="text-lg font-semibold text-foreground">Recently Paid Invoices</h2>
                <a href="subscribers" class="text-xs font-medium text-primary hover:opacity-75">View All</a>
            </div>
            <div>
                @foreach (var invoice in MockData.Invoices.Where(i => i.Status == "paid").Take(5))
                {
                    <div class="flex items-center gap-3 border-b border-border py-3 last:border-b-0">
                        <div class="flex h-8 w-8 items-center justify-center rounded-full text-white text-xs font-semibold shrink-0" style="background-color: @GetAvatarColor(invoice.CustomerName)">@GetInitials(invoice.CustomerName)</div>
                        <div class="min-w-0 flex-1">
                            <p class="truncate text-sm font-medium text-foreground">@invoice.CustomerName</p>
                            <p class="text-xs text-muted-foreground">INV #@invoice.InvoiceNumber · @MockData.FormatDate(invoice.CreatedAt)</p>
                        </div>
                        <div class="text-right">
                            <p class="font-mono text-sm font-semibold text-foreground">@MockData.FormatCurrency(invoice.PaidAmount)</p>
                            <p class="text-xs text-muted-foreground">@MockData.FormatDate(invoice.CreatedAt)</p>
                        </div>
                        <StatusBadge Status="paid" />
                    </div>
                }
            </div>
        </section>

        <section class="rounded-2xl border border-border bg-card p-5 lg:col-span-2">
            <div class="mb-4 flex items-center justify-between">
                <h2 class="text-lg font-semibold text-foreground">Upcoming Due</h2>
                <span class="rounded-full border border-red-400/20 bg-red-400/10 px-2 py-0.5 text-xs font-medium text-red-400">5 pending</span>
            </div>
            <div>
                @foreach (var invoice in MockData.Invoices.Where(i => i.Status == "unpaid" || i.Status == "overdue" || i.Status == "partiallyPaid").OrderBy(i => i.DueDate).Take(5))
                {
                    var status = invoice.Status == "partiallyPaid" ? "unpaid" : invoice.Status;
                    if (invoice.DueDate.HasValue && MockData.IsOverdue(invoice.DueDate.Value)) status = "overdue";
                    <div class="flex items-center gap-3 border-b border-border py-3 last:border-b-0">
                        <div class="flex h-8 w-8 items-center justify-center rounded-full text-white text-xs font-semibold shrink-0" style="background-color: @GetAvatarColor(invoice.CustomerName)">@GetInitials(invoice.CustomerName)</div>
                        <div class="min-w-0 flex-1">
                            <p class="truncate text-sm font-medium text-foreground">@invoice.CustomerName</p>
                            <p class="text-xs text-muted-foreground">Due @(invoice.DueDate.HasValue ? MockData.FormatDate(invoice.DueDate.Value) : "N/A")</p>
                        </div>
                        <div class="flex items-center gap-2">
                            <span class="font-mono text-sm font-semibold text-foreground">@MockData.FormatCurrency(invoice.AmountDue)</span>
                            <StatusBadge Status="@status" />
                        </div>
                    </div>
                }
            </div>
            <a href="subscribers" class="mt-4 inline-flex w-full items-center justify-center rounded-xl bg-primary px-4 py-2.5 text-sm font-medium text-primary-foreground hover:opacity-90" style="box-shadow: 0 0 16px rgba(230,196,58,0.2);">Review All Balances</a>
        </section>
    </div>
</div>

@code {
    private static readonly string[] AvatarColors = new[] { "#7c3aed", "#2563eb", "#059669", "#db2777", "#ea580c", "#0891b2", "#d97706" };

    private string GetAvatarColor(string name) => AvatarColors[Math.Abs(name.GetHashCode()) % AvatarColors.Length];
    private string GetInitials(string name) => string.Join("", name.Split(' ').Take(2).Select(w => w[0])).ToUpperInvariant();

    private readonly (string label, double billed, double collected)[] revenueChartData = new (string, double, double)[]
    {
        ("Dec", 9800, 8200), ("Jan", 10500, 9100), ("Feb", 11200, 9800),
        ("Mar", 12100, 10500), ("Apr", 11800, 10200), ("May", 12450, 11100),
    };

    private readonly (string label, double value)[] expenseBreakdown = new (string, double)[]
    {
        ("Fuel", 8200), ("Maintenance", 2150), ("Employees", 1200), ("Other", 900),
    };
}
