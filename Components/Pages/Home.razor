@page "/"
@inject IDashboardService DashboardService
@inject IToastService Toast
@inject IAppUserService AppUserService

<div class="space-y-5">
    <div class="flex items-center justify-between gap-3">
        <div>
            <h1 class="text-xl font-bold text-foreground">Dashboard</h1>
            <p class="text-xs text-muted-foreground">Welcome back, @_displayName · Shabakat</p>
        </div>
        <select class="rounded-xl border border-border bg-card px-4 py-2.5 text-sm text-foreground min-w-56"
                @bind="_periodKey"
                @bind:after="LoadAsync">
            <option value="all">All Time</option>
            @foreach (var option in _periodOptions)
            {
                <option value="@option.Key">@option.Label</option>
            }
        </select>
    </div>

    @if (_loading)
    {
        <p class="text-sm text-muted-foreground">Loading dashboard...</p>
    }
    else if (_summary is not null)
    {
        <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
            <section class="rounded-2xl border border-border bg-card p-5">
                <div class="flex items-start justify-between">
                    <div>
                        <p class="text-xs font-semibold uppercase tracking-[0.22em] text-muted-foreground">Total Subscribers</p>
                        <p class="mt-2 font-mono text-3xl font-bold text-foreground">@FormatHelper.Number(_summary.Customers.Total)</p>
                        <p class="mt-1 text-xs text-muted-foreground">@_summary.Customers.Active active · @_summary.Customers.Suspended suspended</p>
                    </div>
                    <div class="rounded-xl bg-muted p-2.5">
                        <svg class="h-5 w-5 text-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                    </div>
                </div>
            </section>

            <section class="rounded-2xl border border-border bg-card p-5">
                <div class="flex items-start justify-between">
                    <div>
                        <p class="text-xs font-semibold uppercase tracking-[0.22em] text-muted-foreground">Collected</p>
                        <p class="mt-2 font-mono text-3xl font-bold text-emerald-600">@FormatHelper.Currency(_summary.TotalCollectedAllTime)</p>
                        <p class="mt-1 text-xs text-muted-foreground">@_summary.CollectionRate.ToString("0.##")% collection rate · @FormatHelper.Currency(_summary.TotalBilledAllTime) billed</p>
                    </div>
                    <div class="rounded-xl bg-muted p-2.5">
                        <svg class="h-5 w-5 text-emerald-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                    </div>
                </div>
            </section>

            <section class="rounded-2xl border border-border bg-card p-5">
                <div class="flex items-start justify-between">
                    <div>
                        <p class="text-xs font-semibold uppercase tracking-[0.22em] text-muted-foreground">Outstanding Invoices</p>
                        <p class="mt-2 font-mono text-3xl font-bold text-red-500">@(_summary.Invoices.UnpaidCount + _summary.Invoices.PartiallyPaidCount)</p>
                        <p class="mt-1 text-xs text-muted-foreground">@_summary.Invoices.UnpaidCount unpaid · @_summary.Invoices.PartiallyPaidCount partially paid</p>
                    </div>
                    <div class="rounded-xl bg-muted p-2.5">
                        <svg class="h-5 w-5 text-red-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                    </div>
                </div>
            </section>

            <section class="rounded-2xl border border-primary/30 bg-primary p-5 text-primary-foreground shadow-[0_0_30px_rgba(230,196,58,0.18)]">
                <div class="flex items-start justify-between">
                    <div>
                        <p class="text-xs font-semibold uppercase tracking-[0.22em] text-primary-foreground/70">Net Income</p>
                        <p class="mt-2 font-mono text-3xl font-bold">@FormatHelper.Currency(_summary.NetIncomeAllTime)</p>
                        <p class="mt-1 text-xs text-primary-foreground/70">@FormatHelper.Currency(_summary.TotalOutstandingAllTime) still outstanding</p>
                    </div>
                    <div class="rounded-xl bg-black/10 p-2.5">
                        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                    </div>
                </div>
            </section>
        </div>

        <section class="rounded-2xl border border-border bg-card p-5">
            <div class="mb-5">
                <h2 class="text-lg font-semibold text-foreground">Finance Snapshot</h2>
                <p class="text-xs text-muted-foreground">Billed, collected, expenses, and net for the selected period</p>
            </div>
            <div class="grid gap-3 md:grid-cols-4">
                <div class="rounded-2xl border border-border bg-muted/50 px-4 py-3">
                    <p class="text-[11px] font-semibold uppercase tracking-[0.2em] text-muted-foreground">Billed</p>
                    <p class="mt-1 font-mono text-sm font-semibold text-foreground">@FormatHelper.Currency(_summary.TotalBilledAllTime)</p>
                </div>
                <div class="rounded-2xl border border-border bg-muted/50 px-4 py-3">
                    <p class="text-[11px] font-semibold uppercase tracking-[0.2em] text-muted-foreground">Collected</p>
                    <p class="mt-1 font-mono text-sm font-semibold text-emerald-600">@FormatHelper.Currency(_summary.TotalCollectedAllTime)</p>
                </div>
                <div class="rounded-2xl border border-border bg-muted/50 px-4 py-3">
                    <p class="text-[11px] font-semibold uppercase tracking-[0.2em] text-muted-foreground">Expenses</p>
                    <p class="mt-1 font-mono text-sm font-semibold text-foreground">@FormatHelper.Currency(_summary.TotalExpensesAllTime)</p>
                </div>
                <div class="rounded-2xl border border-border bg-muted/50 px-4 py-3">
                    <p class="text-[11px] font-semibold uppercase tracking-[0.2em] text-muted-foreground">Net</p>
                    <p class="mt-1 font-mono text-sm font-semibold text-foreground">@FormatHelper.Currency(_summary.NetIncomeAllTime)</p>
                </div>
            </div>
            <div class="mt-5 grid gap-3 md:grid-cols-4">
                <div class="rounded-2xl border border-border bg-muted/50 px-4 py-3">
                    <p class="text-[11px] font-semibold uppercase tracking-[0.2em] text-muted-foreground">Fuel</p>
                    <p class="mt-1 font-mono text-sm font-semibold text-foreground">@FormatHelper.Currency(_summary.ExpensesByType.Fuel)</p>
                </div>
                <div class="rounded-2xl border border-border bg-muted/50 px-4 py-3">
                    <p class="text-[11px] font-semibold uppercase tracking-[0.2em] text-muted-foreground">Maintenance</p>
                    <p class="mt-1 font-mono text-sm font-semibold text-foreground">@FormatHelper.Currency(_summary.ExpensesByType.Maintenance)</p>
                </div>
                <div class="rounded-2xl border border-border bg-muted/50 px-4 py-3">
                    <p class="text-[11px] font-semibold uppercase tracking-[0.2em] text-muted-foreground">Employees</p>
                    <p class="mt-1 font-mono text-sm font-semibold text-foreground">@FormatHelper.Currency(_summary.ExpensesByType.Employees)</p>
                </div>
                <div class="rounded-2xl border border-border bg-muted/50 px-4 py-3">
                    <p class="text-[11px] font-semibold uppercase tracking-[0.2em] text-muted-foreground">Other</p>
                    <p class="mt-1 font-mono text-sm font-semibold text-foreground">@FormatHelper.Currency(_summary.ExpensesByType.Other)</p>
                </div>
            </div>
        </section>

        <div class="grid gap-4 lg:grid-cols-5">
            <section class="rounded-2xl border border-border bg-card p-5 lg:col-span-3">
                <div class="mb-4 flex items-center justify-between">
                    <h2 class="text-lg font-semibold text-foreground">Recently Paid Invoices</h2>
                    <a href="invoices" class="text-xs font-medium text-primary hover:opacity-75">View All</a>
                </div>
                @if (_summary.RecentlyPaid.Count == 0)
                {
                    <p class="text-sm text-muted-foreground">No paid invoices yet.</p>
                }
                else
                {
                    @foreach (var invoice in _summary.RecentlyPaid)
                    {
                        <div class="flex items-center gap-3 border-b border-border py-3 last:border-b-0">
                            <div class="flex h-8 w-8 items-center justify-center rounded-full text-white text-xs font-semibold shrink-0" style="background-color: @FormatHelper.AvatarColor(invoice.CustomerName)">@FormatHelper.Initials(invoice.CustomerName)</div>
                            <div class="min-w-0 flex-1">
                                <p class="truncate text-sm font-medium text-foreground">@invoice.CustomerName</p>
                                <p class="text-xs text-muted-foreground">INV #@invoice.InvoiceNumber · @FormatHelper.Date(invoice.CreatedAt)</p>
                            </div>
                            <div class="text-right">
                                <p class="font-mono text-sm font-semibold text-foreground">@FormatHelper.Currency(invoice.PaidAmount)</p>
                                <p class="text-xs text-muted-foreground">@FormatHelper.Date(invoice.CreatedAt)</p>
                            </div>
                            <InvoiceStatusBadge Status="paid" />
                        </div>
                    }
                }
            </section>

            <section class="rounded-2xl border border-border bg-card p-5 lg:col-span-2">
                <div class="mb-4 flex items-center justify-between">
                    <h2 class="text-lg font-semibold text-foreground">Upcoming Due</h2>
                    <span class="rounded-full border border-red-400/20 bg-red-400/10 px-2 py-0.5 text-xs font-medium text-red-400">@_summary.UpcomingDue.Count pending</span>
                </div>
                @if (_summary.UpcomingDue.Count == 0)
                {
                    <p class="text-sm text-muted-foreground">No unpaid or partially paid invoices found.</p>
                }
                else
                {
                    @foreach (var invoice in _summary.UpcomingDue)
                    {
                        var status = invoice.InvoiceStatus.Equals("PartiallyPaid", StringComparison.OrdinalIgnoreCase) ? "partiallyPaid" : "unpaid";
                        <div class="flex items-center gap-3 border-b border-border py-3 last:border-b-0">
                            <div class="flex h-8 w-8 items-center justify-center rounded-full text-white text-xs font-semibold shrink-0" style="background-color: @FormatHelper.AvatarColor(invoice.CustomerName)">@FormatHelper.Initials(invoice.CustomerName)</div>
                            <div class="min-w-0 flex-1">
                                <p class="truncate text-sm font-medium text-foreground">@invoice.CustomerName</p>
                                <p class="text-xs text-muted-foreground">Due @FormatHelper.Date(invoice.ConsumptionEnd)</p>
                            </div>
                            <div class="flex items-center gap-2">
                                <span class="font-mono text-sm font-semibold text-foreground">@FormatHelper.Currency(invoice.AmountDue)</span>
                                <InvoiceStatusBadge Status="@status" />
                            </div>
                        </div>
                    }
                }
                <a href="invoices" class="mt-4 inline-flex w-full items-center justify-center rounded-xl bg-primary px-4 py-2.5 text-sm font-medium text-primary-foreground hover:opacity-90" style="box-shadow: 0 0 16px rgba(230,196,58,0.2);">Review All Balances</a>
            </section>
        </div>
    }
</div>

@code {
    private DashboardSummaryResponse? _summary;
    private bool _loading = true;
    private string _periodKey = "all";
    private string _displayName = "Admin";
    private readonly List<(string Key, string Label, int Year, int Month)> _periodOptions = [];

    protected override async Task OnInitializedAsync()
    {
        var now = DateTime.Now;
        for (var i = 0; i < 6; i++)
        {
            var date = new DateOnly(now.Year, now.Month, 1).AddMonths(-i);
            _periodOptions.Add(($"{date.Year}-{date.Month:D2}", date.ToString("MMMM yyyy"), date.Year, date.Month));
        }

        var profile = await AppUserService.GetAsync();
        if (!string.IsNullOrWhiteSpace(profile?.FullName))
            _displayName = profile.FullName;

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        int? year = null;
        int? month = null;
        if (_periodKey != "all")
        {
            var option = _periodOptions.FirstOrDefault(o => o.Key == _periodKey);
            if (option.Key is not null)
            {
                year = option.Year;
                month = option.Month;
            }
        }

        _summary = await UiActions.RunAsync(Toast, () => DashboardService.GetSummaryAsync(year, month));
        _loading = false;
    }
}
