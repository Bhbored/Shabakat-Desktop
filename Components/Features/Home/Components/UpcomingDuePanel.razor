@namespace Shabakat.Components.Features.Home.Components
@inject IStringLocalizer<SharedResource> L

<section class="rounded-2xl border border-border bg-card p-5 lg:col-span-2">
    @if (IsLoading)
    {
        <div class="mb-4 flex items-center justify-between">
            <h2 class="text-lg font-semibold text-foreground">@L["Home.UpcomingDue"]</h2>
            <SkeletonBone Class="h-6 w-16 rounded-full" />
        </div>
        <div class="space-y-3">
            @for (var i = 0; i < 5; i++)
            {
                <ListRowSkeleton />
            }
        </div>
    }
    else
    {
        <div class="mb-4 flex items-center justify-between">
            <h2 class="text-lg font-semibold text-foreground">@L["Home.UpcomingDue"]</h2>
            <span class="rounded-full border border-red-400/20 bg-red-400/10 px-2 py-0.5 text-xs font-medium text-red-400">
                @L["Home.PendingCount", Items.Count]
            </span>
        </div>

        @if (Items.Count == 0)
        {
            <p class="rounded-xl border border-border bg-white/[0.02] px-3 py-6 text-sm text-muted-foreground">
                @L["Home.NoUpcoming"]
            </p>
        }
        else
        {
            <div>
                @foreach (var invoice in Items)
                {
                    <div class="flex items-center gap-3 border-b border-border py-3 last:border-b-0">
                        <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full text-xs font-semibold text-white"
                             style="background-color: @FormatHelper.AvatarColor(invoice.CustomerName)">
                            @FormatHelper.Initials(invoice.CustomerName)
                        </div>
                        <div class="min-w-0 flex-1">
                            <p class="truncate text-sm font-medium text-foreground">@invoice.CustomerName</p>
                            <p class="text-xs text-muted-foreground">@L["Home.DueOn", FormatHelper.Date(invoice.ConsumptionEnd)]</p>
                        </div>
                        <div class="flex items-center gap-2">
                            <span class="font-mono text-sm font-semibold text-foreground">@FormatHelper.Currency(invoice.AmountDue)</span>
                            <InvoiceStatusBadge Status="@ResolveStatus(invoice.ConsumptionEnd)" />
                        </div>
                    </div>
                }
            </div>
        }

        <a href="subscribers"
           class="mt-4 inline-flex w-full items-center justify-center rounded-xl bg-primary px-4 py-2.5 text-sm font-medium text-primary-foreground transition hover:opacity-90"
           style="box-shadow: 0 0 16px rgba(245,192,0,0.2);">
            @L["Home.ReviewBalances"]
        </a>
    }
</section>

@code {
    [Parameter] public IReadOnlyList<InvoiceSummaryResponse> Items { get; set; } = [];
    [Parameter] public bool IsLoading { get; set; }

    private static string ResolveStatus(DateOnly dueDate)
    {
        var today = DateOnly.FromDateTime(DateTime.Today);
        return dueDate < today ? "overdue" : "unpaid";
    }
}
