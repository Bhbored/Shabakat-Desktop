@namespace Shabakat.Components.Features.Home.Components

<section class="rounded-2xl border border-border bg-card p-5 lg:col-span-3">
    @if (IsLoading)
    {
        <div class="mb-4 flex items-center justify-between">
            <h2 class="text-lg font-semibold text-foreground">Recently Paid Invoices</h2>
            <div class="h-6 w-16 animate-pulse rounded-full bg-muted"></div>
        </div>
        <div class="space-y-3">
            @for (var i = 0; i < 5; i++)
            {
                <div class="flex items-center gap-3 border-b border-border py-3 last:border-b-0">
                    <div class="h-9 w-9 animate-pulse rounded-full bg-muted"></div>
                    <div class="min-w-0 flex-1 space-y-2">
                        <div class="h-4 w-32 animate-pulse rounded bg-muted"></div>
                        <div class="mt-2 h-3 w-24 animate-pulse rounded bg-muted"></div>
                    </div>
                    <div class="space-y-2 text-right">
                        <div class="ml-auto h-4 w-20 animate-pulse rounded bg-muted"></div>
                        <div class="mt-2 ml-auto h-3 w-16 animate-pulse rounded bg-muted"></div>
                    </div>
                    <div class="h-6 w-16 animate-pulse rounded-full bg-muted"></div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="mb-4 flex items-center justify-between">
            <h2 class="text-lg font-semibold text-foreground">Recently Paid Invoices</h2>
            <a href="subscribers" class="text-xs font-medium text-primary transition-opacity hover:opacity-75">View all</a>
        </div>

        @if (Items.Count == 0)
        {
            <p class="rounded-xl border border-border bg-white/[0.02] px-3 py-6 text-sm text-muted-foreground">
                No paid invoices yet for current dataset.
            </p>
        }
        else
        {
            <div>
                @foreach (var invoice in Items)
                {
                    <div class="flex items-center gap-3 border-b border-border py-3 last:border-b-0">
                        <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full text-xs font-semibold text-white"
                             style="background-color: @FormatHelper.AvatarColor(invoice.CustomerName)">
                            @FormatHelper.Initials(invoice.CustomerName)
                        </div>
                        <div class="min-w-0 flex-1">
                            <p class="truncate text-sm font-medium text-foreground">@invoice.CustomerName</p>
                            <p class="text-xs text-muted-foreground">
                                Invoice #@invoice.InvoiceNumber · Issued @FormatHelper.Date(invoice.ConsumptionStart)
                            </p>
                        </div>
                        <div class="text-right">
                            <p class="font-mono text-sm font-semibold text-foreground">
                                @FormatHelper.Currency(invoice.PaidAmount > 0 ? invoice.PaidAmount : invoice.TotalAmount)
                            </p>
                            <p class="text-xs text-muted-foreground">@FormatHelper.Date(invoice.CreatedAt)</p>
                        </div>
                        <InvoiceStatusBadge Status="paid" />
                    </div>
                }
            </div>
        }
    }
</section>

@code {
    [Parameter] public IReadOnlyList<InvoiceSummaryResponse> Items { get; set; } = [];
    [Parameter] public bool IsLoading { get; set; }
}
