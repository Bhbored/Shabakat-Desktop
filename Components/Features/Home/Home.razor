@page "/"
@inject IDashboardService DashboardService
@inject IToastService Toast
@inject ICultureService CultureService
@inject IStringLocalizer<SharedResource> L
@implements IDisposable

<div class="space-y-5">
    <div class="flex items-center justify-between gap-3">
        <h1 class="text-xl font-bold text-foreground">@L["Page.Dashboard.Title"]</h1>
        <div class="relative min-w-56">
            <svg class="pointer-events-none absolute inset-s-3 top-1/2 h-4 w-4 -translate-y-1/2 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            <select class="h-11 w-full appearance-none rounded-xl border border-border bg-card py-2.5 pe-4 ps-9 text-sm text-foreground outline-none"
                    value="@_periodKey"
                    @onchange="OnPeriodChangedAsync">
                <option value="all">@L["Home.AllTime"]</option>
                @foreach (var option in _periodOptions)
                {
                    <option value="@option.Key">@option.Label</option>
                }
            </select>
        </div>
    </div>

    @if (_summaryLoading && _summary is null)
    {
        <DashboardSkeleton />
    }
    else if (_summary is not null)
    {
        <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
            <MetricCard Label="@L["Home.TotalSubscribers"]"
                        Value="@_summary.Customers.Total.ToString()"
                        Hint="@L["Home.SubscribersHint", _summary.Customers.Active, _summary.Customers.Suspended]"
                        AccentClass="text-foreground">
                <Icon>
                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                </Icon>
            </MetricCard>

            <MetricCard Label="@L["Home.CollectedAllTime"]"
                        Value="@FormatHelper.Currency(_summary.TotalCollectedAllTime)"
                        Hint="@L["Home.CollectedHint", _summary.CollectionRate.ToString("0"), FormatHelper.Currency(_summary.TotalBilledAllTime)]"
                        AccentClass="text-emerald-400">
                <Icon>
                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><polyline points="16 11 18 13 22 9"/></svg>
                </Icon>
            </MetricCard>

            <MetricCard Label="@L["Home.OutstandingInvoices"]"
                        Value="@((_summary.Invoices.UnpaidCount + _summary.Invoices.PartiallyPaidCount).ToString())"
                        Hint="@L["Home.OutstandingHint", _summary.Invoices.UnpaidCount, _summary.Invoices.PartiallyPaidCount]"
                        AccentClass="text-red-400">
                <Icon>
                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                </Icon>
            </MetricCard>

            <section class="rounded-2xl border border-primary/30 bg-primary p-5 text-primary-foreground shadow-[0_0_30px_rgba(245,192,0,0.18)]">
                <div class="flex items-start justify-between">
                    <div>
                        <p class="text-xs font-semibold uppercase tracking-[0.22em] text-primary-foreground/70">@L["Home.NetIncomeAllTime"]</p>
                        <p class="mt-2 font-mono text-3xl font-bold">@FormatHelper.Currency(_summary.NetIncomeAllTime)</p>
                        <p class="mt-1 flex items-center gap-1 text-xs text-primary-foreground/70">
                            <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17 17 7"/><path d="M7 7h10v10"/></svg>
                            @L["Home.OutstandingAmount", FormatHelper.Currency(_summary.TotalOutstandingAllTime)]
                        </p>
                    </div>
                    <div class="rounded-xl bg-black/10 p-2.5">
                        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                    </div>
                </div>
            </section>
        </div>

        <RevenueChartCard Summary="_summary" />
    }

    <div class="grid gap-4 lg:grid-cols-5">
        <RecentPaymentsPanel Items="_recentPaid" IsLoading="_panelsLoading" />
        <UpcomingDuePanel Items="_upcomingDue" IsLoading="_panelsLoading" />
    </div>

    <FuelMarketPreviewCard />
</div>

@code {
    private DashboardSummaryResponse? _summary;
    private IReadOnlyList<InvoiceSummaryResponse> _recentPaid = [];
    private IReadOnlyList<InvoiceSummaryResponse> _upcomingDue = [];
    private bool _summaryLoading = true;
    private bool _panelsLoading = true;
    private string _periodKey = "all";
    private readonly List<(string Key, string Label, int Year, int Month)> _periodOptions = [];

    protected override async Task OnInitializedAsync()
    {
        CultureService.Changed += OnCultureChanged;
        RebuildPeriodOptions();
        await LoadAsync(includePanels: true);
    }

    private void RebuildPeriodOptions()
    {
        _periodOptions.Clear();
        var now = DateTime.Now;
        for (var i = 0; i < 18; i++)
        {
            var date = new DateOnly(now.Year, now.Month, 1).AddMonths(-i);
            _periodOptions.Add(($"{date.Year}-{date.Month}", FormatHelper.MonthYear(date.Year, date.Month), date.Year, date.Month));
        }
    }

    private void OnCultureChanged() => _ = InvokeAsync(() =>
    {
        RebuildPeriodOptions();
        StateHasChanged();
        return Task.CompletedTask;
    });

    private async Task OnPeriodChangedAsync(ChangeEventArgs e)
    {
        _periodKey = e.Value?.ToString() ?? "all";
        await LoadAsync(includePanels: false);
    }

    private async Task LoadAsync(bool includePanels)
    {
        _summaryLoading = true;
        if (includePanels)
            _panelsLoading = true;

        int? year = null;
        int? month = null;
        if (_periodKey != "all")
        {
            var option = _periodOptions.FirstOrDefault(o => o.Key == _periodKey);
            if (option.Key is not null)
            {
                year = option.Year;
                month = option.Month;
            }
        }

        var summary = await UiActions.RunAsync(Toast, () => DashboardService.GetSummaryAsync(year, month));
        if (summary is not null)
        {
            _summary = summary;
            if (includePanels)
            {
                _recentPaid = summary.RecentlyPaid
                    .OrderByDescending(i => i.CreatedAt)
                    .Take(5)
                    .ToList();
                _upcomingDue = summary.UpcomingDue
                    .OrderBy(i => i.PaymentDueDate)
                    .Take(5)
                    .ToList();
            }
        }

        _summaryLoading = false;
        if (includePanels)
            _panelsLoading = false;
    }

    public void Dispose()
    {
        CultureService.Changed -= OnCultureChanged;
    }
}
