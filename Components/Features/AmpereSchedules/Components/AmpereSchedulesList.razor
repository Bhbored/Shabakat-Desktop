@namespace Shabakat.Components.Features.AmpereSchedules.Components
@inject IStringLocalizer<SharedResource> L

@if (IsLoading)
{
    <EntityCardGridSkeleton Count="4" CardClass="rounded-2xl border border-border bg-card/80 p-5" />
}
else if (Schedules.Count == 0)
{
    <section class="rounded-2xl border border-border bg-card px-4 py-10 text-sm text-muted-foreground">
        @L["Empty.SchedulesNone"]
    </section>
}
else
{
    <div class="grid gap-4 xl:grid-cols-2">
        @foreach (var schedule in Schedules)
        {
            <AmpereScheduleCard Schedule="schedule"
                                MenuOpen="@(OpenMenuId == schedule.Id)"
                                OnToggleMenu="() => OnToggleMenu.InvokeAsync(schedule.Id)"
                                OnView="() => OnView.InvokeAsync(schedule)"
                                OnEdit="() => OnEdit.InvokeAsync(schedule)"
                                OnDelete="() => OnDelete.InvokeAsync(schedule)" />
        }
    </div>
}

@code {
    [Parameter] public IReadOnlyList<AmpereScheduleResponse> Schedules { get; set; } = [];
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public Guid? OpenMenuId { get; set; }
    [Parameter] public EventCallback<Guid> OnToggleMenu { get; set; }
    [Parameter] public EventCallback<AmpereScheduleResponse> OnView { get; set; }
    [Parameter] public EventCallback<AmpereScheduleResponse> OnEdit { get; set; }
    [Parameter] public EventCallback<AmpereScheduleResponse> OnDelete { get; set; }
}
