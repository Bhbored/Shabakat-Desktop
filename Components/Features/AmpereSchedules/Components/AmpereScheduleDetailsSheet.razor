@namespace Shabakat.Components.Features.AmpereSchedules.Components
@inject IStringLocalizer<SharedResource> L
@inject NavigationManager Navigation

<SideSheet Open="Open"
           Title="@(Schedule?.Name ?? L["Ampere.Details"].Value)"
           Description="@L["Ampere.DetailsHint"]"
           MaxWidthClass="sm:max-w-xl"
           OnClose="OnClose">
    @if (Schedule is not null)
    {
        <div class="space-y-4">
            <div class="grid gap-4 md:grid-cols-2">
                <div class="rounded-2xl border border-border bg-card p-4">
                    <p class="text-xs uppercase tracking-[0.18em] text-muted-foreground">@L["Ampere.Subscribers"]</p>
                    <p class="mt-2 text-xl font-semibold text-foreground">
                        @(Schedule.CustomerCount == 1 ? L["Count.Subscribers", Schedule.CustomerCount] : L["Count.SubscribersPlural", Schedule.CustomerCount])
                    </p>
                </div>
                <div class="rounded-2xl border border-border bg-card p-4">
                    <p class="text-xs uppercase tracking-[0.18em] text-muted-foreground">@L["Ampere.HoursPerDay"]</p>
                    <p class="mt-2 text-xl font-semibold text-foreground">@L["Ampere.HoursPerDayValue", Schedule.HoursPerDay]</p>
                </div>
            </div>

            <div class="space-y-3 rounded-2xl border border-border bg-card p-5">
                <p class="text-xs font-semibold uppercase tracking-[0.18em] text-muted-foreground">@L["Ampere.PricingPerAmp"]</p>
                <div class="grid gap-3 sm:grid-cols-2">
                    <div class="rounded-xl border border-border bg-muted/40 px-3 py-2">
                        <p class="text-[11px] uppercase tracking-[0.18em] text-muted-foreground">@L["Ampere.Base"]</p>
                        <p class="mt-1 text-sm font-medium text-foreground">@Schedule.PricePerAmp.ToString("0.00")</p>
                    </div>
                    <div class="rounded-xl border border-border bg-muted/40 px-3 py-2">
                        <p class="text-[11px] uppercase tracking-[0.18em] text-muted-foreground">@L["CustomerType.Residential"]</p>
                        <p class="mt-1 text-sm font-medium text-foreground">@Schedule.ResidentialPricePerAmp.ToString("0.00")</p>
                    </div>
                    <div class="rounded-xl border border-border bg-muted/40 px-3 py-2">
                        <p class="text-[11px] uppercase tracking-[0.18em] text-muted-foreground">@L["CustomerType.Commercial"]</p>
                        <p class="mt-1 text-sm font-medium text-foreground">@Schedule.CommercialPricePerAmp.ToString("0.00")</p>
                    </div>
                    <div class="rounded-xl border border-border bg-muted/40 px-3 py-2">
                        <p class="text-[11px] uppercase tracking-[0.18em] text-muted-foreground">@L["CustomerType.Industrial"]</p>
                        <p class="mt-1 text-sm font-medium text-foreground">@Schedule.IndustrialPricePerAmp.ToString("0.00")</p>
                    </div>
                </div>
            </div>

            <div class="space-y-4 rounded-2xl border border-border bg-card p-5">
                <div class="flex items-start justify-between gap-3">
                    <div class="space-y-4 min-w-0 flex-1">
                        <div class="flex items-start gap-3">
                            <div class="rounded-lg border border-border bg-muted/40 p-2 text-primary">
                                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                            </div>
                            <div>
                                <p class="text-xs uppercase tracking-[0.18em] text-muted-foreground">@L["Ampere.HoursPerDay"]</p>
                                <p class="mt-1 text-sm text-foreground">@L["Ampere.HoursPerDayValue", Schedule.HoursPerDay]</p>
                            </div>
                        </div>
                        <div class="flex items-start gap-3">
                            <div class="rounded-lg border border-border bg-muted/40 p-2 text-primary">
                                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
                            </div>
                            <div>
                                <p class="text-xs uppercase tracking-[0.18em] text-muted-foreground">@L["Ampere.AssignedSubscribers"]</p>
                                <p class="mt-1 text-sm text-foreground">@Schedule.CustomerCount</p>
                            </div>
                        </div>
                        <div class="flex items-start gap-3">
                            <div class="rounded-lg border border-border bg-muted/40 p-2 text-primary">
                                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                            </div>
                            <div>
                                <p class="text-xs uppercase tracking-[0.18em] text-muted-foreground">@L["Common.CreatedAt"]</p>
                                <p class="mt-1 text-sm text-foreground">@FormatHelper.Date(Schedule.CreatedAt)</p>
                            </div>
                        </div>
                    </div>
                    <button type="button"
                            class="inline-flex shrink-0 items-center gap-2 rounded-xl border border-border bg-muted/40 px-3 py-2 text-sm font-medium text-foreground hover:bg-muted"
                            @onclick="NavigateToSubscribers">
                        <svg class="h-4 w-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3" /></svg>
                        @L["Areas.ViewSubscribers"]
                    </button>
                </div>
            </div>
        </div>
    }
</SideSheet>

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public AmpereScheduleResponse? Schedule { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private void NavigateToSubscribers()
    {
        if (Schedule is null)
            return;

        Navigation.NavigateTo($"subscribers/schedule/{Schedule.Id}");
    }
}
