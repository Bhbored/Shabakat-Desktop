@namespace Shabakat.Components.Features.AmpereSchedules.Components

<ConfirmDialog Open="Open" Title="Delete ampere schedule" OnClose="OnClose">
    <ChildContent>
        @if (Schedule is not null)
        {
            <p>
                Delete <span class="font-medium text-foreground">@Schedule.Name</span>? This cannot be undone.
            </p>
        }
    </ChildContent>
    <Footer>
        <button type="button"
                class="rounded-xl border border-border px-4 py-2.5 text-sm font-medium text-foreground hover:bg-muted"
                disabled="@Saving"
                @onclick="OnClose">
            Cancel
        </button>
        <button type="button"
                class="rounded-xl bg-red-500 px-4 py-2.5 text-sm font-medium text-white hover:bg-red-500/90 disabled:opacity-50"
                disabled="@Saving"
                @onclick="OnConfirm">
            @(Saving ? "Deleting..." : "Delete")
        </button>
    </Footer>
</ConfirmDialog>

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public AmpereScheduleResponse? Schedule { get; set; }
    [Parameter] public bool Saving { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnConfirm { get; set; }
}
