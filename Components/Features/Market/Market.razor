@page "/fuel-market"
@inject IGlobalMarketService GlobalMarketService
@inject ILebanonMarketService LebanonMarketService
@inject IMarketConnectivity Connectivity
@inject IToastService Toast
@inject IStringLocalizer<SharedResource> L
@implements IAsyncDisposable

<div class="space-y-5">
    <header class="flex flex-wrap items-start justify-between gap-4">
        <div>
            <p class="text-xs font-semibold uppercase tracking-[0.22em] text-primary">@L["Market.EnergyIntelligence"]</p>
            <h1 class="mt-1 text-2xl font-bold text-foreground">@L["Market.Title"]</h1>
            <p class="mt-1 max-w-2xl text-sm text-muted-foreground">@L["Market.Description"]</p>
        </div>
        <button type="button" class="inline-flex h-11 items-center gap-2 rounded-xl border border-border bg-card px-4 text-sm font-semibold text-foreground hover:bg-muted disabled:opacity-50" disabled="@(_globalLoading || _lebanonLoading)" @onclick="RefreshAllAsync">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 11a8.1 8.1 0 0 0-15.5-2M4 4v5h5"/><path d="M4 13a8.1 8.1 0 0 0 15.5 2M20 20v-5h-5"/></svg>
            @L["Market.Refresh"]
        </button>
    </header>

    <section class="rounded-2xl border border-border bg-card p-5">
        <div class="inline-grid w-full grid-cols-2 gap-1 rounded-xl bg-muted p-1 sm:w-auto" role="group" aria-label="@L["Market.Title"]">
            <button id="market-switch-lebanon"
                    type="button"
                    class="@MarketSwitchClass(MarketView.Lebanon)"
                    aria-pressed="@(_activeMarket == MarketView.Lebanon)"
                    aria-controls="market-panel-lebanon"
                    @onclick="() => SwitchMarket(MarketView.Lebanon)">
                @L["Market.LebanonTitle"]
            </button>
            <button id="market-switch-global"
                    type="button"
                    class="@MarketSwitchClass(MarketView.Global)"
                    aria-pressed="@(_activeMarket == MarketView.Global)"
                    aria-controls="market-panel-global"
                    @onclick="() => SwitchMarket(MarketView.Global)">
                @L["Market.GlobalTitle"]
            </button>
        </div>

        <div @key="_activeMarket" class="market-panel-swap mt-5" role="region" id="@ActivePanelId" aria-labelledby="@ActiveSwitchId">
            @if (_activeMarket == MarketView.Lebanon)
            {
                <div class="space-y-4">
                    <div>
                        <h2 class="text-lg font-semibold text-foreground">@L["Market.LebanonTitle"]</h2>
                        <p class="text-xs text-muted-foreground">@L["Market.LebanonHint"]</p>
                    </div>

                    @if (_lebanonStale && _lebanon is not null)
                    {
                        <MarketStaleBanner FetchedAt="_lebanon.FetchedAt" Retrying="_lebanonLoading" OnRetry="RetryLebanonAsync" />
                    }

                    @if (_lebanonLoading && _lebanon is null)
                    {
                        <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
                            @for (var i = 0; i < 4; i++) { <SkeletonBone Class="h-28 rounded-2xl" /> }
                        </div>
                        <SkeletonBone Class="h-72 rounded-2xl" />
                    }
                    else if (_lebanon is null)
                    {
                        <MarketSectionError ErrorKey="@(_lebanonError ?? "Error.Market.LebanonUnavailable")" Retrying="_lebanonLoading" OnRetry="RetryLebanonAsync" />
                    }
                    else
                    {
                        <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
                            @foreach (var quote in _lebanon.Quotes)
                            {
                                <MarketQuoteCard Label="@LebanonLabel(quote.Code)" Value="@FormatHelper.Number(quote.Price)" Unit="@quote.Currency" />
                            }
                        </div>
                        <div class="rounded-2xl border border-border bg-muted/10 p-4">
                            <div class="mb-4">
                                <h3 class="font-semibold text-foreground">@L["Market.LebanonHistory"]</h3>
                                <p class="text-xs text-muted-foreground">@L["Market.SourceDate", FormatHelper.Date(_lebanon.SourceDate.LocalDateTime)]</p>
                            </div>
                            <MarketLineChart Series="@LebanonChartSeries()" Unit="L.L." AriaLabel="@L["Market.LebanonChartAria"]" />
                        </div>
                        <p class="text-xs text-muted-foreground">@L["Market.Source"] <a class="text-primary underline-offset-4 hover:underline" href="https://www.iptgroup.com.lb/ipt/en/our-stations/fuel-prices" target="_blank" rel="noreferrer">IPT Group Lebanon</a></p>
                    }
                </div>
            }
            else
            {
                <div class="space-y-4">
                    <div class="flex flex-wrap items-end justify-between gap-3">
                        <div>
                            <h2 class="text-lg font-semibold text-foreground">@L["Market.GlobalTitle"]</h2>
                            <p class="text-xs text-muted-foreground">@L["Market.GlobalHint"]</p>
                        </div>
                        <label class="relative block">
                            <span class="sr-only">@L["Market.ChartRange"]</span>
                            <select class="h-11 min-w-32 cursor-pointer rounded-xl border border-border bg-card px-3 pe-9 text-sm font-semibold text-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring disabled:cursor-not-allowed disabled:opacity-50"
                                    value="@_range"
                                    disabled="@_globalLoading"
                                    aria-label="@L["Market.ChartRange"]"
                                    @onchange="OnRangeChangedAsync">
                                @foreach (var option in RangeOptions)
                                {
                                    <option value="@option.Range">@option.Label</option>
                                }
                            </select>
                        </label>
                    </div>

                    @if (_globalStale && _global is not null)
                    {
                        <MarketStaleBanner FetchedAt="_global.FetchedAt" Retrying="_globalLoading" OnRetry="RetryGlobalAsync" />
                    }

                    @if (_globalLoading && _global is null)
                    {
                        <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-5">
                            @for (var i = 0; i < 5; i++) { <SkeletonBone Class="h-28 rounded-2xl" /> }
                        </div>
                        <SkeletonBone Class="h-72 rounded-2xl" />
                    }
                    else if (_global is null)
                    {
                        <MarketSectionError ErrorKey="@(_globalError ?? "Error.Market.GlobalUnavailable")" Retrying="_globalLoading" OnRetry="RetryGlobalAsync" />
                    }
                    else
                    {
                        <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-5">
                            @foreach (var quote in _global.Quotes)
                            {
                                <MarketQuoteCard Label="@InstrumentLabel(quote.Code)" Value="@FormatHelper.Number(quote.Price)" Unit="@quote.Unit" ChangePercent="quote.ChangePercent" />
                            }
                        </div>

                        <div class="rounded-2xl border border-border bg-muted/10 p-4">
                            <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
                                <div>
                                    <h3 class="font-semibold text-foreground">@L["Market.PriceHistory"]</h3>
                                    <p class="text-xs text-muted-foreground">@L["Market.UpdatedAt", _global.FetchedAt.LocalDateTime.ToString("g")]</p>
                                </div>
                                <select class="h-11 min-w-52 rounded-xl border border-border bg-card px-3 text-sm text-foreground" value="@_selectedInstrument" @onchange="OnInstrumentChanged">
                                    @foreach (var quote in _global.Quotes)
                                    {
                                        <option value="@quote.Code">@InstrumentLabel(quote.Code)</option>
                                    }
                                </select>
                            </div>
                            @if (SelectedQuote is { } selected)
                            {
                                <MarketLineChart Series="@GlobalChartSeries(selected)" Unit="@selected.Unit" AriaLabel="@L["Market.ChartAria", InstrumentLabel(selected.Code)]" />
                            }
                        </div>
                        <p class="text-xs text-muted-foreground">@L["Market.DelayedDisclaimer"] <a class="text-primary underline-offset-4 hover:underline" href="https://finance.yahoo.com/markets/commodities/" target="_blank" rel="noreferrer">Yahoo Finance</a></p>
                    }
                </div>
            }
        </div>
    </section>
</div>

@code {
    private static readonly string[] ChartColors = ["#f5c000", "#38bdf8", "#22c55e", "#fb7185"];
    private readonly CancellationTokenSource _disposeCts = new();
    private readonly SemaphoreSlim _refreshGate = new(1, 1);
    private GlobalMarketResponse? _global;
    private LebanonMarketResponse? _lebanon;
    private MarketRange _range = MarketRange.OneMonth;
    private string _selectedInstrument = "WTI";
    private string? _globalError;
    private string? _lebanonError;
    private bool _globalLoading = true;
    private bool _lebanonLoading = true;
    private bool _globalStale;
    private bool _lebanonStale;
    private bool _globalFailureNotified;
    private bool _lebanonFailureNotified;
    private MarketView _activeMarket = MarketView.Lebanon;

    private string ActivePanelId => _activeMarket == MarketView.Lebanon
        ? "market-panel-lebanon"
        : "market-panel-global";

    private string ActiveSwitchId => _activeMarket == MarketView.Lebanon
        ? "market-switch-lebanon"
        : "market-switch-global";

    private IEnumerable<(MarketRange Range, string Label)> RangeOptions =>
    [
        (MarketRange.OneMonth, L["Market.Range.1M"].Value),
        (MarketRange.ThreeMonths, L["Market.Range.3M"].Value),
        (MarketRange.OneYear, L["Market.Range.1Y"].Value)
    ];

    private CommodityQuoteResponse? SelectedQuote =>
        _global?.Quotes.FirstOrDefault(q => q.Code == _selectedInstrument) ?? _global?.Quotes.FirstOrDefault();

    protected override async Task OnInitializedAsync()
    {
        Connectivity.ConnectivityChanged += OnConnectivityChanged;
        await LoadAllAsync(false);
        _ = RefreshLoopAsync(_disposeCts.Token);
    }

    private async Task LoadAllAsync(bool force)
    {
        await _refreshGate.WaitAsync(_disposeCts.Token);
        try { await Task.WhenAll(LoadGlobalAsync(force), LoadLebanonAsync(force)); }
        finally { _refreshGate.Release(); }
    }

    private async Task LoadGlobalAsync(bool force)
    {
        _globalLoading = true;
        try
        {
            _global = await GlobalMarketService.GetAsync(_range, force, _disposeCts.Token);
            _globalError = null;
            _globalStale = false;
            _globalFailureNotified = false;
        }
        catch (DomainException ex)
        {
            _globalError = ex.Message;
            _global = await GlobalMarketService.GetCachedAsync(_range, _disposeCts.Token);
            _globalStale = _global is not null;
            NotifyOnce(ex, ref _globalFailureNotified);
        }
        finally { _globalLoading = false; }
    }

    private async Task LoadLebanonAsync(bool force)
    {
        _lebanonLoading = true;
        try
        {
            _lebanon = await LebanonMarketService.GetAsync(force, _disposeCts.Token);
            _lebanonError = null;
            _lebanonStale = false;
            _lebanonFailureNotified = false;
        }
        catch (DomainException ex)
        {
            _lebanonError = ex.Message;
            _lebanon = await LebanonMarketService.GetCachedAsync(_disposeCts.Token);
            _lebanonStale = _lebanon is not null;
            NotifyOnce(ex, ref _lebanonFailureNotified);
        }
        finally { _lebanonLoading = false; }
    }

    private void NotifyOnce(DomainException exception, ref bool notified)
    {
        if (notified) return;
        Toast.Error(exception);
        notified = true;
    }

    private Task RefreshAllAsync() => LoadAllAsync(true);
    private Task RetryGlobalAsync() => LoadGlobalAsync(true);
    private Task RetryLebanonAsync() => LoadLebanonAsync(true);

    private async Task OnRangeChangedAsync(ChangeEventArgs args)
    {
        if (!Enum.TryParse<MarketRange>(args.Value?.ToString(), out var range))
            return;
        if (_range == range) return;
        _range = range;
        _global = null;
        await LoadGlobalAsync(false);
    }

    private void OnInstrumentChanged(ChangeEventArgs e) =>
        _selectedInstrument = e.Value?.ToString() ?? "WTI";

    private void SwitchMarket(MarketView market) => _activeMarket = market;

    private string MarketSwitchClass(MarketView market) =>
        _activeMarket == market
            ? "h-11 cursor-pointer rounded-lg bg-card px-4 text-sm font-semibold text-foreground shadow-sm transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
            : "h-11 cursor-pointer rounded-lg px-4 text-sm font-medium text-muted-foreground transition-colors hover:bg-card/60 hover:text-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring";

    private void OnConnectivityChanged(object? sender, bool online) => _ = InvokeAsync(async () =>
    {
        if (!online)
        {
            _globalStale = _global is not null;
            _lebanonStale = _lebanon is not null;
            _globalError ??= "Error.Market.NoConnection";
            _lebanonError ??= "Error.Market.NoConnection";
            if (!_globalFailureNotified || !_lebanonFailureNotified)
                Toast.Error(new DomainException("Error.Market.NoConnection"));
            _globalFailureNotified = true;
            _lebanonFailureNotified = true;
            StateHasChanged();
            return;
        }
        await LoadAllAsync(true);
        StateHasChanged();
    });

    private async Task RefreshLoopAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromMinutes(5));
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
                await InvokeAsync(async () =>
                {
                    await LoadAllAsync(true);
                    StateHasChanged();
                });
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
    }

    private string InstrumentLabel(string code) => L[$"Market.Instrument.{code}"].Value;
    private string LebanonLabel(string code) => L[$"Market.Lebanon.{code}"].Value;

    private IReadOnlyList<MarketChartSeriesModel> GlobalChartSeries(CommodityQuoteResponse quote) =>
        [new(InstrumentLabel(quote.Code), quote.History, ChartColors[0])];

    private IReadOnlyList<MarketChartSeriesModel> LebanonChartSeries() =>
        _lebanon?.Series.Select((series, index) => new MarketChartSeriesModel(
            LebanonLabel(series.Code), series.History, ChartColors[index % ChartColors.Length], index * 2)).ToList() ?? [];

    public ValueTask DisposeAsync()
    {
        Connectivity.ConnectivityChanged -= OnConnectivityChanged;
        _disposeCts.Cancel();
        _disposeCts.Dispose();
        return ValueTask.CompletedTask;
    }

    private enum MarketView
    {
        Lebanon,
        Global
    }
}
