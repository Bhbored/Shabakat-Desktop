@namespace Shabakat.Components.Features.Market.Components
@inject IStringLocalizer<SharedResource> L

<div class="flex flex-wrap items-center justify-between gap-3 rounded-xl border border-amber-500/25 bg-amber-500/10 px-4 py-3 text-sm" role="status">
    <span class="flex items-center gap-2 text-amber-600 dark:text-amber-400">
        <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
        @L["Market.StaleData", FormatHelper.Date(FetchedAt.LocalDateTime)]
    </span>
    <button type="button" class="h-11 rounded-xl border border-amber-500/30 px-3 font-medium text-foreground disabled:opacity-50" disabled="@Retrying" @onclick="OnRetry">@L["Common.Retry"]</button>
</div>

@code {
    [Parameter] public DateTimeOffset FetchedAt { get; set; }
    [Parameter] public bool Retrying { get; set; }
    [Parameter] public EventCallback OnRetry { get; set; }
}
