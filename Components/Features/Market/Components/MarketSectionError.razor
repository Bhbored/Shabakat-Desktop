@namespace Shabakat.Components.Features.Market.Components
@inject IStringLocalizer<SharedResource> L

<div class="rounded-2xl border border-red-500/20 bg-red-500/5 px-5 py-8 text-center" role="alert">
    <div class="mx-auto flex h-11 w-11 items-center justify-center rounded-full bg-red-500/10 text-red-500">
        @if (IsOffline)
        {
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12.55a11 11 0 0 1 14.08 0" /><path d="M1.42 9a16 16 0 0 1 21.16 0" /><path d="M8.53 16.11a6 6 0 0 1 6.95 0" /><line x1="2" y1="2" x2="22" y2="22" /></svg>
        }
        else
        {
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10" /><line x1="12" y1="8" x2="12" y2="12" /><line x1="12" y1="16" x2="12.01" y2="16" /></svg>
        }
    </div>
    <h3 class="mt-3 font-semibold text-foreground">@(IsOffline ? L["Market.Error.OfflineTitle"] : L["Market.Error.SourceTitle"])</h3>
    <p class="mx-auto mt-1 max-w-lg text-sm text-muted-foreground">@L[ErrorKey]</p>
    <button type="button" class="mt-4 inline-flex h-11 items-center rounded-xl bg-primary px-4 text-sm font-semibold text-primary-foreground disabled:opacity-50" disabled="@Retrying" @onclick="OnRetry">
        @(Retrying ? L["Market.Refreshing"] : L["Common.Retry"])
    </button>
</div>

@code {
    [Parameter] public string ErrorKey { get; set; } = "Error.Market.Unavailable";
    [Parameter] public bool Retrying { get; set; }
    [Parameter] public EventCallback OnRetry { get; set; }
    private bool IsOffline => ErrorKey == "Error.Market.NoConnection";
}
