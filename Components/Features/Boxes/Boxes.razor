@page "/boxes"
@inject IDistributionBoxService DistributionBoxService
@inject IAreaService AreaService
@inject ICustomerService CustomerService
@inject IToastService Toast
@inject IStringLocalizer<SharedResource> L

<div class="space-y-4" @onclick="CloseMenu">
    <BoxesToolbar Search="@_searchTerm"
                  AreaFilter="@_areaFilter"
                  Areas="_areas"
                  Total="_totalCount"
                  Disabled="@(_loading || _areas.Count == 0)"
                  SearchChanged="OnSearchChangedAsync"
                  AreaFilterChanged="OnAreaFilterChangedAsync"
                  OnCreate="OpenCreate" />

    <BoxesList Boxes="_items"
               IsLoading="_loading"
               OpenMenuId="_menuBoxId"
               TotalCount="_totalCount"
               PageNumber="_pageNumber"
               TotalPages="_totalPages"
               PageSize="_pageSize"
               HasPrevious="_hasPrevious"
               HasNext="_hasNext"
               PageSizeChanged="OnPageSizeChangedAsync"
               OnPrevPage="PrevPageAsync"
               OnNextPage="NextPageAsync"
               OnToggleMenu="ToggleMenu"
               OnView="OpenDetails"
               OnEdit="OpenEdit"
               OnDelete="OpenDelete" />
</div>

<BoxDetailsSheet Open="_showDetails"
                 Box="_selected"
                 SubscribersPage="_subscribersPage"
                 SubscribersLoading="_subscribersLoading"
                 OnClose="CloseDetails"
                 OnSubscribersPageChanged="LoadSubscribersPageAsync" />

<BoxFormSheet Open="_showForm"
              IsEdit="@(_editingId is not null)"
              InitialName="@_formName"
              InitialAreaId="_formAreaId"
              InitialLocationNote="@_formLocationNote"
              InitialNotes="@_formNotes"
              Areas="_areas"
              Saving="_saving"
              OnClose="CloseForm"
              OnSave="SaveAsync" />

<DeleteBoxDialog Open="_showDelete"
                 Box="_pendingDelete"
                 Saving="_saving"
                 OnClose="CloseDelete"
                 OnConfirm="ConfirmDeleteAsync" />

@code {
    private readonly List<DistributionBoxResponse> _items = [];
    private readonly List<AreaResponse> _areas = [];
    private string _searchTerm = "";
    private string _areaFilter = "";
    private string _formName = "";
    private Guid _formAreaId;
    private string _formLocationNote = "";
    private string _formNotes = "";
    private bool _loading = true;
    private bool _saving;
    private bool _showForm;
    private bool _showDetails;
    private bool _showDelete;
    private Guid? _editingId;
    private Guid? _menuBoxId;
    private DistributionBoxResponse? _selected;
    private DistributionBoxResponse? _pendingDelete;

    private int _pageNumber = 1;
    private int _pageSize = 10;
    private int _totalPages = 1;
    private int _totalCount;
    private bool _hasPrevious;
    private bool _hasNext;

    private bool _subscribersLoading;
    private PagedResponse<CustomerSummaryResponse>? _subscribersPage;

    protected override async Task OnInitializedAsync()
    {
        await LoadAreasAsync();
        await LoadAsync();
    }

    private async Task LoadAreasAsync()
    {
        var areas = await UiActions.RunAsync(Toast, () => AreaService.GetAllAsync());
        _areas.Clear();
        if (areas is not null)
            _areas.AddRange(areas.OrderBy(a => a.Name));
    }

    private DistributionBoxFilterRequest BuildFilter() =>
        new(
            AreaId: Guid.TryParse(_areaFilter, out var areaId) ? areaId : null,
            Name: string.IsNullOrWhiteSpace(_searchTerm) ? null : _searchTerm.Trim(),
            PageNumber: _pageNumber,
            PageSize: _pageSize);

    private async Task LoadAsync()
    {
        _loading = true;
        _menuBoxId = null;

        var page = await UiActions.RunAsync(
            Toast,
            () => DistributionBoxService.GetAllAsync(BuildFilter()));

        _items.Clear();
        if (page is not null)
        {
            _items.AddRange(page.Data);
            _totalCount = page.TotalCount;
            _totalPages = Math.Max(1, page.TotalPages);
            _pageNumber = page.PageNumber;
            _hasPrevious = page.HasPreviousPage;
            _hasNext = page.HasNextPage;
        }
        else
        {
            _totalCount = 0;
            _totalPages = 1;
            _hasPrevious = false;
            _hasNext = false;
        }

        _loading = false;
    }

    private async Task ReloadFromFiltersAsync()
    {
        _pageNumber = 1;
        await LoadAsync();
    }

    private async Task OnSearchChangedAsync(string value)
    {
        _searchTerm = value;
        await ReloadFromFiltersAsync();
    }

    private async Task OnAreaFilterChangedAsync(string value)
    {
        _areaFilter = value;
        await ReloadFromFiltersAsync();
    }

    private async Task OnPageSizeChangedAsync(int size)
    {
        _pageSize = size;
        _pageNumber = 1;
        await LoadAsync();
    }

    private async Task PrevPageAsync()
    {
        if (!_hasPrevious) return;
        _pageNumber--;
        await LoadAsync();
    }

    private async Task NextPageAsync()
    {
        if (!_hasNext) return;
        _pageNumber++;
        await LoadAsync();
    }

    private void ToggleMenu(Guid id) => _menuBoxId = _menuBoxId == id ? null : id;
    private void CloseMenu() => _menuBoxId = null;

    private async Task OpenDetails(DistributionBoxResponse box)
    {
        CloseMenu();
        _selected = box;
        _showDetails = true;
        await LoadSubscribersPageAsync(1);
    }

    private void CloseDetails()
    {
        _showDetails = false;
        _selected = null;
        _subscribersPage = null;
    }

    private async Task LoadSubscribersPageAsync(int page)
    {
        if (_selected is null || page < 1) return;
        _subscribersLoading = true;
        _subscribersPage = await UiActions.RunAsync(
            Toast,
            () => CustomerService.GetAllAsync(new CustomerFilterRequest(
                BoxId: _selected.Id,
                PageNumber: page,
                PageSize: 10)));
        _subscribersLoading = false;
    }

    private void OpenCreate()
    {
        CloseMenu();
        if (_areas.Count == 0)
        {
            Toast.Error(L["Boxes.NeedArea"].Value);
            return;
        }

        _editingId = null;
        _formName = "";
        _formAreaId = _areas[0].Id;
        _formLocationNote = "";
        _formNotes = "";
        _showForm = true;
    }

    private void OpenEdit(DistributionBoxResponse box)
    {
        CloseMenu();
        _editingId = box.Id;
        _formName = box.Name;
        _formAreaId = box.AreaId;
        _formLocationNote = box.LocationNote ?? "";
        _formNotes = box.Notes ?? "";
        _showForm = true;
    }

    private void CloseForm()
    {
        if (_saving) return;
        _showForm = false;
        _editingId = null;
    }

    private void OpenDelete(DistributionBoxResponse box)
    {
        CloseMenu();
        _pendingDelete = box;
        _showDelete = true;
    }

    private void CloseDelete()
    {
        if (_saving) return;
        _showDelete = false;
        _pendingDelete = null;
    }

    private async Task SaveAsync(BoxFormSheet.BoxFormValues form)
    {
        if (_saving) return;

        if (form.AreaId == Guid.Empty)
        {
            Toast.Error(L["Boxes.SelectAreaRequired"].Value);
            return;
        }

        _saving = true;
        var location = string.IsNullOrWhiteSpace(form.LocationNote) ? null : form.LocationNote.Trim();
        var notes = string.IsNullOrWhiteSpace(form.Notes) ? null : form.Notes.Trim();

        var ok = false;
        if (_editingId is null)
        {
            var created = await UiActions.RunAsync(
                Toast,
                () => DistributionBoxService.CreateAsync(new CreateDistributionBoxRequest(
                    form.Name,
                    form.AreaId,
                    location,
                    notes)),
                L["Boxes.Created"].Value);
            ok = created is not null;
        }
        else
        {
            var updated = await UiActions.RunAsync(
                Toast,
                () => DistributionBoxService.UpdateAsync(_editingId.Value, new UpdateDistributionBoxRequest(
                    form.Name,
                    form.AreaId,
                    location,
                    notes)),
                L["Boxes.Updated"].Value);
            ok = updated is not null;
        }

        _saving = false;
        if (!ok) return;

        _showForm = false;
        _editingId = null;
        await LoadAsync();
    }

    private async Task ConfirmDeleteAsync()
    {
        if (_pendingDelete is null || _saving) return;
        _saving = true;

        await UiActions.RunAsync(
            Toast,
            () => DistributionBoxService.DeleteAsync(_pendingDelete.Id),
            L["Boxes.Deleted"].Value);

        _saving = false;
        _showDelete = false;
        if (_selected?.Id == _pendingDelete.Id)
            CloseDetails();
        _pendingDelete = null;
        await LoadAsync();
    }
}
