@namespace Shabakat.Components.Features.Boxes.Components
@inject IStringLocalizer<SharedResource> L
@inject NavigationManager Navigation

<SideSheet Open="Open"
           Title="@(Box?.Name ?? L["Common.ViewDetails"].Value)"
           Description="@L["Boxes.DetailsHint"]"
           MaxWidthClass="sm:max-w-xl"
           OnClose="OnClose">
    @if (Box is not null)
    {
        <div class="space-y-4">
            <div class="grid gap-4 md:grid-cols-2">
                <div class="rounded-2xl border border-border bg-card p-4">
                    <p class="text-xs uppercase tracking-[0.18em] text-muted-foreground">@L["Ampere.Subscribers"]</p>
                    <p class="mt-2 text-xl font-semibold text-foreground">
                        @(Box.CustomerCount == 1 ? L["Count.Subscribers", Box.CustomerCount] : L["Count.SubscribersPlural", Box.CustomerCount])
                    </p>
                </div>
                <div class="rounded-2xl border border-border bg-card p-4">
                    <p class="text-xs uppercase tracking-[0.18em] text-muted-foreground">@L["Common.Created"]</p>
                    <p class="mt-2 text-xl font-semibold text-foreground">@FormatHelper.Date(Box.CreatedAt)</p>
                </div>
            </div>

            <div class="space-y-4 rounded-2xl border border-border bg-card p-5">
                <div class="flex items-start justify-between gap-3">
                    <div class="space-y-4 min-w-0 flex-1">
                        <div class="flex items-start gap-3">
                            <div class="rounded-lg border border-border bg-muted/40 p-2 text-primary">
                                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16.5 9.4 7.55 4.24"/><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.29 7 12 12 20.71 7"/><line x1="12" y1="22" x2="12" y2="12"/></svg>
                            </div>
                            <div>
                                <p class="text-xs uppercase tracking-[0.18em] text-muted-foreground">@L["Boxes.BoxName"]</p>
                                <p class="mt-1 text-sm text-foreground">@Box.Name</p>
                            </div>
                        </div>
                        <div class="flex items-start gap-3">
                            <div class="rounded-lg border border-border bg-muted/40 p-2 text-primary">
                                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                            </div>
                            <div>
                                <p class="text-xs uppercase tracking-[0.18em] text-muted-foreground">@L["Common.Area"]</p>
                                <p class="mt-1 text-sm text-foreground">@Box.AreaName</p>
                            </div>
                        </div>
                        <div class="flex items-start gap-3">
                            <div class="rounded-lg border border-border bg-muted/40 p-2 text-primary">
                                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                            </div>
                            <div>
                                <p class="text-xs uppercase tracking-[0.18em] text-muted-foreground">@L["Boxes.LocationNote"]</p>
                                <p class="mt-1 text-sm text-foreground">@(string.IsNullOrWhiteSpace(Box.LocationNote) ? L["Common.NotSet"].Value : Box.LocationNote)</p>
                            </div>
                        </div>
                        <div class="flex items-start gap-3">
                            <div class="rounded-lg border border-border bg-muted/40 p-2 text-primary">
                                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
                            </div>
                            <div>
                                <p class="text-xs uppercase tracking-[0.18em] text-muted-foreground">@L["Common.Notes"]</p>
                                <p class="mt-1 text-sm text-foreground">@(string.IsNullOrWhiteSpace(Box.Notes) ? L["Common.NotSet"].Value : Box.Notes)</p>
                            </div>
                        </div>
                        <div class="flex items-start gap-3">
                            <div class="rounded-lg border border-border bg-muted/40 p-2 text-primary">
                                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
                            </div>
                            <div>
                                <p class="text-xs uppercase tracking-[0.18em] text-muted-foreground">@L["Boxes.AssignedSubscribers"]</p>
                                <p class="mt-1 text-sm text-foreground">@(Box.CustomerCount == 1 ? L["Count.Subscribers", Box.CustomerCount] : L["Count.SubscribersPlural", Box.CustomerCount])</p>
                            </div>
                        </div>
                        <div class="flex items-start gap-3">
                            <div class="rounded-lg border border-border bg-muted/40 p-2 text-primary">
                                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                            </div>
                            <div>
                                <p class="text-xs uppercase tracking-[0.18em] text-muted-foreground">@L["Common.CreatedAt"]</p>
                                <p class="mt-1 text-sm text-foreground">@FormatHelper.Date(Box.CreatedAt)</p>
                            </div>
                        </div>
                    </div>
                    <button type="button"
                            class="inline-flex shrink-0 items-center gap-2 rounded-xl border border-border bg-muted/40 px-3 py-2 text-sm font-medium text-foreground hover:bg-muted"
                            @onclick="NavigateToSubscribers">
                        <svg class="h-4 w-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3" /></svg>
                        @L["Areas.ViewSubscribers"]
                    </button>
                </div>
            </div>
        </div>
    }
    else
    {
        <p class="text-sm text-muted-foreground">@L["Boxes.SelectHint"]</p>
    }
</SideSheet>

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public DistributionBoxResponse? Box { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private void NavigateToSubscribers()
    {
        if (Box is null)
            return;

        Navigation.NavigateTo($"subscribers/{Box.AreaId}/{Box.Id}");
    }
}
