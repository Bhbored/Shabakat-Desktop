@namespace Shabakat.Components.Features.Boxes.Components

<SideSheet Open="Open"
           Title="@(Box?.Name ?? "View details")"
           Description="Review physical box metadata, area placement, and assigned subscribers."
           MaxWidthClass="sm:max-w-xl"
           OnClose="OnClose">
    @if (Box is not null)
    {
        <div class="space-y-4">
            <div class="grid gap-4 md:grid-cols-2">
                <div class="rounded-2xl border border-border bg-card p-4">
                    <p class="text-xs uppercase tracking-[0.18em] text-muted-foreground">Subscribers</p>
                    <p class="mt-2 text-xl font-semibold text-foreground">
                        @Box.CustomerCount subscriber@(Box.CustomerCount != 1 ? "s" : "")
                    </p>
                </div>
                <div class="rounded-2xl border border-border bg-card p-4">
                    <p class="text-xs uppercase tracking-[0.18em] text-muted-foreground">Created</p>
                    <p class="mt-2 text-xl font-semibold text-foreground">@FormatHelper.Date(Box.CreatedAt)</p>
                </div>
            </div>

            <div class="space-y-4 rounded-2xl border border-border bg-card p-5">
                <div class="flex items-start gap-3">
                    <div class="rounded-lg border border-border bg-muted/40 p-2 text-primary">
                        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16.5 9.4 7.55 4.24"/><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.29 7 12 12 20.71 7"/><line x1="12" y1="22" x2="12" y2="12"/></svg>
                    </div>
                    <div>
                        <p class="text-xs uppercase tracking-[0.18em] text-muted-foreground">Box Name</p>
                        <p class="mt-1 text-sm text-foreground">@Box.Name</p>
                    </div>
                </div>
                <div class="flex items-start gap-3">
                    <div class="rounded-lg border border-border bg-muted/40 p-2 text-primary">
                        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                    </div>
                    <div>
                        <p class="text-xs uppercase tracking-[0.18em] text-muted-foreground">Area</p>
                        <p class="mt-1 text-sm text-foreground">@Box.AreaName</p>
                    </div>
                </div>
                <div class="flex items-start gap-3">
                    <div class="rounded-lg border border-border bg-muted/40 p-2 text-primary">
                        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                    </div>
                    <div>
                        <p class="text-xs uppercase tracking-[0.18em] text-muted-foreground">Location Note</p>
                        <p class="mt-1 text-sm text-foreground">@(string.IsNullOrWhiteSpace(Box.LocationNote) ? "Not set" : Box.LocationNote)</p>
                    </div>
                </div>
                <div class="flex items-start gap-3">
                    <div class="rounded-lg border border-border bg-muted/40 p-2 text-primary">
                        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
                    </div>
                    <div>
                        <p class="text-xs uppercase tracking-[0.18em] text-muted-foreground">Notes</p>
                        <p class="mt-1 text-sm text-foreground">@(string.IsNullOrWhiteSpace(Box.Notes) ? "Not set" : Box.Notes)</p>
                    </div>
                </div>
                <div class="flex items-start gap-3">
                    <div class="rounded-lg border border-border bg-muted/40 p-2 text-primary">
                        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
                    </div>
                    <div>
                        <p class="text-xs uppercase tracking-[0.18em] text-muted-foreground">Assigned Subscribers</p>
                        <p class="mt-1 text-sm text-foreground">@Box.CustomerCount subscriber@(Box.CustomerCount != 1 ? "s" : "")</p>
                    </div>
                </div>
                <div class="flex items-start gap-3">
                    <div class="rounded-lg border border-border bg-muted/40 p-2 text-primary">
                        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                    </div>
                    <div>
                        <p class="text-xs uppercase tracking-[0.18em] text-muted-foreground">Created At</p>
                        <p class="mt-1 text-sm text-foreground">@FormatHelper.Date(Box.CreatedAt)</p>
                    </div>
                </div>
            </div>

            <div class="space-y-4 rounded-2xl border border-border bg-card p-5">
                <div class="flex items-start justify-between gap-3">
                    <div>
                        <h3 class="text-sm font-semibold uppercase tracking-[0.18em] text-muted-foreground">Assigned Subscribers</h3>
                        <p class="mt-2 text-sm text-muted-foreground">Subscribers currently wired to this physical box.</p>
                    </div>
                    <span class="rounded-full border border-border px-3 py-1 text-xs text-muted-foreground">
                        @(SubscribersPage?.TotalCount ?? 0) subscriber@((SubscribersPage?.TotalCount ?? 0) != 1 ? "s" : "")
                    </span>
                </div>

                @if (SubscribersLoading)
                {
                    <div class="space-y-3">
                        @for (var i = 0; i < 3; i++)
                        {
                            <div class="rounded-2xl border border-border bg-muted/30 p-4">
                                <div class="flex items-start gap-3">
                                    <SkeletonBone Class="h-8 w-8 rounded-full" />
                                    <div class="flex-1 space-y-2">
                                        <SkeletonBone Class="h-4 w-32 rounded" />
                                        <SkeletonBone Class="h-3 w-24 rounded" />
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else if (SubscribersPage is null || !SubscribersPage.Data.Any())
                {
                    <p class="text-sm text-muted-foreground">No subscribers are assigned to this box yet.</p>
                }
                else
                {
                    <div class="space-y-3">
                        @foreach (var sub in SubscribersPage.Data)
                        {
                            <div class="rounded-2xl border border-border bg-muted/20 p-4">
                                <div class="flex items-start justify-between gap-3">
                                    <div class="flex items-start gap-3">
                                        <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full text-xs font-semibold text-white"
                                             style="background-color: @FormatHelper.AvatarColor(sub.Name)">
                                            @FormatHelper.Initials(sub.Name)
                                        </div>
                                        <div class="space-y-2">
                                            <div>
                                                <p class="text-sm font-semibold text-foreground">@sub.Name</p>
                                                <p class="text-xs text-muted-foreground">@FormatPlan(sub.Plan) · @FormatHelper.Number(sub.PlanValue)</p>
                                            </div>
                                            <div class="flex flex-wrap items-center gap-2">
                                                <StatusBadge Status="@sub.CustomerStatus" />
                                                <span class="rounded-full border border-border px-2.5 py-1 text-xs text-muted-foreground">@FormatHelper.Date(sub.SubscriptionDate)</span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="text-right">
                                        <p class="text-xs uppercase tracking-[0.18em] text-muted-foreground">Amount due</p>
                                        <p class="mt-2 text-base font-semibold text-foreground">@FormatHelper.Currency(sub.AmountDue)</p>
                                    </div>
                                </div>
                                <div class="mt-4 flex items-center gap-2 text-sm text-muted-foreground">
                                    <svg class="h-4 w-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.81.36 1.6.7 2.34a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.74.34 1.53.57 2.34.7A2 2 0 0 1 22 16.92z"/></svg>
                                    <span class="font-mono">@(string.IsNullOrWhiteSpace(sub.Phone) ? "Not set" : sub.Phone)</span>
                                </div>
                            </div>
                        }
                    </div>
                }

                @if (SubscribersPage is { TotalPages: > 1 })
                {
                    <div class="flex flex-wrap items-center justify-between gap-3 border-t border-border pt-4">
                        <span class="text-sm text-muted-foreground">Page @SubscribersPage.PageNumber of @SubscribersPage.TotalPages</span>
                        <div class="flex gap-2">
                            <button type="button"
                                    class="rounded-xl border border-border px-3 py-2 text-sm text-foreground hover:bg-muted disabled:opacity-40"
                                    disabled="@(!SubscribersPage.HasPreviousPage || SubscribersLoading)"
                                    @onclick="() => OnSubscribersPageChanged.InvokeAsync(SubscribersPage.PageNumber - 1)">
                                Previous
                            </button>
                            <button type="button"
                                    class="rounded-xl border border-border px-3 py-2 text-sm text-foreground hover:bg-muted disabled:opacity-40"
                                    disabled="@(!SubscribersPage.HasNextPage || SubscribersLoading)"
                                    @onclick="() => OnSubscribersPageChanged.InvokeAsync(SubscribersPage.PageNumber + 1)">
                                Next
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        <p class="text-sm text-muted-foreground">Select a box to view its details.</p>
    }
</SideSheet>

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public DistributionBoxResponse? Box { get; set; }
    [Parameter] public PagedResponse<CustomerSummaryResponse>? SubscribersPage { get; set; }
    [Parameter] public bool SubscribersLoading { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<int> OnSubscribersPageChanged { get; set; }

    private static string FormatPlan(string plan) => plan switch
    {
        nameof(PlanType.Ampere) => "Ampere",
        nameof(PlanType.FixedKilowatt) => "Fixed kilowatt",
        nameof(PlanType.Kilowatt) => "Kilowatt",
        _ => plan
    };
}
