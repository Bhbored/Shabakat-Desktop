@namespace Shabakat.Components.Features.Boxes.Components

@if (IsLoading)
{
    <div class="grid gap-4 xl:grid-cols-2">
        @for (var i = 0; i < 4; i++)
        {
            <section class="rounded-2xl border border-border bg-card p-5">
                <div class="flex items-start gap-4">
                    <div class="h-10 w-10 animate-pulse rounded-full bg-muted"></div>
                    <div class="min-w-0 flex-1 space-y-4">
                        <div>
                            <div class="h-5 w-40 animate-pulse rounded bg-muted"></div>
                            <div class="mt-2 h-4 w-28 animate-pulse rounded bg-muted"></div>
                        </div>
                        <div class="flex flex-wrap gap-3">
                            <div class="h-7 w-28 animate-pulse rounded-full bg-muted"></div>
                            <div class="h-7 w-32 animate-pulse rounded-full bg-muted"></div>
                        </div>
                        <div class="grid gap-3 sm:grid-cols-2">
                            <div class="h-16 w-full animate-pulse rounded-xl bg-muted"></div>
                            <div class="h-16 w-full animate-pulse rounded-xl bg-muted"></div>
                        </div>
                    </div>
                    <div class="h-9 w-9 animate-pulse rounded-lg bg-muted"></div>
                </div>
            </section>
        }
    </div>
}
else if (Boxes.Count == 0)
{
    <section class="rounded-2xl border border-border bg-card px-4 py-10 text-sm text-muted-foreground">
        No distribution boxes matched the current filters.
    </section>
}
else
{
    <div class="grid gap-4 xl:grid-cols-2">
        @foreach (var box in Boxes)
        {
            <BoxCard Box="box"
                     MenuOpen="@(OpenMenuId == box.Id)"
                     OnToggleMenu="() => OnToggleMenu.InvokeAsync(box.Id)"
                     OnView="() => OnView.InvokeAsync(box)"
                     OnEdit="() => OnEdit.InvokeAsync(box)" />
        }
    </div>
}

@code {
    [Parameter] public IReadOnlyList<DistributionBoxResponse> Boxes { get; set; } = [];
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public Guid? OpenMenuId { get; set; }
    [Parameter] public EventCallback<Guid> OnToggleMenu { get; set; }
    [Parameter] public EventCallback<DistributionBoxResponse> OnView { get; set; }
    [Parameter] public EventCallback<DistributionBoxResponse> OnEdit { get; set; }
}
