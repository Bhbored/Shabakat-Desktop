@namespace Shabakat.Components.Features.Boxes.Components
@inject IStringLocalizer<SharedResource> L

<tr class="cursor-pointer border-b border-border transition-colors hover:bg-muted/30 @(MenuOpen ? "relative z-40" : null)"
    @onclick="OnView">
    <td class="px-4 py-3.5">
        <div class="flex items-center gap-3">
            <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full text-xs font-semibold text-white"
                 style="background-color: @FormatHelper.AvatarColor(Box.Name)">
                @FormatHelper.Initials(Box.Name)
            </div>
            <div class="min-w-0">
                <p class="whitespace-nowrap text-sm font-medium text-foreground">@Box.Name</p>
                @if (!string.IsNullOrWhiteSpace(Box.LocationNote))
                {
                    <p class="mt-0.5 truncate text-xs text-muted-foreground">@Box.LocationNote</p>
                }
            </div>
        </div>
    </td>
    <td class="px-4 py-3.5 text-sm text-foreground">
        @Box.AreaName
    </td>
    <td class="px-4 py-3.5 text-sm text-foreground">
        @(Box.CustomerCount == 1 ? L["Count.Subscribers", Box.CustomerCount] : L["Count.SubscribersPlural", Box.CustomerCount])
    </td>
    <td class="px-4 py-3.5 whitespace-nowrap text-sm text-muted-foreground">
        @FormatHelper.Date(Box.CreatedAt)
    </td>
    <td class="px-4 py-3.5">
        <div class="relative flex justify-end">
            <button type="button"
                    class="rounded-lg p-1 text-muted-foreground hover:text-foreground"
                    aria-label="@L["Common.MoreActions"]"
                    @onclick="OnToggleMenu"
                    @onclick:stopPropagation="true">
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="1"/><circle cx="19" cy="12" r="1"/><circle cx="5" cy="12" r="1"/></svg>
            </button>
            @if (MenuOpen)
            {
                <div class="absolute end-0 top-full z-30 mt-1 min-w-44 overflow-hidden rounded-xl border border-border bg-popover py-1 shadow-lg"
                     @onclick:stopPropagation="true">
                    <button type="button" class="flex w-full items-center gap-2 px-3 py-2 text-start text-sm text-foreground hover:bg-muted" @onclick="OnView">
                        <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                        @L["Common.ViewDetails"]
                    </button>
                    <button type="button" class="flex w-full items-center gap-2 px-3 py-2 text-start text-sm text-foreground hover:bg-muted" @onclick="OnEdit">
                        <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
                        @L["Common.Edit"]
                    </button>
                    @if (Box.CanBeDeleted)
                    {
                        <button type="button"
                                class="flex w-full items-center gap-2 px-3 py-2 text-start text-sm text-red-500 hover:bg-red-500/10"
                                @onclick="OnDelete">
                            <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                            @L["Common.Delete"]
                        </button>
                    }
                </div>
            }
        </div>
    </td>
</tr>

@code {
    [Parameter, EditorRequired] public DistributionBoxResponse Box { get; set; } = null!;
    [Parameter] public bool MenuOpen { get; set; }
    [Parameter] public EventCallback OnToggleMenu { get; set; }
    [Parameter] public EventCallback OnView { get; set; }
    [Parameter] public EventCallback OnEdit { get; set; }
    [Parameter] public EventCallback OnDelete { get; set; }
}
