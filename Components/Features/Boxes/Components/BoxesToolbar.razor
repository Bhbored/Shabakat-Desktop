@namespace Shabakat.Components.Features.Boxes.Components

<div class="space-y-4">
    <div class="flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between">
        <div class="flex flex-1 flex-col gap-3 sm:flex-row">
            <label class="min-w-60 flex-1">
                <span class="sr-only">Search boxes</span>
                <input type="text"
                       class="h-11 w-full rounded-xl border border-border bg-card px-4 text-sm text-foreground outline-none transition focus:border-primary"
                       placeholder="Search boxes by name, area, or notes..."
                       value="@Search"
                       @oninput="OnSearchInput" />
            </label>
            <label class="w-full sm:w-60">
                <span class="sr-only">Filter by area</span>
                <select class="h-11 w-full rounded-xl border border-border bg-card px-3 text-sm text-foreground"
                        value="@AreaFilter"
                        @onchange="OnAreaFilterChanged">
                    <option value="">All Areas</option>
                    @foreach (var area in Areas)
                    {
                        <option value="@area.Id">@area.Name</option>
                    }
                </select>
            </label>
        </div>
        <button type="button"
                class="rounded-xl bg-primary px-4 py-2.5 text-sm font-medium text-primary-foreground disabled:opacity-50"
                style="box-shadow: 0 0 16px rgba(245,192,0,0.25);"
                disabled="@Disabled"
                @onclick="HandleCreateAsync">
            + Add Box
        </button>
    </div>
    <p class="text-xs text-muted-foreground">
        @Total box@(Total != 1 ? "es" : "")
    </p>
</div>

@code {
    [Parameter] public string Search { get; set; } = "";
    [Parameter] public string AreaFilter { get; set; } = "";
    [Parameter] public IReadOnlyList<AreaResponse> Areas { get; set; } = [];
    [Parameter] public int Total { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback<string> SearchChanged { get; set; }
    [Parameter] public EventCallback<string> AreaFilterChanged { get; set; }
    [Parameter] public EventCallback OnCreate { get; set; }

    private async Task OnSearchInput(ChangeEventArgs e)
        => await SearchChanged.InvokeAsync(e.Value?.ToString() ?? "");

    private async Task OnAreaFilterChanged(ChangeEventArgs e)
        => await AreaFilterChanged.InvokeAsync(e.Value?.ToString() ?? "");

    private Task HandleCreateAsync() => OnCreate.InvokeAsync();
}
