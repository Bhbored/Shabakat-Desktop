@namespace Shabakat.Components.Features.Boxes.Components
@inject IStringLocalizer<SharedResource> L

<ConfirmDialog Open="Open" Title="@L["Boxes.DeleteTitle"]" OnClose="OnClose">
    <ChildContent>
        @if (Box is not null)
        {
            <p>
                @L["Boxes.DeleteConfirm", Box.Name]
            </p>
        }
    </ChildContent>
    <Footer>
        <button type="button"
                class="rounded-xl border border-border px-4 py-2.5 text-sm font-medium text-foreground hover:bg-muted"
                disabled="@Saving"
                @onclick="OnClose">
            @L["Common.Cancel"]
        </button>
        <button type="button"
                class="rounded-xl bg-red-500 px-4 py-2.5 text-sm font-medium text-white hover:bg-red-500/90 disabled:opacity-50"
                disabled="@Saving"
                @onclick="OnConfirm">
            @(Saving ? L["Common.Deleting"] : L["Common.Delete"])
        </button>
    </Footer>
</ConfirmDialog>

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public DistributionBoxResponse? Box { get; set; }
    [Parameter] public bool Saving { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnConfirm { get; set; }
}
