@page "/settings/excel-export"
@inject ICustomerExportService ExportService
@inject IToastService Toast
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResource> L

<SettingsScaffold Title="@L["Page.SettingsExcelExport.Title"]">
    <p class="mb-5 text-sm text-muted-foreground">@L["Page.SettingsExcelExport.Subtitle"]</p>
    @if (_loading)
    {
        <p class="text-sm text-muted-foreground">@L["Settings.LoadingExport"]</p>
    }
    else
    {
        <div class="divide-y divide-border overflow-hidden rounded-2xl border border-border">
            @foreach (var column in CustomerExportColumns.All)
            {
                var selected = _selected.Contains(column);
                var disableOff = selected && _selected.Count == 1;
                <label class="flex cursor-pointer items-center gap-3 px-4 py-3">
                    <span class="flex-1 text-sm font-medium text-foreground">@ColumnHeader(column)</span>
                    <span class="relative inline-flex cursor-pointer items-center @(disableOff ? "opacity-50" : "")">
                        <input type="checkbox" class="peer sr-only" checked="@selected" disabled="@disableOff"
                            @onchange="e => Toggle(column, e.Value is true)" />
                        <span
                            class="h-6 w-11 rounded-full bg-muted transition peer-checked:bg-primary after:absolute after:start-[2px] after:top-[2px] after:h-5 after:w-5 after:rounded-full after:border after:border-border after:bg-card after:transition-all peer-checked:after:translate-x-full"></span>
                    </span>
                </label>
            }
        </div>
        <button type="button"
            class="mt-6 w-full rounded-2xl bg-secondary px-4 py-3 text-sm font-semibold text-foreground transition hover:bg-secondary/80 disabled:opacity-50"
            disabled="@_saving"
            @onclick="SaveAsync">
            @(_saving ? L["Common.Saving"] : L["Common.Save"])
        </button>
    }
</SettingsScaffold>

@code {
    private readonly HashSet<CustomerExportColumn> _selected = [];
    private bool _loading = true;
    private bool _saving;

    protected override async Task OnInitializedAsync()
    {
        var columns = await UiActions.RunAsync(Toast, () => ExportService.GetSelectedColumnsAsync());
        foreach (var column in columns ?? CustomerExportColumns.Default)
            _selected.Add(column);
        _loading = false;
    }

    private void Toggle(CustomerExportColumn column, bool enabled)
    {
        if (enabled)
            _selected.Add(column);
        else if (_selected.Count > 1)
            _selected.Remove(column);
    }

    private string ColumnHeader(CustomerExportColumn column) => column switch
    {
        CustomerExportColumn.Name => L["Common.Name"].Value,
        CustomerExportColumn.Phone => L["Common.Phone"].Value,
        CustomerExportColumn.Address => L["Common.Address"].Value,
        CustomerExportColumn.Building => L["Common.Building"].Value,
        CustomerExportColumn.Floor => L["Common.Floor"].Value,
        CustomerExportColumn.CableName => L["Field.CableName"].Value,
        CustomerExportColumn.AreaName => L["Common.Area"].Value,
        CustomerExportColumn.BoxName => L["Field.Box"].Value,
        CustomerExportColumn.AmpereScheduleName => L["Field.AmpereSchedule"].Value,
        CustomerExportColumn.CustomerType => L["Field.CustomerType"].Value,
        CustomerExportColumn.Plan => L["Common.Plan"].Value,
        CustomerExportColumn.PlanValue => L["Field.PlanValue"].Value,
        CustomerExportColumn.SubscriptionDate => L["Field.SubscriptionDate"].Value,
        CustomerExportColumn.CustomerStatus => L["Common.Status"].Value,
        CustomerExportColumn.CustomerRelation => L["Field.Relation"].Value,
        CustomerExportColumn.InitialMeterReading => L["Field.InitialReading"].Value,
        CustomerExportColumn.LatestMeterReading => L["Field.LatestReading"].Value,
        CustomerExportColumn.TotalBilled => L["Subscribers.TotalBilled"].Value,
        CustomerExportColumn.TotalPaid => L["Subscribers.TotalPaid"].Value,
        CustomerExportColumn.TotalToPay => L["Field.TotalToPay"].Value,
        _ => column.ToString()
    };

    private async Task SaveAsync()
    {
        _saving = true;
        var ok = false;
        await UiActions.RunAsync(Toast, async () =>
        {
            await ExportService.SaveSelectedColumnsAsync(_selected);
            ok = true;
        }, L["Settings.ExportColumnsSaved"].Value);
        _saving = false;
        if (ok) Navigation.NavigateTo("settings");
    }
}
