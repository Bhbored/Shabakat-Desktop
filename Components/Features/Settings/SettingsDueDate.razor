@page "/settings/due-date"
@inject IAppPreferencesService PreferencesService
@inject IToastService Toast
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResource> L

<SettingsScaffold Title="@L["Page.SettingsDueDate.Title"]">
    <div class="space-y-4">
        @if (_loading)
        {
            <p class="text-sm text-muted-foreground">@L["Settings.LoadingPrefs"]</p>
        }
        else
        {
            <label class="space-y-2 block">
                <span class="block text-xs font-medium uppercase tracking-[0.18em] text-muted-foreground">@L["Settings.DayOfMonthLabel"]</span>
                <input type="number" min="1" max="31"
                       class="w-full rounded-2xl border border-border bg-background px-4 py-3 text-sm text-foreground outline-none focus:border-primary"
                       @bind="_dueDate" />
            </label>
            <p class="text-sm leading-6 text-muted-foreground">@L["Settings.DueDateHint"]</p>
            <button type="button"
                    class="w-full rounded-2xl bg-secondary px-4 py-3 text-sm font-semibold text-foreground transition hover:bg-secondary/80 disabled:opacity-50"
                    disabled="@_saving"
                    @onclick="SaveAsync">
                @(_saving ? L["Common.Saving"] : L["Common.Save"])
            </button>
        }
    </div>
</SettingsScaffold>

@code {
    private bool _loading = true;
    private bool _saving;
    private GetPreferencesResponse? _existing;
    private int _dueDate = 31;

    protected override async Task OnInitializedAsync()
    {
        _existing = await UiActions.RunAsync(Toast, () => PreferencesService.GetAsync());
        _dueDate = _existing.FromExistingOrDefaults().DueDate;
        _loading = false;
    }

    private async Task SaveAsync()
    {
        _saving = true;
        var request = _existing.FromExistingOrDefaults() with { DueDate = _dueDate };
        var ok = false;
        await UiActions.RunAsync(Toast, async () =>
        {
            await PreferencesService.UpsertAsync(request);
            ok = true;
        }, L["Settings.PreferencesSaved"].Value);
        _saving = false;
        if (ok) Navigation.NavigateTo("settings");
    }
}
