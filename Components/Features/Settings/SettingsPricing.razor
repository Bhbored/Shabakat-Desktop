@page "/settings/pricing/{Field}"
@inject IAppPreferencesService PreferencesService
@inject IToastService Toast
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResource> L

<SettingsScaffold Title="@L[_titleKey]">
    <div class="space-y-4">
        @if (_loading)
        {
            <p class="text-sm text-muted-foreground">@L["Settings.LoadingPrefs"]</p>
        }
        else if (_fieldKey is null)
        {
            <p class="text-sm text-muted-foreground">@L["Settings.UnknownPricingField"]</p>
        }
        else
        {
            <div class="grid gap-3 sm:grid-cols-[180px_1fr]">
                <label class="space-y-1 block">
                    <span class="block text-xs font-medium uppercase tracking-[0.18em] text-muted-foreground">@L["Field.CustomerType"]</span>
                    <select class="w-full rounded-2xl border border-border bg-background px-4 py-3 text-sm text-foreground outline-none focus:border-primary"
                            @bind="_tier"
                            @bind:after="LoadValueForTier">
                        <option value="base">@L["Settings.Base"]</option>
                        <option value="residential">@L["CustomerType.Residential"]</option>
                        <option value="commercial">@L["CustomerType.Commercial"]</option>
                        <option value="industrial">@L["CustomerType.Industrial"]</option>
                    </select>
                </label>
                <label class="space-y-1 block">
                    <span class="block text-xs font-medium uppercase tracking-[0.18em] text-muted-foreground">@(_isTva ? L["Settings.ValuePercent"] : L["Settings.Value"])</span>
                    <input type="number" step="0.01"
                           class="w-full rounded-2xl border border-border bg-background px-4 py-3 text-sm text-foreground outline-none focus:border-primary"
                           @bind="_value" />
                </label>
            </div>
            <p class="max-w-md text-sm leading-6 text-muted-foreground">
                @L["Settings.PricingHint"]
            </p>
            <div class="pt-6">
                <button type="button"
                        class="w-full rounded-2xl bg-secondary px-4 py-3 text-sm font-semibold text-foreground transition hover:bg-secondary/80 disabled:opacity-50"
                        disabled="@_saving"
                        @onclick="SaveAsync">
                    @(_saving ? L["Common.Saving"] : L["Common.Save"])
                </button>
            </div>
        }
    </div>
</SettingsScaffold>

@code {
    [Parameter] public string Field { get; set; } = "";

    private bool _loading = true;
    private bool _saving;
    private GetPreferencesResponse? _existing;
    private string? _fieldKey;
    private string _titleKey = "Page.Settings.Title";
    private string _tier = "base";
    private decimal _value;
    private bool _isTva;

    protected override async Task OnParametersSetAsync()
    {
        _fieldKey = Field?.Trim().ToLowerInvariant() switch
        {
            "price-per-kilowatt" => "pricePerKilowat",
            "price-per-amp" => "pricePerAmp",
            "fixed-charge" => "fixedCharge",
            "tva" => "tva",
            _ => null
        };

        _titleKey = Field?.Trim().ToLowerInvariant() switch
        {
            "price-per-kilowatt" => "Page.SettingsPricePerKw.Title",
            "price-per-amp" => "Page.SettingsPricePerAmp.Title",
            "fixed-charge" => "Page.SettingsFixedCharge.Title",
            "tva" => "Page.SettingsTva.Title",
            _ => "Page.Settings.Title"
        };
        _isTva = _fieldKey == "tva";

        if (_fieldKey is null)
        {
            Navigation.NavigateTo("settings");
            return;
        }

        _loading = true;
        _existing = await UiActions.RunAsync(Toast, () => PreferencesService.GetAsync());
        LoadValueForTier();
        _loading = false;
    }

    private void LoadValueForTier()
    {
        var src = _existing.FromExistingOrDefaults();
        _value = (_fieldKey, _tier) switch
        {
            ("pricePerKilowat", "residential") => src.ResidentialPricePerKilowat,
            ("pricePerKilowat", "commercial") => src.CommercialPricePerKilowat,
            ("pricePerKilowat", "industrial") => src.IndustrialPricePerKilowat,
            ("pricePerKilowat", _) => src.PricePerKilowat,

            ("pricePerAmp", "residential") => src.ResidentialPricePerAmp,
            ("pricePerAmp", "commercial") => src.CommercialPricePerAmp,
            ("pricePerAmp", "industrial") => src.IndustrialPricePerAmp,
            ("pricePerAmp", _) => src.PricePerAmp,

            ("fixedCharge", "residential") => src.ResidentialFixedCharge,
            ("fixedCharge", "commercial") => src.CommercialFixedCharge,
            ("fixedCharge", "industrial") => src.IndustrialFixedCharge,
            ("fixedCharge", _) => src.FixedCharge,

            ("tva", "residential") => src.ResidentialTVA,
            ("tva", "commercial") => src.CommercialTVA,
            ("tva", "industrial") => src.IndustrialTVA,
            ("tva", _) => src.TVA,

            _ => 0
        };
    }

    private async Task SaveAsync()
    {
        _saving = true;
        var baseReq = _existing.FromExistingOrDefaults();
        var request = (_fieldKey, _tier) switch
        {
            ("pricePerKilowat", "residential") => baseReq with { ResidentialPricePerKilowat = _value },
            ("pricePerKilowat", "commercial") => baseReq with { CommercialPricePerKilowat = _value },
            ("pricePerKilowat", "industrial") => baseReq with { IndustrialPricePerKilowat = _value },
            ("pricePerKilowat", _) => baseReq with { PricePerKilowat = _value },

            ("pricePerAmp", "residential") => baseReq with { ResidentialPricePerAmp = _value },
            ("pricePerAmp", "commercial") => baseReq with { CommercialPricePerAmp = _value },
            ("pricePerAmp", "industrial") => baseReq with { IndustrialPricePerAmp = _value },
            ("pricePerAmp", _) => baseReq with { PricePerAmp = _value },

            ("fixedCharge", "residential") => baseReq with { ResidentialFixedCharge = _value },
            ("fixedCharge", "commercial") => baseReq with { CommercialFixedCharge = _value },
            ("fixedCharge", "industrial") => baseReq with { IndustrialFixedCharge = _value },
            ("fixedCharge", _) => baseReq with { FixedCharge = _value },

            ("tva", "residential") => baseReq with { ResidentialTVA = _value },
            ("tva", "commercial") => baseReq with { CommercialTVA = _value },
            ("tva", "industrial") => baseReq with { IndustrialTVA = _value },
            ("tva", _) => baseReq with { TVA = _value },

            _ => baseReq
        };

        var ok = false;
        await UiActions.RunAsync(Toast, async () =>
        {
            await PreferencesService.UpsertAsync(request);
            ok = true;
        }, L["Settings.PreferencesSaved"].Value);
        _saving = false;
        if (ok) Navigation.NavigateTo("settings");
    }
}
