@page "/settings/company-logo"
@inject IAppUserService AppUserService
@inject IToastService Toast
@inject NavigationManager Navigation

<SettingsScaffold Title="Company Logo">
    <div class="space-y-5">
        @if (_loading)
        {
            <p class="text-sm text-muted-foreground">Loading profile...</p>
        }
        else
        {
            <div class="rounded-3xl border border-border bg-background/70 p-4">
                <p class="text-sm font-medium text-foreground">Current Logo</p>
                <div class="mt-4 flex min-h-52 items-center justify-center rounded-2xl border border-dashed border-border bg-card p-4">
                    @if (!string.IsNullOrWhiteSpace(_logoUrl))
                    {
                        <p class="max-w-full break-all text-center text-sm text-muted-foreground">@_logoUrl</p>
                    }
                    else
                    {
                        <div class="flex h-24 w-24 items-center justify-center rounded-3xl bg-primary/10 text-3xl font-semibold text-primary">
                            @Initial
                        </div>
                    }
                </div>
                <p class="mt-3 text-xs text-muted-foreground">Local file path only — no cloud upload in this offline build.</p>
            </div>

            <div class="space-y-4">
                <label class="space-y-2 block">
                    <span class="block text-xs font-medium uppercase tracking-[0.18em] text-muted-foreground">Full name</span>
                    <input type="text" maxlength="200"
                           class="w-full rounded-2xl border border-border bg-background px-4 py-3 text-sm text-foreground outline-none focus:border-primary"
                           @bind="_fullName" />
                </label>
                <label class="space-y-2 block">
                    <span class="block text-xs font-medium uppercase tracking-[0.18em] text-muted-foreground">Username</span>
                    <input type="text" maxlength="100"
                           class="w-full rounded-2xl border border-border bg-background px-4 py-3 text-sm text-foreground outline-none focus:border-primary"
                           @bind="_username" />
                </label>
                <label class="space-y-2 block">
                    <span class="block text-xs font-medium uppercase tracking-[0.18em] text-muted-foreground">Business name</span>
                    <input type="text" maxlength="200"
                           class="w-full rounded-2xl border border-border bg-background px-4 py-3 text-sm text-foreground outline-none focus:border-primary"
                           @bind="_businessName" />
                </label>
                <label class="space-y-2 block">
                    <span class="block text-xs font-medium uppercase tracking-[0.18em] text-muted-foreground">Logo path</span>
                    <input type="text" maxlength="500"
                           class="w-full rounded-2xl border border-border bg-background px-4 py-3 text-sm text-foreground outline-none focus:border-primary"
                           placeholder="C:\path\to\logo.png"
                           @bind="_logoUrl" />
                </label>
            </div>

            <button type="button"
                    class="w-full rounded-2xl bg-secondary px-4 py-3 text-sm font-semibold text-foreground transition hover:bg-secondary/80 disabled:opacity-50"
                    disabled="@_saving"
                    @onclick="SaveAsync">
                @(_saving ? "Saving..." : "Save")
            </button>
        }
    </div>
</SettingsScaffold>

@code {
    private bool _loading = true;
    private bool _saving;
    private string _fullName = "";
    private string _username = "";
    private string? _businessName;
    private string? _logoUrl;

    private string Initial =>
        !string.IsNullOrWhiteSpace(_businessName) ? _businessName[..1].ToUpperInvariant()
        : !string.IsNullOrWhiteSpace(_fullName) ? _fullName[..1].ToUpperInvariant()
        : "S";

    protected override async Task OnInitializedAsync()
    {
        var profile = await UiActions.RunAsync(Toast, () => AppUserService.GetAsync());
        if (profile is not null)
        {
            _fullName = profile.FullName;
            _username = profile.Username;
            _businessName = profile.BusinessName;
            _logoUrl = profile.LogoUrl;
        }

        _loading = false;
    }

    private async Task SaveAsync()
    {
        _saving = true;
        var ok = false;
        var result = await UiActions.RunAsync(
            Toast,
            () => AppUserService.UpsertAsync(new UpdateProfileRequest(
                _fullName,
                _username,
                string.IsNullOrWhiteSpace(_businessName) ? null : _businessName,
                string.IsNullOrWhiteSpace(_logoUrl) ? null : _logoUrl)),
            "Profile saved.");

        if (result is not null)
        {
            _fullName = result.FullName;
            _username = result.Username;
            _businessName = result.BusinessName;
            _logoUrl = result.LogoUrl;
            ok = true;
        }

        _saving = false;
        if (ok) Navigation.NavigateTo("settings");
    }
}
