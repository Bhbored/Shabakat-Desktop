@page "/settings/company-logo"
@inject IAppUserService AppUserService
@inject IToastService Toast
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResource> L

<SettingsScaffold Title="@L["Page.SettingsCompanyLogo.Title"]">
    <div class="space-y-5">
        @if (_loading)
        {
            <p class="text-sm text-muted-foreground">@L["Settings.LoadingProfile"]</p>
        }
        else
        {
            <div class="rounded-3xl border border-border bg-background/70 p-4">
                <p class="text-sm font-medium text-foreground">@L["Settings.CurrentLogo"]</p>
                <div class="mt-4 flex min-h-52 items-center justify-center rounded-2xl border border-dashed border-border bg-card p-4">
                    @if (!string.IsNullOrWhiteSpace(_previewSrc))
                    {
                        <img src="@_previewSrc" alt="@L["Settings.CompanyLogoAlt"]"
                             class="max-h-48 max-w-full object-contain" />
                    }
                    else
                    {
                        <div class="flex h-24 w-24 items-center justify-center rounded-3xl bg-primary/10 text-3xl font-semibold text-primary">
                            @Initial
                        </div>
                    }
                </div>
                <p class="mt-3 text-xs text-muted-foreground">
                    @L["Settings.LogoHint"]
                </p>
            </div>

            <div class="space-y-4">
                <label class="space-y-2 block">
                    <span class="block text-xs font-medium uppercase tracking-[0.18em] text-muted-foreground">@L["Settings.BusinessName"]</span>
                    <input type="text" maxlength="200"
                           class="w-full rounded-2xl border border-border bg-background px-4 py-3 text-sm text-foreground outline-none focus:border-primary"
                           @bind="_businessName" />
                </label>
                <button type="button"
                        class="w-full rounded-2xl border border-border bg-background px-4 py-3 text-sm font-semibold text-foreground transition hover:bg-muted disabled:opacity-50"
                        disabled="@(_saving || _picking)"
                        @onclick="PickLogoAsync">
                    @(_picking ? L["Settings.Opening"] : L["Settings.ChooseImage"])
                </button>
            </div>

            <button type="button"
                    class="w-full rounded-2xl bg-secondary px-4 py-3 text-sm font-semibold text-foreground transition hover:bg-secondary/80 disabled:opacity-50"
                    disabled="@_saving"
                    @onclick="SaveAsync">
                @(_saving ? L["Common.Saving"] : L["Common.Save"])
            </button>
        }
    </div>
</SettingsScaffold>

@code {
    private bool _loading = true;
    private bool _saving;
    private bool _picking;
    private string? _businessName;
    private string? _logoUrl;
    private string? _pickedSourcePath;
    private string? _previewSrc;

    private string Initial =>
        !string.IsNullOrWhiteSpace(_businessName) ? _businessName[..1].ToUpperInvariant() : "S";

    protected override async Task OnInitializedAsync()
    {
        var profile = await UiActions.RunAsync(Toast, () => AppUserService.GetAsync());
        if (profile is not null)
        {
            _businessName = profile.BusinessName;
            _logoUrl = profile.LogoUrl;
            _previewSrc = CompanyLogoStore.ToDataUri(_logoUrl);
        }

        _loading = false;
    }

    private async Task PickLogoAsync()
    {
        _picking = true;
        var picked = await CompanyLogoStore.PickAsync();
        if (!string.IsNullOrWhiteSpace(picked))
        {
            _pickedSourcePath = picked;
            _previewSrc = CompanyLogoStore.ToDataUri(picked);
        }

        _picking = false;
    }

    private async Task SaveAsync()
    {
        _saving = true;
        var ok = false;
        var result = await UiActions.RunAsync(
            Toast,
            async () =>
            {
                var logoPath = _logoUrl;
                if (!string.IsNullOrWhiteSpace(_pickedSourcePath))
                    logoPath = CompanyLogoStore.Replace(_pickedSourcePath);

                return await AppUserService.UpsertAsync(new UpdateProfileRequest(
                    string.IsNullOrWhiteSpace(_businessName) ? null : _businessName,
                    logoPath));
            },
            L["Settings.ProfileSaved"].Value);

        if (result is not null)
        {
            _businessName = result.BusinessName;
            _logoUrl = result.LogoUrl;
            _pickedSourcePath = null;
            _previewSrc = CompanyLogoStore.ToDataUri(_logoUrl);
            ok = true;
        }

        _saving = false;
        if (ok) Navigation.NavigateTo("settings");
    }
}
