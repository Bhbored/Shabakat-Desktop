@page "/settings/testing"
@inject IDatabaseSeedService SeedService
@inject IToastService Toast
@inject IStringLocalizer<SharedResource> L

<SettingsScaffold Title="@L["Page.SettingsTesting.Title"]">
    <div class="space-y-5">
        <div>
            <p class="text-sm font-medium text-foreground">@L["Settings.Testing.Title"]</p>
            <p class="mt-1 text-xs text-muted-foreground">
                @L["Settings.Testing.Hint"]
            </p>
        </div>

        @if (_alreadySeeded && !_seeding)
        {
            <p class="rounded-2xl border border-border bg-muted/40 px-4 py-3 text-sm text-muted-foreground">
                @L["Settings.Testing.Already"]
            </p>
        }

        @if (_seeding || _progress > 0)
        {
            <div class="space-y-2">
                <div class="flex items-center justify-between text-xs text-muted-foreground">
                    <span>@(_seeding ? L["Settings.Testing.Seeding"] : L["Common.Done"])</span>
                    <span>@((_progress * 100).ToString("0"))%</span>
                </div>
                <div class="h-2.5 overflow-hidden rounded-full bg-muted">
                    <div class="h-full rounded-full bg-primary transition-[width] duration-300"
                         style="width: @((_progress * 100).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%"></div>
                </div>
            </div>
        }

        <button type="button"
                class="w-full rounded-2xl bg-secondary px-4 py-3 text-sm font-semibold text-foreground transition hover:bg-secondary/80 disabled:opacity-50"
                disabled="@(_seeding || _alreadySeeded)"
                @onclick="SeedAsync">
            @(_seeding ? L["Settings.Testing.Seeding"] : _alreadySeeded ? L["Settings.Testing.AlreadySeeded"] : L["Settings.Testing.Seed"])
        </button>
    </div>
</SettingsScaffold>

@code {
    private bool _seeding;
    private bool _alreadySeeded;
    private double _progress;

    protected override async Task OnInitializedAsync()
    {
        _alreadySeeded = await SeedService.IsSeededAsync();
    }

    private async Task SeedAsync()
    {
        if (_seeding || _alreadySeeded)
            return;

        _seeding = true;
        _progress = 0;
        var ok = false;

        try
        {
            await foreach (var value in SeedService.SeedAsync())
            {
                _progress = value;
                await InvokeAsync(StateHasChanged);
            }

            _alreadySeeded = await SeedService.IsSeededAsync();
            ok = _alreadySeeded;
            if (ok)
                Toast.Success(L["Settings.Testing.Seeded"].Value);
        }
        catch (Exception ex)
        {
            Toast.Error(ex);
        }
        finally
        {
            _seeding = false;
            await InvokeAsync(StateHasChanged);
        }
    }
}
