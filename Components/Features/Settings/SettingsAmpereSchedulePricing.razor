@page "/settings/ampere-schedule-pricing"
@inject IAppPreferencesService PreferencesService
@inject IToastService Toast
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResource> L

<SettingsScaffold Title="@L["Page.SettingsAmpereSchedulePricing.Title"]">
    <div class="space-y-4">
        @if (_loading)
        {
            <p class="text-sm text-muted-foreground">@L["Settings.LoadingPrefs"]</p>
        }
        else
        {
            <div class="rounded-2xl border border-border bg-background px-4 py-4">
                <div class="flex items-center justify-between gap-4">
                    <div class="space-y-1">
                        <p class="text-sm font-medium text-foreground">@L["Settings.ScheduleBasedPricing"]</p>
                        <p class="text-sm text-muted-foreground">@L["Settings.ScheduleBasedHint"]</p>
                    </div>
                    <label class="relative inline-flex cursor-pointer items-center">
                        <input type="checkbox" class="peer sr-only" @bind="_enabled" />
                        <span class="h-6 w-11 rounded-full bg-muted transition peer-checked:bg-primary after:absolute after:start-[2px] after:top-[2px] after:h-5 after:w-5 after:rounded-full after:border after:border-border after:bg-card after:transition-all peer-checked:after:translate-x-full"></span>
                    </label>
                </div>
            </div>
            <p class="text-sm leading-6 text-muted-foreground">
                @L["Settings.ManageTiersPrefix"]
                <NavLink href="ampere-schedules" class="text-primary no-underline hover:underline">@L["Settings.AmpereSchedules"]</NavLink>
                @L["Settings.ManageTiersSuffix"]
            </p>
            <button type="button"
                    class="w-full rounded-2xl bg-secondary px-4 py-3 text-sm font-semibold text-foreground transition hover:bg-secondary/80 disabled:opacity-50"
                    disabled="@_saving"
                    @onclick="SaveAsync">
                @(_saving ? L["Common.Saving"] : L["Common.Save"])
            </button>
        }
    </div>
</SettingsScaffold>

@code {
    private bool _loading = true;
    private bool _saving;
    private GetPreferencesResponse? _existing;
    private bool _enabled;

    protected override async Task OnInitializedAsync()
    {
        _existing = await UiActions.RunAsync(Toast, () => PreferencesService.GetAsync());
        _enabled = _existing.FromExistingOrDefaults().AmpereSchedulePricingEnabled;
        _loading = false;
    }

    private async Task SaveAsync()
    {
        _saving = true;
        var request = _existing.FromExistingOrDefaults() with { AmpereSchedulePricingEnabled = _enabled };
        var ok = false;
        await UiActions.RunAsync(Toast, async () =>
        {
            await PreferencesService.UpsertAsync(request);
            ok = true;
        }, L["Settings.PreferencesSaved"].Value);
        _saving = false;
        if (ok) Navigation.NavigateTo("settings");
    }
}
