<NavLink href="@Href" class="flex items-center gap-3 border-b border-border px-4 py-4 no-underline transition-colors last:border-b-0 hover:bg-muted/40">
    <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-primary/10 text-primary">
        @((MarkupString)IconSvg)
    </div>
    <div class="min-w-0 flex-1">
        <p class="text-sm font-medium text-foreground">@Label</p>
        @if (!string.IsNullOrWhiteSpace(Value))
        {
            <p class="truncate text-xs text-muted-foreground">@Value</p>
        }
    </div>
    <svg class="h-4 w-4 shrink-0 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
</NavLink>

@code {
    [Parameter, EditorRequired] public string Href { get; set; } = "";
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public string? Value { get; set; }
    [Parameter] public string IconSvg { get; set; } = """<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/></svg>""";
}
