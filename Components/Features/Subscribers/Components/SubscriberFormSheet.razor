@namespace Shabakat.Components.Features.Subscribers.Components

<SideSheet Open="Open"
           Title="@(IsEdit ? "Edit Subscriber" : "Add Subscriber")"
           Description="@(IsEdit
               ? "Update subscriber information, plan, and optional custom pricing."
               : "Create a subscriber with plan, area, and optional custom pricing.")"
           MaxWidthClass="sm:max-w-2xl"
           OnClose="OnClose">
    <TitleIcon>
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" y1="8" x2="19" y2="14"/><line x1="22" y1="11" x2="16" y2="11"/></svg>
    </TitleIcon>
    <ChildContent>
        @if (Form is not null)
        {
            <div class="space-y-6">
                <div class="grid gap-4 md:grid-cols-2">
                    <div class="md:col-span-2">
                        <label class="mb-1.5 block text-sm font-medium text-foreground">Name</label>
                        <input class="@InputClass" placeholder="Mohammad Ali" @bind="Form.Name" />
                    </div>
                    <div>
                        <label class="mb-1.5 block text-sm font-medium text-foreground">Phone</label>
                        <input class="@InputClass" placeholder="03100004" type="tel" @bind="Form.Phone" />
                        <p class="mt-1.5 text-xs text-muted-foreground">Optional.</p>
                    </div>
                    @if (!IsEdit)
                    {
                        <div>
                            <label class="mb-1.5 block text-sm font-medium text-foreground">Subscription Date</label>
                            <input type="date" class="@InputClass" @bind="Form.SubscriptionDate" @bind:format="yyyy-MM-dd" />
                            <p class="mt-1.5 text-xs text-muted-foreground">Optional. Defaults to today if omitted.</p>
                        </div>
                    }
                    <div>
                        <label class="mb-1.5 block text-sm font-medium text-foreground">Customer Type</label>
                        <select class="@InputClass" @bind="Form.CustomerType">
                            @foreach (var t in Enum.GetValues<CustomerType>())
                            {
                                <option value="@t">@t</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="mb-1.5 block text-sm font-medium text-foreground">Plan Type</label>
                        <select class="@InputClass" @bind="Form.Plan" @bind:after="NotifyPlanChangedAsync">
                            @foreach (var p in Enum.GetValues<PlanType>())
                            {
                                <option value="@p">@FormatPlanLabel(p)</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="mb-1.5 block text-sm font-medium text-foreground">Plan Value</label>
                        <input type="number" step="0.01" min="0.01" class="@InputClass" placeholder="5" @bind="Form.PlanValue" />
                        <p class="mt-1.5 min-h-10 text-xs text-muted-foreground">@PlanValueHelp</p>
                    </div>
                    @if (Form.Plan == PlanType.Ampere && AmpereSchedulePricingEnabled)
                    {
                        <div>
                            <label class="mb-1.5 block text-sm font-medium text-foreground">Ampere Schedule</label>
                            <select class="@InputClass" @bind="Form.AmpereScheduleId">
                                <option value="">Select schedule</option>
                                @foreach (var s in Schedules)
                                {
                                    <option value="@s.Id">@s.Name</option>
                                }
                            </select>
                            <p class="mt-1.5 text-xs text-muted-foreground">
                                @(Schedules.Count > 0
                                    ? "Required for Ampere subscribers when schedule pricing is enabled."
                                    : "No schedules are available yet. Create one first, then assign it here.")
                            </p>
                        </div>
                    }
                    @if (ShowInitialMeterReading && Form.Plan is PlanType.Kilowatt or PlanType.FixedKilowatt)
                    {
                        <div>
                            <label class="mb-1.5 block text-sm font-medium text-foreground">Initial Meter Reading</label>
                            <input type="number" step="0.01" min="0" class="@InputClass" placeholder="0" @bind="Form.InitialMeterReading" />
                            <p class="mt-1.5 text-xs text-muted-foreground">The old meter reading value for this subscriber. Only relevant for Kilowatt and Fixed Kilowatt plans.</p>
                        </div>
                    }
                    <div>
                        <label class="mb-1.5 block text-sm font-medium text-foreground">Area</label>
                        <select class="@InputClass" @bind="Form.AreaId" @bind:after="NotifyAreaChangedAsync">
                            <option value="">Optional area</option>
                            @foreach (var area in Areas)
                            {
                                <option value="@area.Id">@area.Name</option>
                            }
                        </select>
                        <p class="mt-1.5 min-h-10 text-xs text-muted-foreground">Optional area assignment for grouping and filtering.</p>
                    </div>
                    <div>
                        <label class="mb-1.5 block text-sm font-medium text-foreground">Distribution Box</label>
                        <select class="@InputClass" disabled="@(!FilteredBoxes.Any())" @bind="Form.BoxId">
                            <option value="">No box</option>
                            @foreach (var box in FilteredBoxes)
                            {
                                <option value="@box.Id">@box.Name</option>
                            }
                        </select>
                        <p class="mt-1.5 min-h-10 text-xs text-muted-foreground">
                            @(FilteredBoxes.Any()
                                ? "Optional box assignment for tracking physical connections."
                                : "No distribution boxes are available yet. Create them first, then select one here.")
                        </p>
                    </div>
                    <div>
                        <label class="mb-1.5 block text-sm font-medium text-foreground">Building</label>
                        <input class="@InputClass" placeholder="Block B" @bind="Form.Building" />
                        <p class="mt-1.5 min-h-10 text-xs text-muted-foreground">Optional.</p>
                    </div>
                    <div>
                        <label class="mb-1.5 block text-sm font-medium text-foreground">Floor</label>
                        <input class="@InputClass" placeholder="3" @bind="Form.Floor" />
                        <p class="mt-1.5 min-h-10 text-xs text-muted-foreground">Optional.</p>
                    </div>
                    <div>
                        <label class="mb-1.5 block text-sm font-medium text-foreground">Relation</label>
                        <select class="@InputClass" @bind="Form.CustomerRelation">
                            <option value="">Optional relation</option>
                            @foreach (var r in Enum.GetValues<CustomerRelation>())
                            {
                                <option value="@r">@r</option>
                            }
                        </select>
                        <p class="mt-1.5 min-h-10 text-xs text-muted-foreground">Optional.</p>
                    </div>
                    <div>
                        <label class="mb-1.5 block text-sm font-medium text-foreground">Cable Name</label>
                        <input class="@InputClass" placeholder="C-12" @bind="Form.CableName" />
                        <p class="mt-1.5 min-h-10 text-xs text-muted-foreground">Optional.</p>
                    </div>
                    <div class="md:col-span-2">
                        <label class="mb-1.5 block text-sm font-medium text-foreground">Address</label>
                        <textarea class="@InputClass" rows="3" placeholder="Tripoli - Mina" @bind="Form.Address"></textarea>
                        <p class="mt-1.5 text-xs text-muted-foreground">Optional.</p>
                    </div>
                </div>

                <div class="rounded-2xl border border-border bg-card/70 p-4">
                    <label class="flex items-start gap-3">
                        <input type="checkbox" class="mt-1 rounded border-border" @bind="Form.UsePricingOverride" />
                        <span>
                            <span class="block text-sm font-medium text-foreground">Use pricing override</span>
                            <span class="mt-1 block text-xs text-muted-foreground">Override company pricing for this subscriber with a custom price, fixed charge, and TVA.</span>
                        </span>
                    </label>
                    @if (Form.UsePricingOverride)
                    {
                        <div class="mt-4 grid gap-4 md:grid-cols-3">
                            <div>
                                <label class="mb-1.5 block text-sm font-medium text-foreground">Override Price</label>
                                <input type="number" step="0.01" class="@InputClass" placeholder="50000" @bind="Form.OverridePrice" />
                            </div>
                            <div>
                                <label class="mb-1.5 block text-sm font-medium text-foreground">Fixed Charge</label>
                                <input type="number" step="0.01" class="@InputClass" placeholder="10000" @bind="Form.OverrideFixedCharge" />
                            </div>
                            <div>
                                <label class="mb-1.5 block text-sm font-medium text-foreground">TVA (%)</label>
                                <input type="number" step="0.01" class="@InputClass" placeholder="11" @bind="Form.OverrideTva" />
                            </div>
                        </div>
                    }
                </div>

                <div class="flex flex-wrap items-center justify-between gap-3 border-t border-border pt-5">
                    <p class="text-sm text-muted-foreground">Required fields are validated before submit.</p>
                    <div class="flex items-center gap-3">
                        <button type="button" class="rounded-xl border border-border px-4 py-2.5 text-sm font-medium text-foreground hover:bg-muted" @onclick="OnClose">Cancel</button>
                        <button type="button"
                                class="inline-flex items-center gap-2 rounded-xl bg-primary px-4 py-2.5 text-sm font-medium text-primary-foreground disabled:opacity-50"
                                disabled="@Saving"
                                @onclick="OnSave">
                            @if (Saving)
                            {
                                <svg class="h-4 w-4 animate-spin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 1 1-6.219-8.56" /></svg>
                            }
                            @(IsEdit ? "Save Changes" : "Create Subscriber")
                        </button>
                    </div>
                </div>
            </div>
        }
    </ChildContent>
</SideSheet>

@code {
    private const string InputClass = "w-full rounded-xl border border-border bg-background px-3 py-2.5 text-sm text-foreground outline-none focus:border-primary";

    [Parameter] public bool Open { get; set; }
    [Parameter] public bool IsEdit { get; set; }
    [Parameter] public bool Saving { get; set; }
    [Parameter] public bool AmpereSchedulePricingEnabled { get; set; }
    [Parameter] public bool ShowInitialMeterReading { get; set; }
    [Parameter] public SubscriberFormModel? Form { get; set; }
    [Parameter] public IReadOnlyList<AreaResponse> Areas { get; set; } = [];
    [Parameter] public IEnumerable<DistributionBoxResponse> FilteredBoxes { get; set; } = [];
    [Parameter] public IReadOnlyList<AmpereScheduleResponse> Schedules { get; set; } = [];
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnSave { get; set; }
    [Parameter] public EventCallback OnPlanChanged { get; set; }
    [Parameter] public EventCallback OnAreaChanged { get; set; }

    private string PlanValueHelp => Form?.Plan switch
    {
        PlanType.Ampere => "Used as the contracted ampere value for ampere billing.",
        PlanType.FixedKilowatt => "Used by prepaid counter billing and fixed-kilowatt top-up calculations.",
        _ => "Used by monthly meter billing calculations."
    };

    private Task NotifyPlanChangedAsync() => OnPlanChanged.InvokeAsync();
    private Task NotifyAreaChangedAsync() => OnAreaChanged.InvokeAsync();

    private static string FormatPlanLabel(PlanType plan) =>
        plan switch
        {
            PlanType.FixedKilowatt => "Fixed Kilowatt",
            _ => plan.ToString()
        };
}
