@namespace Shabakat.Components.Features.Subscribers.Components

<SideSheet Open="Open"
           Title="@(IsEdit ? "Edit Subscriber" : "Add Subscriber")"
           Description="Customer details, plan, and location"
           MaxWidthClass="sm:max-w-xl"
           OnClose="OnClose">
    <ChildContent>
        @if (Form is not null)
        {
            <div class="space-y-4">
                <div class="grid gap-4 md:grid-cols-2">
                    <div class="md:col-span-2">
                        <label class="mb-1.5 block text-xs font-medium uppercase tracking-[0.18em] text-muted-foreground">Name</label>
                        <input class="w-full rounded-xl border border-border bg-background px-3 py-2.5 text-sm outline-none focus:border-primary" @bind="Form.Name" />
                    </div>
                    <div>
                        <label class="mb-1.5 block text-xs font-medium uppercase tracking-[0.18em] text-muted-foreground">Phone</label>
                        <input class="w-full rounded-xl border border-border bg-background px-3 py-2.5 text-sm outline-none focus:border-primary" @bind="Form.Phone" />
                    </div>
                    @if (!IsEdit)
                    {
                        <div>
                            <label class="mb-1.5 block text-xs font-medium uppercase tracking-[0.18em] text-muted-foreground">Subscription Date</label>
                            <input type="date" class="w-full rounded-xl border border-border bg-background px-3 py-2.5 text-sm outline-none focus:border-primary" @bind="Form.SubscriptionDate" @bind:format="yyyy-MM-dd" />
                        </div>
                    }
                    <div>
                        <label class="mb-1.5 block text-xs font-medium uppercase tracking-[0.18em] text-muted-foreground">Customer Type</label>
                        <select class="w-full rounded-xl border border-border bg-background px-3 py-2.5 text-sm outline-none focus:border-primary" @bind="Form.CustomerType">
                            @foreach (var t in Enum.GetValues<CustomerType>())
                            {
                                <option value="@t">@t</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="mb-1.5 block text-xs font-medium uppercase tracking-[0.18em] text-muted-foreground">Plan</label>
                        <select class="w-full rounded-xl border border-border bg-background px-3 py-2.5 text-sm outline-none focus:border-primary" @bind="Form.Plan" @bind:after="NotifyPlanChangedAsync">
                            @foreach (var p in Enum.GetValues<PlanType>())
                            {
                                <option value="@p">@FormatPlanLabel(p)</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="mb-1.5 block text-xs font-medium uppercase tracking-[0.18em] text-muted-foreground">Plan Value</label>
                        <input type="number" step="0.01" min="0.01" class="w-full rounded-xl border border-border bg-background px-3 py-2.5 text-sm outline-none focus:border-primary" @bind="Form.PlanValue" />
                    </div>
                    @if (Form.Plan == PlanType.Ampere)
                    {
                        <div>
                            <label class="mb-1.5 block text-xs font-medium uppercase tracking-[0.18em] text-muted-foreground">Ampere Schedule</label>
                            <select class="w-full rounded-xl border border-border bg-background px-3 py-2.5 text-sm outline-none focus:border-primary" @bind="Form.AmpereScheduleId">
                                <option value="">Select schedule</option>
                                @foreach (var s in Schedules)
                                {
                                    <option value="@s.Id">@s.Name (@s.HoursPerDay h/day)</option>
                                }
                            </select>
                        </div>
                    }
                    @if (Form.Plan is PlanType.Kilowatt or PlanType.FixedKilowatt)
                    {
                        <div>
                            <label class="mb-1.5 block text-xs font-medium uppercase tracking-[0.18em] text-muted-foreground">Initial Meter Reading</label>
                            <input type="number" step="0.01" min="0" class="w-full rounded-xl border border-border bg-background px-3 py-2.5 text-sm outline-none focus:border-primary" @bind="Form.InitialMeterReading" />
                        </div>
                    }
                    <div>
                        <label class="mb-1.5 block text-xs font-medium uppercase tracking-[0.18em] text-muted-foreground">Area</label>
                        <select class="w-full rounded-xl border border-border bg-background px-3 py-2.5 text-sm outline-none focus:border-primary" @bind="Form.AreaId" @bind:after="NotifyAreaChangedAsync">
                            <option value="">Unassigned</option>
                            @foreach (var area in Areas)
                            {
                                <option value="@area.Id">@area.Name</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="mb-1.5 block text-xs font-medium uppercase tracking-[0.18em] text-muted-foreground">Distribution Box</label>
                        <select class="w-full rounded-xl border border-border bg-background px-3 py-2.5 text-sm outline-none focus:border-primary" @bind="Form.BoxId">
                            <option value="">None</option>
                            @foreach (var box in FilteredBoxes)
                            {
                                <option value="@box.Id">@box.Name</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="mb-1.5 block text-xs font-medium uppercase tracking-[0.18em] text-muted-foreground">Building</label>
                        <input class="w-full rounded-xl border border-border bg-background px-3 py-2.5 text-sm outline-none focus:border-primary" @bind="Form.Building" />
                    </div>
                    <div>
                        <label class="mb-1.5 block text-xs font-medium uppercase tracking-[0.18em] text-muted-foreground">Floor</label>
                        <input class="w-full rounded-xl border border-border bg-background px-3 py-2.5 text-sm outline-none focus:border-primary" @bind="Form.Floor" />
                    </div>
                    <div>
                        <label class="mb-1.5 block text-xs font-medium uppercase tracking-[0.18em] text-muted-foreground">Relation</label>
                        <select class="w-full rounded-xl border border-border bg-background px-3 py-2.5 text-sm outline-none focus:border-primary" @bind="Form.CustomerRelation">
                            <option value="">None</option>
                            @foreach (var r in Enum.GetValues<CustomerRelation>())
                            {
                                <option value="@r">@r</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="mb-1.5 block text-xs font-medium uppercase tracking-[0.18em] text-muted-foreground">Cable Name</label>
                        <input class="w-full rounded-xl border border-border bg-background px-3 py-2.5 text-sm outline-none focus:border-primary" @bind="Form.CableName" />
                    </div>
                    @if (IsEdit)
                    {
                        <div>
                            <label class="mb-1.5 block text-xs font-medium uppercase tracking-[0.18em] text-muted-foreground">Status</label>
                            <select class="w-full rounded-xl border border-border bg-background px-3 py-2.5 text-sm outline-none focus:border-primary" @bind="Form.CustomerStatus">
                                @foreach (var s in Enum.GetValues<CustomerStatus>())
                                {
                                    <option value="@s">@s</option>
                                }
                            </select>
                        </div>
                    }
                    <div class="md:col-span-2">
                        <label class="mb-1.5 block text-xs font-medium uppercase tracking-[0.18em] text-muted-foreground">Address</label>
                        <textarea class="w-full rounded-xl border border-border bg-background px-3 py-2.5 text-sm outline-none focus:border-primary" rows="2" @bind="Form.Address"></textarea>
                    </div>
                    <div class="md:col-span-2 rounded-2xl border border-border bg-muted/40 p-4">
                        <label class="flex items-center gap-2 text-sm font-medium text-foreground">
                            <input type="checkbox" class="rounded border-border" @bind="Form.UsePricingOverride" />
                            Pricing override
                        </label>
                        @if (Form.UsePricingOverride)
                        {
                            <div class="mt-3 grid gap-3 md:grid-cols-3">
                                <div>
                                    <label class="mb-1 block text-xs text-muted-foreground">Price</label>
                                    <input type="number" step="0.01" class="w-full rounded-xl border border-border bg-background px-3 py-2 text-sm" @bind="Form.OverridePrice" />
                                </div>
                                <div>
                                    <label class="mb-1 block text-xs text-muted-foreground">Fixed Charge</label>
                                    <input type="number" step="0.01" class="w-full rounded-xl border border-border bg-background px-3 py-2 text-sm" @bind="Form.OverrideFixedCharge" />
                                </div>
                                <div>
                                    <label class="mb-1 block text-xs text-muted-foreground">TVA %</label>
                                    <input type="number" step="0.01" class="w-full rounded-xl border border-border bg-background px-3 py-2 text-sm" @bind="Form.OverrideTva" />
                                </div>
                            </div>
                        }
                    </div>
                </div>
                <div class="flex justify-end gap-2 border-t border-border pt-5">
                    <button type="button" class="rounded-xl border border-border px-4 py-2.5 text-sm hover:bg-muted" @onclick="OnClose">Cancel</button>
                    <button type="button" class="rounded-xl bg-primary px-4 py-2.5 text-sm font-medium text-primary-foreground disabled:opacity-50" disabled="@Saving" @onclick="OnSave">
                        @(Saving ? "Saving..." : IsEdit ? "Save Changes" : "Create Subscriber")
                    </button>
                </div>
            </div>
        }
    </ChildContent>
</SideSheet>

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public bool IsEdit { get; set; }
    [Parameter] public bool Saving { get; set; }
    [Parameter] public SubscriberFormModel? Form { get; set; }
    [Parameter] public IReadOnlyList<AreaResponse> Areas { get; set; } = [];
    [Parameter] public IEnumerable<DistributionBoxResponse> FilteredBoxes { get; set; } = [];
    [Parameter] public IReadOnlyList<AmpereScheduleResponse> Schedules { get; set; } = [];
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnSave { get; set; }
    [Parameter] public EventCallback OnPlanChanged { get; set; }
    [Parameter] public EventCallback OnAreaChanged { get; set; }

    private Task NotifyPlanChangedAsync() => OnPlanChanged.InvokeAsync();
    private Task NotifyAreaChangedAsync() => OnAreaChanged.InvokeAsync();

    private static string FormatPlanLabel(PlanType plan) =>
        plan switch
        {
            PlanType.FixedKilowatt => "Fixed Kilowatt",
            _ => plan.ToString()
        };
}
