@namespace Shabakat.Components.Features.Subscribers.Components
@inject IStringLocalizer<SharedResource> L

@if (IsLoading)
{
    <TableSkeleton Columns="6" Rows="6" MinWidthClass="min-w-[860px]" />
}
else
{
    <section class="rounded-2xl border border-border bg-card">
        @if (Items.Count == 0)
        {
            <div class="px-4 py-10 text-sm text-muted-foreground">@L["Empty.Subscribers"]</div>
        }
        else
        {
            <table class="w-full min-w-[860px]">
                <thead>
                    <tr class="border-b border-border">
                        <th class="px-4 py-3.5 text-start text-xs font-semibold uppercase tracking-[0.18em] text-muted-foreground">@L["Common.Name"]</th>
                        <th class="px-4 py-3.5 text-start text-xs font-semibold uppercase tracking-[0.18em] text-muted-foreground">@L["Common.PhoneNumber"]</th>
                        <th class="px-4 py-3.5 text-start text-xs font-semibold uppercase tracking-[0.18em] text-muted-foreground">@L["Common.Area"]</th>
                        <th class="px-4 py-3.5 text-start text-xs font-semibold uppercase tracking-[0.18em] text-muted-foreground">@L["Common.Plan"]</th>
                        <th class="px-4 py-3.5 text-start text-xs font-semibold uppercase tracking-[0.18em] text-muted-foreground">@L["Common.Since"]</th>
                        <th class="px-4 py-3.5 text-start text-xs font-semibold uppercase tracking-[0.18em] text-muted-foreground">@L["Common.Status"]</th>
                        <th class="px-4 py-3.5 text-start text-xs font-semibold uppercase tracking-[0.18em] text-muted-foreground">@L["Table.AmountDue"]</th>
                        <th class="px-4 py-3.5"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var sub in Items)
                    {
                        <SubscriberCard Subscriber="sub"
                                        MenuOpen="@(OpenMenuId == sub.Id)"
                                        OnToggleMenu="() => OnToggleMenu.InvokeAsync(sub.Id)"
                                        OnView="() => OnView.InvokeAsync(sub)"
                                        OnEdit="() => OnEdit.InvokeAsync(sub)"
                                        OnSuspend="() => OnSuspend.InvokeAsync(sub)"
                                        OnActivate="() => OnActivate.InvokeAsync(sub)"
                                        OnTerminate="() => OnTerminate.InvokeAsync(sub)"
                                        OnDelete="() => OnDelete.InvokeAsync(sub)" />
                    }
                </tbody>
            </table>

            <div class="flex flex-col gap-3 border-t border-border px-4 py-3 text-sm text-muted-foreground md:flex-row md:items-center md:justify-between">
                <span>
                    @L["Pager.Showing", (PageNumber - 1) * PageSize + 1, Math.Min(PageNumber * PageSize, TotalCount), TotalCount]
                </span>
                <div class="flex items-center gap-2 self-end md:self-auto">
                    <select class="h-9 w-28 rounded-xl border border-border bg-card px-2 text-sm"
                            value="@PageSize"
                            @onchange="OnPageSizeChanged">
                        <option value="10">@L["Pager.PerPage", 10]</option>
                        <option value="20">@L["Pager.PerPage", 20]</option>
                        <option value="50">@L["Pager.PerPage", 50]</option>
                    </select>
                    <button type="button" class="rounded-xl border border-border px-3 py-1.5 text-sm disabled:opacity-40" disabled="@(!HasPrevious)" @onclick="OnPrevious">@L["Common.Previous"]</button>
                    <span class="min-w-24 text-center">@L["Pager.PageOf", PageNumber, Math.Max(1, TotalPages)]</span>
                    <button type="button" class="rounded-xl border border-border px-3 py-1.5 text-sm disabled:opacity-40" disabled="@(!HasNext)" @onclick="OnNext">@L["Common.Next"]</button>
                </div>
            </div>
        }
    </section>
}

@code {
    [Parameter] public IReadOnlyList<CustomerSummaryResponse> Items { get; set; } = [];
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public Guid? OpenMenuId { get; set; }
    [Parameter] public int PageNumber { get; set; } = 1;
    [Parameter] public int PageSize { get; set; } = 10;
    [Parameter] public int TotalCount { get; set; }
    [Parameter] public int TotalPages { get; set; }
    [Parameter] public bool HasPrevious { get; set; }
    [Parameter] public bool HasNext { get; set; }
    [Parameter] public EventCallback<Guid> OnToggleMenu { get; set; }
    [Parameter] public EventCallback<CustomerSummaryResponse> OnView { get; set; }
    [Parameter] public EventCallback<CustomerSummaryResponse> OnEdit { get; set; }
    [Parameter] public EventCallback<CustomerSummaryResponse> OnSuspend { get; set; }
    [Parameter] public EventCallback<CustomerSummaryResponse> OnActivate { get; set; }
    [Parameter] public EventCallback<CustomerSummaryResponse> OnTerminate { get; set; }
    [Parameter] public EventCallback<CustomerSummaryResponse> OnDelete { get; set; }
    [Parameter] public EventCallback<int> PageSizeChanged { get; set; }
    [Parameter] public EventCallback OnPrevious { get; set; }
    [Parameter] public EventCallback OnNext { get; set; }

    private async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var size)) return;
        await PageSizeChanged.InvokeAsync(size);
    }
}
