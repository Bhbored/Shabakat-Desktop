@namespace Shabakat.Components.Features.Subscribers.Components

<SideSheet Open="Open"
           Title="@(Details?.Name ?? "View details")"
           Description="Review account status, billing totals, subscriber metadata, and meter usage."
           MaxWidthClass="sm:max-w-xl"
           OnClose="OnClose">
    @if (IsLoading)
    {
        <p class="text-sm text-muted-foreground">Loading subscriber details...</p>
    }
    else if (Details is not null)
    {
        <div class="space-y-4">
            <div class="grid gap-4 md:grid-cols-3">
                <div class="rounded-2xl border border-border bg-card p-4">
                    <p class="text-xs uppercase tracking-[0.18em] text-muted-foreground">Total Billed</p>
                    <p class="mt-2 text-xl font-semibold text-foreground">@FormatHelper.Currency(Details.TotalBilled)</p>
                </div>
                <div class="rounded-2xl border border-border bg-card p-4">
                    <p class="text-xs uppercase tracking-[0.18em] text-muted-foreground">Total Paid</p>
                    <p class="mt-2 text-xl font-semibold text-foreground">@FormatHelper.Currency(Details.TotalPaid)</p>
                </div>
                <div class="rounded-2xl border border-border bg-card p-4">
                    <p class="text-xs uppercase tracking-[0.18em] text-muted-foreground">Outstanding</p>
                    <p class="mt-2 text-xl font-semibold text-foreground">@FormatHelper.Currency(Details.TotalOutstanding)</p>
                </div>
            </div>

            <div class="space-y-4 rounded-2xl border border-border bg-card p-5">
                <SubscriberDetailRow Label="Customer Type" Value="@Details.CustomerType">
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                </SubscriberDetailRow>
                <SubscriberDetailRow Label="Plan" Value="@($"{PlanLabel(Details.Plan)} · {FormatHelper.Number(Details.PlanValue)}")">
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
                </SubscriberDetailRow>
                <SubscriberDetailRow Label="Phone" Value="@(Details.Phone ?? "Not set")">
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.81.36 1.6.7 2.34a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.74.34 1.53.57 2.34.7A2 2 0 0 1 22 16.92z"/></svg>
                </SubscriberDetailRow>
                <SubscriberDetailRow Label="Area" Value="@(Details.AreaName ?? "Unassigned")">
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                </SubscriberDetailRow>
                <SubscriberDetailRow Label="Building" Value="@(Details.Building ?? "Not set")">
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                </SubscriberDetailRow>
                <SubscriberDetailRow Label="Floor" Value="@(Details.Floor ?? "Not set")">
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                </SubscriberDetailRow>
                <SubscriberDetailRow Label="Distribution Box" Value="@(Details.BoxName ?? "Not set")">
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                </SubscriberDetailRow>
                <SubscriberDetailRow Label="Cable Name" Value="@(Details.CableName ?? "Not set")">
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
                </SubscriberDetailRow>
                <SubscriberDetailRow Label="Ampere Schedule" Value="@(Details.AmpereScheduleName ?? "Not set")">
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m12 14 4-4"/><path d="M3.34 19a10 10 0 1 1 17.32 0"/></svg>
                </SubscriberDetailRow>
                <SubscriberDetailRow Label="Address" Value="@(Details.Address ?? "Not set")">
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                </SubscriberDetailRow>
                <SubscriberDetailRow Label="Subscribed" Value="@FormatHelper.Date(Details.SubscriptionDate)">
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                </SubscriberDetailRow>
                <SubscriberDetailRow Label="Created" Value="@FormatHelper.Date(Details.CreatedAt)">
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                </SubscriberDetailRow>
                <SubscriberDetailRow Label="Paid This Month" Value="@(Details.PaidThisMonth ? "Yes" : "No")">
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M16 8h-6a2 2 0 1 0 0 4h4a2 2 0 1 1 0 4H8"/><path d="M12 18V6"/></svg>
                </SubscriberDetailRow>
            </div>

            @if (Details.HasPricingOverride && Details.PricingOverride is not null)
            {
                <div class="space-y-4 rounded-2xl border border-border bg-card p-5">
                    <h3 class="text-sm font-semibold uppercase tracking-[0.18em] text-muted-foreground">Pricing Override</h3>
                    <SubscriberDetailRow Label="Override Price" Value="@FormatHelper.Currency(Details.PricingOverride.Price ?? 0)">
                        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M16 8h-6a2 2 0 1 0 0 4h4a2 2 0 1 1 0 4H8"/><path d="M12 18V6"/></svg>
                    </SubscriberDetailRow>
                    <SubscriberDetailRow Label="Fixed Charge" Value="@FormatHelper.Currency(Details.PricingOverride.FixedCharge ?? 0)">
                        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M16 8h-6a2 2 0 1 0 0 4h4a2 2 0 1 1 0 4H8"/><path d="M12 18V6"/></svg>
                    </SubscriberDetailRow>
                    <SubscriberDetailRow Label="TVA (%)" Value="@($"{FormatHelper.Number(Details.PricingOverride.TVA ?? 0)}%")">
                        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
                    </SubscriberDetailRow>
                </div>
            }

            @if (IsKilowatt)
            {
                <div class="space-y-4 rounded-2xl border border-border bg-card p-5">
                    <div class="flex flex-col gap-3 md:flex-row md:items-start md:justify-between">
                        <div>
                            <h3 class="text-sm font-semibold uppercase tracking-[0.18em] text-muted-foreground">Meter Readings</h3>
                            <p class="mt-2 text-sm text-muted-foreground">One reading per calendar month. Backend still enforces the final duplicate check.</p>
                        </div>
                        @if (ShowAddMeterButton)
                        {
                            <button type="button"
                                    class="rounded-xl bg-primary px-4 py-2.5 text-sm font-medium text-primary-foreground"
                                    @onclick="OnAddReading">
                                Add Meter Reading
                            </button>
                        }
                    </div>

                    @if (HasCurrentMonthReading && !IsOnlyInitialReading)
                    {
                        <p class="text-sm text-amber-500">This subscriber already has a reading saved this month.</p>
                    }

                    @if (MeterReadings.Count == 0)
                    {
                        <p class="text-sm text-muted-foreground">No meter readings recorded yet.</p>
                    }
                    else
                    {
                        <div class="space-y-3">
                            @foreach (var reading in MeterReadings)
                            {
                                <div class="flex items-start justify-between gap-4 rounded-2xl border border-border bg-muted/20 px-4 py-3">
                                    <div class="flex items-start gap-3">
                                        <div class="rounded-lg border border-border bg-muted/40 p-2 text-primary">
                                            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m12 14 4-4"/><path d="M3.34 19a10 10 0 1 1 17.32 0"/></svg>
                                        </div>
                                        <div>
                                            <p class="text-sm font-medium text-foreground">Reading @FormatHelper.Number(reading.ReadingValue)</p>
                                            <p class="mt-1 text-xs text-muted-foreground">Saved @FormatHelper.Date(reading.CreatedAt)</p>
                                        </div>
                                    </div>
                                    <div class="text-end">
                                        <p class="text-xs uppercase tracking-[0.18em] text-muted-foreground">Consumption</p>
                                        <p class="mt-1 font-mono text-sm font-semibold text-foreground">
                                            @(reading.Consumption is null ? "Not set" : $"{FormatHelper.Number(reading.Consumption.Value)} kWh")
                                        </p>
                                        <button type="button"
                                                class="mt-3 inline-flex items-center gap-1.5 rounded-xl border border-border px-3 py-1.5 text-sm text-foreground hover:bg-muted"
                                                @onclick="() => OnDeleteReading.InvokeAsync(reading)">
                                            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                                            Delete
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
            else if (IsFixedKilowatt)
            {
                <div class="space-y-3 rounded-2xl border border-border bg-card p-5">
                    <h3 class="text-sm font-semibold uppercase tracking-[0.18em] text-muted-foreground">Prepaid Counter</h3>
                    <p class="text-sm text-muted-foreground">
                        FixedKilowatt subscribers do not use the monthly meter-reading endpoint. Top-ups should be created from the invoice flow with payment amount and payment method.
                    </p>
                </div>
            }
            else
            {
                <div class="space-y-3 rounded-2xl border border-border bg-card p-5">
                    <h3 class="text-sm font-semibold uppercase tracking-[0.18em] text-muted-foreground">Meter Readings</h3>
                    <p class="text-sm text-muted-foreground">Ampere subscribers do not use meter readings.</p>
                </div>
            }
        </div>
    }
</SideSheet>

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public CustomerResponse? Details { get; set; }
    [Parameter] public IReadOnlyList<MeterReadingResponse> MeterReadings { get; set; } = [];
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnAddReading { get; set; }
    [Parameter] public EventCallback<MeterReadingResponse> OnDeleteReading { get; set; }

    private bool IsKilowatt =>
        Details?.Plan.Equals(nameof(PlanType.Kilowatt), StringComparison.OrdinalIgnoreCase) == true;

    private bool IsFixedKilowatt =>
        Details?.Plan.Equals(nameof(PlanType.FixedKilowatt), StringComparison.OrdinalIgnoreCase) == true;

    private bool HasCurrentMonthReading =>
        MeterReadings.Any(r => r.CreatedAt.Year == DateTime.Today.Year && r.CreatedAt.Month == DateTime.Today.Month);

    private bool IsOnlyInitialReading =>
        MeterReadings.Count == 1
        && Details?.InitialMeterReading is not null
        && MeterReadings[0].ReadingValue == Details.InitialMeterReading;

    private bool ShowAddMeterButton => !HasCurrentMonthReading || IsOnlyInitialReading;

    private static string PlanLabel(string plan) => plan switch
    {
        nameof(PlanType.Ampere) => "Ampere",
        nameof(PlanType.FixedKilowatt) => "Fixed Kilowatt",
        nameof(PlanType.Kilowatt) => "Kilowatt",
        _ => plan
    };
}
