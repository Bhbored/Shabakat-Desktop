@namespace Shabakat.Components.Features.Subscribers.Components
@inject IStringLocalizer<SharedResource> L

<tr class="cursor-pointer border-b border-border transition-colors hover:bg-muted/30 @(MenuOpen ? "relative z-40" : null)"
    @onclick="OnView">
    <td class="px-4 py-3.5">
        <div class="flex items-center gap-3">
            <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full text-xs font-semibold text-white"
                 style="background-color: @FormatHelper.AvatarColor(Subscriber.Name)">@FormatHelper.Initials(Subscriber.Name)</div>
            <span class="whitespace-nowrap text-sm font-medium text-foreground">@Subscriber.Name</span>
        </div>
    </td>
    <td class="px-4 py-3.5 font-mono text-sm text-muted-foreground">@(string.IsNullOrWhiteSpace(Subscriber.Phone) ? L["Common.NotSet"].Value : Subscriber.Phone)</td>
    <td class="px-4 py-3.5 text-sm text-foreground">@(Subscriber.AreaName ?? L["Common.Unassigned"].Value)</td>
    <td class="px-4 py-3.5">
        <span class="font-mono text-sm font-bold text-primary">@FormatPlan(Subscriber.Plan, Subscriber.PlanValue)</span>
    </td>
    <td class="px-4 py-3.5 whitespace-nowrap text-sm text-muted-foreground">@FormatHelper.Date(Subscriber.SubscriptionDate)</td>
    <td class="px-4 py-3.5"><StatusBadge Status="@BillingStatus" /></td>
    <td class="px-4 py-3.5 font-mono text-sm font-semibold text-foreground">@FormatHelper.Currency(Subscriber.AmountDue)</td>
    <td class="px-4 py-3.5">
        <div class="relative flex justify-end">
            <button type="button"
                    class="rounded-lg p-1 text-muted-foreground hover:text-foreground"
                    aria-label="@L["Common.MoreActions"]"
                    @onclick="OnToggleMenu"
                    @onclick:stopPropagation="true">
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="1"/><circle cx="19" cy="12" r="1"/><circle cx="5" cy="12" r="1"/></svg>
            </button>
            @if (MenuOpen)
            {
                <div class="absolute end-0 top-full z-30 mt-1 min-w-44 overflow-hidden rounded-xl border border-border bg-popover py-1 shadow-lg"
                     @onclick:stopPropagation="true">
                    <button type="button" class="flex w-full items-center gap-2 px-3 py-2 text-left text-sm text-foreground hover:bg-muted" @onclick="OnView">
                        <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                        @L["Common.ViewDetails"]
                    </button>
                    <button type="button" class="flex w-full items-center gap-2 px-3 py-2 text-left text-sm text-foreground hover:bg-muted" @onclick="OnEdit">
                        <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
                        @L["Common.Edit"]
                    </button>
                    @if (IsActive)
                    {
                        <button type="button" class="flex w-full items-center gap-2 px-3 py-2 text-left text-sm text-amber-500 hover:bg-amber-500/10" @onclick="OnSuspend">
                            <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/></svg>
                            @L["Common.Suspend"]
                        </button>
                    }
                    else
                    {
                        <button type="button" class="flex w-full items-center gap-2 px-3 py-2 text-left text-sm text-foreground hover:bg-muted" @onclick="OnActivate">
                            <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="5 3 19 12 5 21 5 3"/></svg>
                            @L["Common.Activate"]
                        </button>
                    }
                    @if (Subscriber.CanBeDeleted)
                    {
                        <button type="button" class="flex w-full items-center gap-2 px-3 py-2 text-left text-sm text-red-500 hover:bg-red-500/10" @onclick="OnDelete">
                            <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                            @L["Common.Delete"]
                        </button>
                    }
                </div>
            }
        </div>
    </td>
</tr>

@code {
    [Parameter, EditorRequired] public CustomerSummaryResponse Subscriber { get; set; } = null!;
    [Parameter] public bool MenuOpen { get; set; }
    [Parameter] public EventCallback OnToggleMenu { get; set; }
    [Parameter] public EventCallback OnView { get; set; }
    [Parameter] public EventCallback OnEdit { get; set; }
    [Parameter] public EventCallback OnSuspend { get; set; }
    [Parameter] public EventCallback OnActivate { get; set; }
    [Parameter] public EventCallback OnDelete { get; set; }

    private bool IsActive =>
        Subscriber.CustomerStatus.Equals(nameof(CustomerStatus.Active), StringComparison.OrdinalIgnoreCase);

    private string BillingStatus
    {
        get
        {
            if (Subscriber.AmountDue <= 0) return "paid";
            if (Subscriber.CustomerStatus.Equals(nameof(CustomerStatus.Suspended), StringComparison.OrdinalIgnoreCase)
                || Subscriber.CustomerStatus.Equals(nameof(CustomerStatus.Terminated), StringComparison.OrdinalIgnoreCase))
                return "overdue";
            return "unpaid";
        }
    }

    private string FormatPlan(string plan, decimal value) =>
        plan switch
        {
            nameof(PlanType.Ampere) => L["Subscribers.PlanAmpere", FormatHelper.Number(value)].Value,
            nameof(PlanType.FixedKilowatt) => L["Subscribers.PlanFixedKilowatt", FormatHelper.Number(value)].Value,
            _ => L["Subscribers.PlanKilowatt", FormatHelper.Number(value)].Value
        };
}
