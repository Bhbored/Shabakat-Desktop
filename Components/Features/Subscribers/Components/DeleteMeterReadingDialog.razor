@namespace Shabakat.Components.Features.Subscribers.Components
@inject IStringLocalizer<SharedResource> L

<ConfirmDialog Open="Open" Title="@L["Subscribers.DeleteReading"]" OnClose="OnClose">
    <ChildContent>
        <p>
            @L["Subscribers.DeleteReadingConfirm", string.IsNullOrWhiteSpace(ReadingLabel) ? L["Subscribers.ThisReading"].Value : ReadingLabel]
        </p>
    </ChildContent>
    <Footer>
        <button type="button" class="rounded-xl border border-border px-4 py-2.5 text-sm font-medium text-foreground hover:bg-muted" @onclick="OnClose">@L["Common.Cancel"]</button>
        <button type="button" class="rounded-xl bg-red-500 px-4 py-2.5 text-sm font-medium text-white hover:bg-red-500/90" @onclick="OnConfirm">@L["Common.Delete"]</button>
    </Footer>
</ConfirmDialog>

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public string ReadingLabel { get; set; } = "";
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnConfirm { get; set; }
}
