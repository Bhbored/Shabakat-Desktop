@namespace Shabakat.Components.Features.Subscribers.Components

<ConfirmDialog Open="Open"
               Title="Suspend Subscriber"
               OnClose="OnClose">
    <ChildContent>
        @if (Subscriber is not null)
        {
            <p>Suspend <span class="font-medium text-foreground">@Subscriber.Name</span>? They will no longer be billed as active.</p>
        }
    </ChildContent>
    <Footer>
        <button type="button" class="rounded-xl border border-border px-4 py-2.5 text-sm hover:bg-muted" @onclick="OnClose">Cancel</button>
        <button type="button" class="rounded-xl bg-amber-600 px-4 py-2.5 text-sm font-medium text-white" @onclick="OnConfirm">Suspend</button>
    </Footer>
</ConfirmDialog>

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public CustomerSummaryResponse? Subscriber { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnConfirm { get; set; }
}
