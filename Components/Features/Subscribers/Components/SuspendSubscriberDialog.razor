@namespace Shabakat.Components.Features.Subscribers.Components
@inject IStringLocalizer<SharedResource> L

<ConfirmDialog Open="Open"
               Title="@(IsActivate ? L["Subscribers.ActivateTitle"] : L["Subscribers.SuspendTitle"])"
               OnClose="OnClose">
    <ChildContent>
        @if (Subscriber is not null)
        {
            @if (IsActivate)
            {
                <p>@L["Subscribers.ActivateConfirm", Subscriber.Name]</p>
            }
            else
            {
                <p>@L["Subscribers.SuspendConfirm", Subscriber.Name]</p>
            }
        }
    </ChildContent>
    <Footer>
        <button type="button" class="rounded-xl border border-border px-4 py-2.5 text-sm hover:bg-muted" @onclick="OnClose">@L["Common.Cancel"]</button>
        @if (IsActivate)
        {
            <button type="button" class="rounded-xl bg-primary px-4 py-2.5 text-sm font-medium text-primary-foreground" @onclick="OnConfirm">@L["Common.Activate"]</button>
        }
        else
        {
            <button type="button" class="rounded-xl bg-amber-600 px-4 py-2.5 text-sm font-medium text-white" @onclick="OnConfirm">@L["Common.Suspend"]</button>
        }
    </Footer>
</ConfirmDialog>

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public CustomerSummaryResponse? Subscriber { get; set; }
    [Parameter] public bool IsActivate { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnConfirm { get; set; }
}
