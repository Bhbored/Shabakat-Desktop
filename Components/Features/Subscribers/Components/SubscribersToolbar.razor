@namespace Shabakat.Components.Features.Subscribers.Components
@inject IStringLocalizer<SharedResource> L

<div class="space-y-4">
    <div class="flex flex-wrap items-center gap-3 xl:flex-nowrap">
        <div class="flex min-w-72 flex-1 gap-2">
            <select class="w-36 shrink-0 rounded-xl border border-border bg-card px-3 py-2.5 text-sm text-foreground"
                    value="@SearchField"
                    @onchange="OnSearchFieldChanged">
                <option value="name">@L["Common.Name"]</option>
                <option value="phone">@L["Common.Phone"]</option>
            </select>
            <input type="text"
                   class="w-full rounded-xl border border-border bg-card px-4 py-2.5 text-sm text-foreground outline-none transition focus:border-primary"
                   placeholder="@(SearchField == "phone" ? L["Filter.SearchSubscribersPhone"] : L["Filter.SearchSubscribersName"])"
                   value="@SearchTerm"
                   @oninput="OnSearchTermInput" />
        </div>
        <div class="min-w-full xl:min-w-56">
            <AreaSearchSelect Value="@AreaFilter"
                              ValueChanged="AreaFilterChanged"
                              AllowEmpty="true"
                              EmptyLabel="@L["Filter.AllAreas"]" />
        </div>
        <div class="flex gap-2">
            <button type="button"
                    class="inline-flex items-center gap-2 rounded-xl border border-border bg-card px-4 py-2.5 text-sm font-medium text-foreground hover:bg-muted disabled:opacity-50"
                    disabled="@IsExporting"
                    @onclick="OnExport">
                @if (IsExporting)
                {
                    <span class="h-4 w-4 animate-spin rounded-full border-2 border-muted-foreground border-t-transparent"></span>
                }
                else
                {
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                        <polyline points="7 10 12 15 17 10" />
                        <line x1="12" y1="15" x2="12" y2="3" />
                    </svg>
                }
                @L["Subscribers.ExportExcel"]
            </button>
            <button type="button"
                    class="rounded-xl bg-primary px-4 py-2.5 text-sm font-medium text-primary-foreground"
                    style="box-shadow: 0 0 16px rgba(245,192,0,0.25);"
                    @onclick="OnCreate">
                @L["Subscribers.Add"]
            </button>
        </div>
    </div>

    <div class="flex flex-wrap items-center gap-3">
        <select class="min-w-40 rounded-xl border border-border bg-card px-3 py-2.5 text-sm text-foreground"
                value="@PlanFilter"
                @onchange="OnPlanFilterChanged">
            <option value="">@L["Filter.AllPlanTypes"]</option>
            <option value="@PlanType.Ampere">@L["PlanType.Ampere"]</option>
            <option value="@PlanType.Kilowatt">@L["PlanType.Kilowatt"]</option>
            <option value="@PlanType.FixedKilowatt">@L["PlanType.FixedKilowatt"]</option>
        </select>
        <select class="min-w-40 rounded-xl border border-border bg-card px-3 py-2.5 text-sm text-foreground"
                value="@ScheduleFilter"
                @onchange="OnScheduleFilterChanged">
            <option value="">@L["Filter.AllSchedules"]</option>
            @foreach (var schedule in Schedules)
            {
                <option value="@schedule.Id">@schedule.Name</option>
            }
        </select>
        <select class="min-w-40 rounded-xl border border-border bg-card px-3 py-2.5 text-sm text-foreground"
                value="@RelationFilter"
                @onchange="OnRelationFilterChanged">
            <option value="">@L["Filter.AllRelations"]</option>
            <option value="@CustomerRelation.Friend">@L["Relation.Friend"]</option>
            <option value="@CustomerRelation.Family">@L["Relation.Family"]</option>
            <option value="@CustomerRelation.Owner">@L["Relation.Owner"]</option>
        </select>
        <select class="min-w-40 rounded-xl border border-border bg-card px-3 py-2.5 text-sm text-foreground"
                value="@StatusFilter"
                @onchange="OnStatusFilterChanged">
            <option value="">@L["Filter.AllStatuses"]</option>
            <option value="@CustomerStatus.Active">@L["Status.Active"]</option>
            <option value="@CustomerStatus.Suspended">@L["Status.Suspended"]</option>
            <option value="@CustomerStatus.Terminated">@L["Status.Terminated"]</option>
        </select>
    </div>

    <p class="text-xs text-muted-foreground">
        @(TotalCount == 1 ? L["Count.Subscribers", TotalCount] : L["Count.SubscribersPlural", TotalCount])
    </p>
</div>

@code {
    [Parameter] public string SearchField { get; set; } = "name";
    [Parameter] public string SearchTerm { get; set; } = "";
    [Parameter] public string AreaFilter { get; set; } = "";
    [Parameter] public string PlanFilter { get; set; } = "";
    [Parameter] public string ScheduleFilter { get; set; } = "";
    [Parameter] public string RelationFilter { get; set; } = "";
    [Parameter] public string StatusFilter { get; set; } = "";
    [Parameter] public int TotalCount { get; set; }
    [Parameter] public IReadOnlyList<AmpereScheduleResponse> Schedules { get; set; } = [];
    [Parameter] public EventCallback<string> SearchFieldChanged { get; set; }
    [Parameter] public EventCallback<string> SearchTermChanged { get; set; }
    [Parameter] public EventCallback<string> AreaFilterChanged { get; set; }
    [Parameter] public EventCallback<string> PlanFilterChanged { get; set; }
    [Parameter] public EventCallback<string> ScheduleFilterChanged { get; set; }
    [Parameter] public EventCallback<string> RelationFilterChanged { get; set; }
    [Parameter] public EventCallback<string> StatusFilterChanged { get; set; }
    [Parameter] public bool IsExporting { get; set; }
    [Parameter] public EventCallback OnCreate { get; set; }
    [Parameter] public EventCallback OnExport { get; set; }

    private Task OnSearchFieldChanged(ChangeEventArgs e) =>
        SearchFieldChanged.InvokeAsync(e.Value?.ToString() ?? "");

    private Task OnSearchTermInput(ChangeEventArgs e) =>
        SearchTermChanged.InvokeAsync(e.Value?.ToString() ?? "");

    private Task OnPlanFilterChanged(ChangeEventArgs e) =>
        PlanFilterChanged.InvokeAsync(e.Value?.ToString() ?? "");

    private Task OnScheduleFilterChanged(ChangeEventArgs e) =>
        ScheduleFilterChanged.InvokeAsync(e.Value?.ToString() ?? "");

    private Task OnRelationFilterChanged(ChangeEventArgs e) =>
        RelationFilterChanged.InvokeAsync(e.Value?.ToString() ?? "");

    private Task OnStatusFilterChanged(ChangeEventArgs e) =>
        StatusFilterChanged.InvokeAsync(e.Value?.ToString() ?? "");
}
