@namespace Shabakat.Components.Features.Areas.Components
@inject IStringLocalizer<SharedResource> L

@if (IsLoading)
{
    <TableSkeleton Columns="5" Rows="6" MinWidthClass="min-w-[720px]" ShowPager="false" />
}
else
{
    <section class="rounded-2xl border border-border bg-card">
        @if (Areas.Count == 0)
        {
            <div class="px-4 py-10 text-sm text-muted-foreground">@L["Empty.AreasNone"]</div>
        }
        else
        {
            <table class="w-full min-w-[720px]">
                <thead>
                    <tr class="border-b border-border">
                        <th class="px-4 py-3.5 text-start text-xs font-semibold uppercase tracking-[0.18em] text-muted-foreground">@L["Common.Name"]</th>
                        <th class="px-4 py-3.5 text-start text-xs font-semibold uppercase tracking-[0.18em] text-muted-foreground">@L["Ampere.Subscribers"]</th>
                        <th class="px-4 py-3.5 text-start text-xs font-semibold uppercase tracking-[0.18em] text-muted-foreground">@L["Nav.Boxes"]</th>
                        <th class="px-4 py-3.5 text-start text-xs font-semibold uppercase tracking-[0.18em] text-muted-foreground">@L["Common.Created"]</th>
                        <th class="px-4 py-3.5"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var area in Areas)
                    {
                        <AreaCard Area="area"
                                  MenuOpen="@(OpenMenuId == area.Id)"
                                  OnToggleMenu="() => OnToggleMenu.InvokeAsync(area.Id)"
                                  OnView="() => OnView.InvokeAsync(area)"
                                  OnEdit="() => OnEdit.InvokeAsync(area)"
                                  OnDelete="() => OnDelete.InvokeAsync(area)" />
                    }
                </tbody>
            </table>
        }
    </section>
}

@code {
    [Parameter] public IReadOnlyList<AreaResponse> Areas { get; set; } = [];
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public Guid? OpenMenuId { get; set; }
    [Parameter] public EventCallback<Guid> OnToggleMenu { get; set; }
    [Parameter] public EventCallback<AreaResponse> OnView { get; set; }
    [Parameter] public EventCallback<AreaResponse> OnEdit { get; set; }
    [Parameter] public EventCallback<AreaResponse> OnDelete { get; set; }
}
