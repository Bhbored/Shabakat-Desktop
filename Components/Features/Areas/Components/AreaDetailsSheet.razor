@namespace Shabakat.Components.Features.Areas.Components
@inject IStringLocalizer<SharedResource> L
@inject NavigationManager Navigation

<SideSheet Open="Open"
           Title="@(Area?.Name ?? L["Areas.Details"].Value)"
           Description="@L["Areas.DetailsHint"]"
           MaxWidthClass="sm:max-w-xl"
           OnClose="OnClose">
    @if (Area is not null)
    {
        <div class="space-y-4">
            <div class="grid gap-4 md:grid-cols-3">
                <div class="rounded-2xl border border-border bg-card p-4">
                    <p class="text-xs uppercase tracking-[0.18em] text-muted-foreground">@L["Ampere.Subscribers"]</p>
                    <p class="mt-2 text-xl font-semibold text-foreground">
                        @(Area.CustomerCount == 1 ? L["Count.Subscribers", Area.CustomerCount] : L["Count.SubscribersPlural", Area.CustomerCount])
                    </p>
                </div>
                <div class="rounded-2xl border border-border bg-card p-4">
                    <p class="text-xs uppercase tracking-[0.18em] text-muted-foreground">@L["Nav.Boxes"]</p>
                    <p class="mt-2 text-xl font-semibold text-foreground">
                        @(Area.BoxCount == 1 ? L["Count.Boxes", Area.BoxCount] : L["Count.BoxesPlural", Area.BoxCount])
                    </p>
                </div>
                <div class="rounded-2xl border border-border bg-card p-4">
                    <p class="text-xs uppercase tracking-[0.18em] text-muted-foreground">@L["Common.Created"]</p>
                    <p class="mt-2 text-xl font-semibold text-foreground">@FormatHelper.Date(Area.CreatedAt)</p>
                </div>
            </div>

            <div class="space-y-4 rounded-2xl border border-border bg-card p-5">
                <div class="flex items-start justify-between gap-3">
                    <div class="space-y-4 min-w-0 flex-1">
                        <div class="flex items-start gap-3">
                            <div class="rounded-lg border border-border bg-muted/40 p-2 text-primary">
                                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                            </div>
                            <div>
                                <p class="text-xs uppercase tracking-[0.18em] text-muted-foreground">@L["Common.Name"]</p>
                                <p class="mt-1 text-sm text-foreground">@Area.Name</p>
                            </div>
                        </div>
                        <div class="flex items-start gap-3">
                            <div class="rounded-lg border border-border bg-muted/40 p-2 text-primary">
                                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
                            </div>
                            <div>
                                <p class="text-xs uppercase tracking-[0.18em] text-muted-foreground">@L["Ampere.AssignedSubscribers"]</p>
                                <p class="mt-1 text-sm text-foreground">@Area.CustomerCount</p>
                            </div>
                        </div>
                        <div class="flex items-start gap-3">
                            <div class="rounded-lg border border-border bg-muted/40 p-2 text-primary">
                                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                            </div>
                            <div>
                                <p class="text-xs uppercase tracking-[0.18em] text-muted-foreground">@L["Common.CreatedAt"]</p>
                                <p class="mt-1 text-sm text-foreground">@FormatHelper.Date(Area.CreatedAt)</p>
                            </div>
                        </div>
                    </div>
                    <button type="button"
                            class="inline-flex shrink-0 items-center gap-2 rounded-xl border border-border bg-muted/40 px-3 py-2 text-sm font-medium text-foreground hover:bg-muted"
                            @onclick="() => NavigateToSubscribers(Area.Id)">
                        <svg class="h-4 w-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3" /></svg>
                        @L["Areas.ViewSubscribers"]
                    </button>
                </div>
            </div>

            <div class="space-y-4 rounded-2xl border border-border bg-card p-5">
                <div class="flex items-start justify-between gap-3">
                    <div>
                        <h3 class="text-sm font-semibold uppercase tracking-[0.18em] text-muted-foreground">@L["Areas.AssignedBoxes"]</h3>
                        <p class="mt-2 text-sm text-muted-foreground">@L["Areas.AssignedBoxesHint"]</p>
                    </div>
                    <div class="flex shrink-0 flex-col items-end gap-2">
                        <span class="rounded-full border border-border px-3 py-1 text-xs text-muted-foreground">
                            @((BoxesPage?.TotalCount ?? 0) == 1
                                ? L["Count.Boxes", BoxesPage?.TotalCount ?? 0]
                                : L["Count.BoxesPlural", BoxesPage?.TotalCount ?? 0])
                        </span>
                        <button type="button"
                                class="inline-flex items-center gap-2 rounded-xl border border-border bg-muted/40 px-3 py-2 text-sm font-medium text-foreground hover:bg-muted"
                                @onclick="() => NavigateToBoxes(Area.Id)">
                            <svg class="h-4 w-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3" /></svg>
                            @L["Areas.ViewBoxes"]
                        </button>
                    </div>
                </div>

                @if (BoxesLoading)
                {
                    <div class="space-y-3">
                        @for (var i = 0; i < 3; i++)
                        {
                            <div class="rounded-2xl border border-border bg-muted/30 p-4">
                                <div class="flex items-start gap-3">
                                    <SkeletonBone Class="h-8 w-8 rounded-full" />
                                    <div class="flex-1 space-y-2">
                                        <SkeletonBone Class="h-4 w-32 rounded" />
                                        <SkeletonBone Class="h-3 w-24 rounded" />
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else if (BoxesPage is null || !BoxesPage.Data.Any())
                {
                    <p class="text-sm text-muted-foreground">@L["Areas.NoneAssigned"]</p>
                }
                else
                {
                    <div class="space-y-3">
                        @foreach (var box in BoxesPage.Data)
                        {
                            <div class="rounded-2xl border border-border bg-muted/20 p-4">
                                <div class="flex items-start justify-between gap-3">
                                    <div class="flex items-start gap-3 min-w-0">
                                        <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full text-xs font-semibold text-white"
                                             style="background-color: @FormatHelper.AvatarColor(box.Name)">
                                            @FormatHelper.Initials(box.Name)
                                        </div>
                                        <div class="min-w-0 space-y-2">
                                            <div>
                                                <p class="truncate text-sm font-semibold text-foreground">@box.Name</p>
                                                <p class="mt-1 text-xs text-muted-foreground">
                                                    @(string.IsNullOrWhiteSpace(box.LocationNote) ? L["Common.NotSet"].Value : box.LocationNote)
                                                </p>
                                            </div>
                                            <div class="flex flex-wrap items-center gap-2">
                                                <span class="rounded-full border border-border px-2.5 py-1 text-xs text-muted-foreground">
                                                    @(box.CustomerCount == 1
                                                        ? L["Count.Subscribers", box.CustomerCount]
                                                        : L["Count.SubscribersPlural", box.CustomerCount])
                                                </span>
                                                <span class="rounded-full border border-border px-2.5 py-1 text-xs text-muted-foreground">
                                                    @FormatHelper.Date(box.CreatedAt)
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                    <button type="button"
                                            class="inline-flex shrink-0 items-center gap-2 rounded-xl border border-border bg-card px-3 py-2 text-sm font-medium text-foreground hover:bg-muted"
                                            @onclick="() => NavigateToSubscribers(Area.Id, box.Id)">
                                        <svg class="h-4 w-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3" /></svg>
                                        @L["Areas.ViewSubscribers"]
                                    </button>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(box.Notes))
                                {
                                    <p class="mt-3 text-sm text-muted-foreground">@box.Notes</p>
                                }
                            </div>
                        }
                    </div>
                }

                @if (BoxesPage is { TotalPages: > 1 })
                {
                    <div class="flex flex-wrap items-center justify-between gap-3 border-t border-border pt-4">
                        <span class="text-sm text-muted-foreground">@L["Pager.PageOf", BoxesPage.PageNumber, BoxesPage.TotalPages]</span>
                        <div class="flex gap-2">
                            <button type="button"
                                    class="rounded-xl border border-border px-3 py-2 text-sm text-foreground hover:bg-muted disabled:opacity-40"
                                    disabled="@(!BoxesPage.HasPreviousPage || BoxesLoading)"
                                    @onclick="() => OnBoxesPageChanged.InvokeAsync(BoxesPage.PageNumber - 1)">
                                @L["Common.Previous"]
                            </button>
                            <button type="button"
                                    class="rounded-xl border border-border px-3 py-2 text-sm text-foreground hover:bg-muted disabled:opacity-40"
                                    disabled="@(!BoxesPage.HasNextPage || BoxesLoading)"
                                    @onclick="() => OnBoxesPageChanged.InvokeAsync(BoxesPage.PageNumber + 1)">
                                @L["Common.Next"]
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</SideSheet>

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public AreaResponse? Area { get; set; }
    [Parameter] public PagedResponse<DistributionBoxResponse>? BoxesPage { get; set; }
    [Parameter] public bool BoxesLoading { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<int> OnBoxesPageChanged { get; set; }

    private void NavigateToSubscribers(Guid areaId, Guid? boxId = null)
    {
        var url = boxId.HasValue
            ? $"subscribers/{areaId}/{boxId.Value}"
            : $"subscribers/{areaId}";
        Navigation.NavigateTo(url);
    }

    private void NavigateToBoxes(Guid areaId) =>
        Navigation.NavigateTo($"boxes/{areaId}");
}
