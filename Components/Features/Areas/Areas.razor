@page "/areas"
@inject IAreaService AreaService
@inject IDistributionBoxService BoxService
@inject IToastService Toast
@inject IStringLocalizer<SharedResource> L

<div class="space-y-4" @onclick="CloseMenu">
    <AreasToolbar Search="@_searchTerm"
                  Total="_filtered.Count"
                  Disabled="_loading"
                  SearchChanged="OnSearchChanged"
                  OnCreate="OpenCreate"/>

    <AreasList Areas="_filtered"
               IsLoading="_loading"
               OpenMenuId="_menuAreaId"
               OnToggleMenu="ToggleMenu"
               OnView="OpenDetails"
               OnEdit="OpenEdit"
               OnDelete="OpenDelete"/>
</div>

<AreaDetailsSheet Open="_showDetails"
                  Area="_selected"
                  BoxesPage="_boxesPage"
                  BoxesLoading="_boxesLoading"
                  OnClose="CloseDetails"
                  OnBoxesPageChanged="LoadBoxesPageAsync"/>

<AreaFormSheet Open="_showForm"
               IsEdit="@(_editingId is not null)"
               InitialName="@_formName"
               Saving="_saving"
               OnClose="CloseForm"
               OnSave="SaveAsync"/>

<DeleteAreaDialog Open="_showDelete"
                  Area="_pendingDelete"
                  Saving="_saving"
                  OnClose="CloseDelete"
                  OnConfirm="ConfirmDeleteAsync"/>

@code {
    private readonly List<AreaResponse> _items = [];
    private List<AreaResponse> _filtered = [];
    private string _searchTerm = "";
    private string _formName = "";
    private bool _loading = true;
    private bool _saving;
    private bool _showForm;
    private bool _showDetails;
    private bool _showDelete;
    private Guid? _editingId;
    private Guid? _menuAreaId;
    private AreaResponse? _selected;
    private AreaResponse? _pendingDelete;
    private PagedResponse<DistributionBoxResponse>? _boxesPage;
    private bool _boxesLoading;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        var result = await UiActions.RunAsync(Toast, () => AreaService.GetAllAsync());
        _items.Clear();
        if (result is not null)
            _items.AddRange(result.OrderBy(a => a.Name));
        ApplyFilter();
        _loading = false;
    }

    private void OnSearchChanged(string value)
    {
        _searchTerm = value;
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        var term = _searchTerm.Trim();
        _filtered = string.IsNullOrEmpty(term)
            ? [.. _items]
            : [.. _items.Where(a => a.Name.Contains(term, StringComparison.OrdinalIgnoreCase))];
    }

    private void ToggleMenu(Guid id) => _menuAreaId = _menuAreaId == id ? null : id;
    private void CloseMenu() => _menuAreaId = null;

    private async Task OpenDetails(AreaResponse area)
    {
        CloseMenu();
        _selected = area;
        _showDetails = true;
        await LoadBoxesPageAsync(1);
    }

    private void CloseDetails()
    {
        _showDetails = false;
        _selected = null;
        _boxesPage = null;
    }

    private async Task LoadBoxesPageAsync(int page)
    {
        if (_selected is null || page < 1) return;
        _boxesLoading = true;
        _boxesPage = await UiActions.RunAsync(
            Toast,
            () => BoxService.GetAllAsync(new DistributionBoxFilterRequest(
                AreaId: _selected.Id,
                PageNumber: page,
                PageSize: 10)));
        _boxesLoading = false;
    }

    private void OpenCreate()
    {
        CloseMenu();
        _editingId = null;
        _formName = "";
        _showForm = true;
    }

    private void OpenEdit(AreaResponse area)
    {
        CloseMenu();
        _editingId = area.Id;
        _formName = area.Name;
        _showForm = true;
    }

    private void CloseForm()
    {
        if (_saving) return;
        _showForm = false;
        _editingId = null;
    }

    private void OpenDelete(AreaResponse area)
    {
        CloseMenu();
        _pendingDelete = area;
        _showDelete = true;
    }

    private void CloseDelete()
    {
        if (_saving) return;
        _showDelete = false;
        _pendingDelete = null;
    }

    private async Task SaveAsync(string name)
    {
        if (_saving) return;
        _saving = true;

        bool ok;
        if (_editingId is null)
        {
            var created = await UiActions.RunAsync(
                Toast,
                () => AreaService.CreateAsync(new CreateAreaRequest(name)),
                L["Areas.Created"].Value);
            ok = created is not null;
        }
        else
        {
            var updated = await UiActions.RunAsync(
                Toast,
                () => AreaService.UpdateAsync(_editingId.Value, new UpdateAreaRequest(name)),
                L["Areas.Updated"].Value);
            ok = updated is not null;
        }

        _saving = false;
        if (!ok) return;

        _showForm = false;
        _editingId = null;
        await LoadAsync();
    }

    private async Task ConfirmDeleteAsync()
    {
        if (_pendingDelete is null || _saving) return;
        _saving = true;

        await UiActions.RunAsync(
            Toast,
            () => AreaService.DeleteAsync(_pendingDelete.Id),
            L["Areas.Deleted"].Value);

        _saving = false;
        _showDelete = false;
        _pendingDelete = null;
        await LoadAsync();
    }

}
