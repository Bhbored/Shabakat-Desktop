@namespace Shabakat.Components.Features.Invoices.Components
@inject IStringLocalizer<SharedResource> L

<ConfirmDialog Open="Open"
               Title="@L["Invoices.DeleteTitle"]"
               OnClose="OnClose">
    <ChildContent>
        @if (Invoice is not null)
        {
            <p>@L["Invoices.DeleteConfirm", Invoice.InvoiceNumber]</p>
        }
    </ChildContent>
    <Footer>
        <button type="button" class="rounded-xl border border-border px-4 py-2.5 text-sm hover:bg-muted" @onclick="OnClose">@L["Common.Cancel"]</button>
        <button type="button" class="rounded-xl bg-red-600 px-4 py-2.5 text-sm font-medium text-white" @onclick="OnConfirm">@L["Common.Delete"]</button>
    </Footer>
</ConfirmDialog>

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public InvoiceSummaryResponse? Invoice { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnConfirm { get; set; }
}
