@namespace Shabakat.Components.Features.Invoices.Components
@inject IStringLocalizer<SharedResource> L

<ConfirmDialog Open="Open"
               Role="dialog"
               Title="@L["Invoices.RecordPayment"]"
               Description="@(Invoice is null ? L["Invoices.PayHint"].Value : L["Invoices.PayHintNumber", Invoice.InvoiceNumber].Value)"
               MaxWidthClass="max-w-lg"
               ContentClass="mt-4 space-y-4 text-sm text-foreground"
               OnClose="OnClose">
    <ChildContent>
        @if (Invoice is not null)
        {
            <div class="rounded-2xl border border-border bg-muted/20 px-4 py-3 text-sm text-muted-foreground">
                @L["Invoices.RemainingBalance", FormatHelper.Currency(Invoice.AmountDue)]
            </div>
            <div>
                <label class="mb-1.5 block text-xs font-medium text-muted-foreground">@L["Common.Amount"]</label>
                <input type="number"
                       step="0.01"
                       min="0"
                       class="w-full rounded-xl border border-border bg-card px-3 py-2.5 text-sm outline-none focus:border-primary"
                       @bind="Model.Amount" />
            </div>
            <div>
                <label class="mb-1.5 block text-xs font-medium text-muted-foreground">@L["Invoices.PaymentMethod"]</label>
                <select class="w-full rounded-xl border border-border bg-card px-3 py-2.5 text-sm outline-none focus:border-primary"
                        @bind="Model.PaymentMethod">
                    <option value="@PaymentMethod.Cash">@L["PaymentMethod.Cash"]</option>
                    <option value="@PaymentMethod.Wish">@L["PaymentMethod.Wish"]</option>
                </select>
            </div>
            <div>
                <label class="mb-1.5 block text-xs font-medium text-muted-foreground">@L["Common.Notes"]</label>
                <textarea rows="4"
                          class="w-full rounded-xl border border-border bg-card px-3 py-2.5 text-sm outline-none focus:border-primary"
                          placeholder="@L["Invoices.NotePlaceholder"]"
                          @bind="Model.Notes"></textarea>
            </div>
        }
    </ChildContent>
    <Footer>
        <button type="button" class="rounded-xl border border-border px-4 py-2.5 text-sm hover:bg-muted" @onclick="OnClose">@L["Common.Cancel"]</button>
        <button type="button"
                class="inline-flex items-center gap-2 rounded-xl bg-primary px-4 py-2.5 text-sm font-medium text-primary-foreground disabled:opacity-50"
                disabled="@Saving"
                @onclick="OnSave">
            @if (Saving)
            {
                <svg class="h-4 w-4 animate-spin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 1 1-6.219-8.56" /></svg>
            }
            @L["Invoices.RecordPayment"]
        </button>
    </Footer>
</ConfirmDialog>

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public InvoiceSummaryResponse? Invoice { get; set; }
    [Parameter] public PayFormModel Model { get; set; } = new();
    [Parameter] public bool Saving { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnSave { get; set; }

    public sealed class PayFormModel
    {
        public decimal Amount { get; set; }
        public PaymentMethod PaymentMethod { get; set; } = PaymentMethod.Cash;
        public string Notes { get; set; } = "";
    }
}
