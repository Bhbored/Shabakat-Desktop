@namespace Shabakat.Components.Features.Invoices.Components
@inject IStringLocalizer<SharedResource> L

@if (IsLoading)
{
    <TableSkeleton Columns="6" Rows="6" MinWidthClass="min-w-[840px]" ShowPagerExtras="true" />
}
else if (Items.Count == 0)
{
    <section class="rounded-2xl border border-border bg-card">
        <div class="px-4 py-10 text-sm text-muted-foreground">@EmptyMessage</div>
    </section>
}
else
{
    <section class="rounded-2xl border border-border bg-card">
        <table class="w-full min-w-[840px]">
                <thead>
                    <tr class="border-b border-border">
                        <th class="px-4 py-3.5 text-start text-xs font-semibold uppercase tracking-[0.18em] text-muted-foreground">@L["Table.InvoiceNumber"]</th>
                        <th class="px-4 py-3.5 text-start text-xs font-semibold uppercase tracking-[0.18em] text-muted-foreground">@L["Common.Customer"]</th>
                        <th class="px-4 py-3.5 text-start text-xs font-semibold uppercase tracking-[0.18em] text-muted-foreground">@L["Common.Status"]</th>
                        <th class="px-4 py-3.5 text-start text-xs font-semibold uppercase tracking-[0.18em] text-muted-foreground">@L["Table.DueDate"]</th>
                        <th class="px-4 py-3.5 text-start text-xs font-semibold uppercase tracking-[0.18em] text-muted-foreground">@L["Table.Total"]</th>
                        <th class="px-4 py-3.5 text-start text-xs font-semibold uppercase tracking-[0.18em] text-muted-foreground">@L["Table.AmountDue"]</th>
                        <th class="px-4 py-3.5"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var inv in Items)
                    {
                        <InvoiceCard Invoice="inv"
                                     MenuOpen="@(OpenMenuId == inv.Id)"
                                     OnToggleMenu="() => OnToggleMenu.InvokeAsync(inv.Id)"
                                     OnView="() => OnView.InvokeAsync(inv)"
                                     OnPay="() => OnPay.InvokeAsync(inv)"
                                     OnPrint="() => OnPrint.InvokeAsync(inv)"
                                     OnDelete="() => OnDelete.InvokeAsync(inv)" />
                    }
                </tbody>
            </table>

        <div class="flex flex-col gap-3 border-t border-border px-4 py-3 text-sm text-muted-foreground md:flex-row md:items-center md:justify-between">
            <span>@L["Pager.Showing", (PageNumber - 1) * PageSize + 1, Math.Min(PageNumber * PageSize, TotalCount), TotalCount]</span>
            <div class="flex items-center gap-2 self-end md:self-auto">
                <select class="h-9 w-28 rounded-xl border border-border bg-card px-2 text-sm"
                        value="@PageSize"
                        @onchange="OnPageSizeChanged">
                    <option value="10">@L["Pager.PerPage", 10]</option>
                    <option value="20">@L["Pager.PerPage", 20]</option>
                    <option value="50">@L["Pager.PerPage", 50]</option>
                </select>
                <button type="button" class="rounded-xl border border-border px-3 py-1.5 text-sm disabled:opacity-40" disabled="@(!HasPrevious)" @onclick="OnPreviousPage">@L["Common.Previous"]</button>
                <span class="min-w-24 text-center">@L["Pager.PageOf", PageNumber, Math.Max(1, TotalPages)]</span>
                <button type="button" class="rounded-xl border border-border px-3 py-1.5 text-sm disabled:opacity-40" disabled="@(!HasNext)" @onclick="OnNextPage">@L["Common.Next"]</button>
            </div>
        </div>
    </section>
}

@code {
    [Parameter] public IReadOnlyList<InvoiceSummaryResponse> Items { get; set; } = [];
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public string EmptyMessage { get; set; } = "";
    [Parameter] public Guid? OpenMenuId { get; set; }
    [Parameter] public int PageNumber { get; set; } = 1;
    [Parameter] public int PageSize { get; set; } = 10;
    [Parameter] public EventCallback<int> PageSizeChanged { get; set; }
    [Parameter] public int TotalCount { get; set; }
    [Parameter] public int TotalPages { get; set; }
    [Parameter] public bool HasPrevious { get; set; }
    [Parameter] public bool HasNext { get; set; }
    [Parameter] public EventCallback<Guid> OnToggleMenu { get; set; }
    [Parameter] public EventCallback<InvoiceSummaryResponse> OnView { get; set; }
    [Parameter] public EventCallback<InvoiceSummaryResponse> OnPay { get; set; }
    [Parameter] public EventCallback<InvoiceSummaryResponse> OnPrint { get; set; }
    [Parameter] public EventCallback<InvoiceSummaryResponse> OnDelete { get; set; }
    [Parameter] public EventCallback OnPreviousPage { get; set; }
    [Parameter] public EventCallback OnNextPage { get; set; }

    private Task OnPageSizeChanged(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var size))
            return Task.CompletedTask;
        return PageSizeChanged.InvokeAsync(size);
    }
}
