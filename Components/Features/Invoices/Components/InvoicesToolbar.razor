@namespace Shabakat.Components.Features.Invoices.Components
@inject IStringLocalizer<SharedResource> L

<div class="space-y-4">
    <div class="flex flex-col gap-3 xl:flex-row xl:items-center">
        <div class="min-w-0 flex-1">
            <CustomerSearchSelect Value="@CustomerFilter"
                                  ValueChanged="OnCustomerSelected"
                                  AllowEmpty="true"
                                  EmptyLabel="@L["CustomerSearch.All"].Value" />
        </div>

        <div class="relative shrink-0">
            <button type="button"
                    class="inline-flex h-[2.625rem] items-center gap-2 rounded-xl border border-border bg-card px-4 text-sm font-medium text-foreground hover:bg-muted"
                    @onclick="ToggleFilters"
                    @onclick:stopPropagation="true">
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3" />
                </svg>
                @L["Filter.Button"]
                @if (ActiveFilterCount > 0)
                {
                    <span class="rounded-full bg-primary px-1.5 text-xs text-primary-foreground">@ActiveFilterCount</span>
                }
            </button>

            @if (_filtersOpen)
            {
                <div class="ui-click-away"
                     @onclick="CloseFilters"
                     @onclick:stopPropagation="true"></div>
                <div class="absolute end-0 z-[70] mt-1 w-[min(22rem,calc(100vw-2rem))] space-y-4 rounded-xl border border-border bg-popover p-4 text-popover-foreground shadow-[0_16px_40px_rgba(0,0,0,0.12)]"
                     @onclick:stopPropagation="true">
                    <div>
                        <h2 class="font-semibold text-foreground">@L["Filter.Title"]</h2>
                        <p class="mt-1 text-sm text-muted-foreground">@L["Filter.InvoicesDescription"]</p>
                    </div>

                    <label class="block space-y-1.5">
                        <span class="text-sm font-medium text-foreground">@L["Common.Status"]</span>
                        <select class="h-11 w-full rounded-xl border border-border bg-card px-3 text-sm text-foreground"
                                value="@_draftStatus"
                                @onchange="OnDraftStatusChanged">
                            <option value="">@L["Filter.AllStatuses"]</option>
                            <option value="@InvoiceStatus.Unpaid">@L["Status.Unpaid"]</option>
                            <option value="@InvoiceStatus.PartiallyPaid">@L["Status.PartiallyPaid"]</option>
                            <option value="@InvoiceStatus.Paid">@L["Status.Paid"]</option>
                        </select>
                    </label>

                    <label class="block space-y-1.5">
                        <span class="text-sm font-medium text-foreground">@L["Filter.PaymentTiming"]</span>
                        <select class="h-11 w-full rounded-xl border border-border bg-card px-3 text-sm text-foreground"
                                value="@_draftDueTiming"
                                @onchange="OnDraftDueTimingChanged">
                            <option value="">@L["Filter.AllDueTimings"]</option>
                            <option value="@InvoiceDueTimingFilter.Overdue">@L["Status.Overdue"]</option>
                            <option value="@InvoiceDueTimingFilter.DueToday">@L["Filter.DueToday"]</option>
                            <option value="@InvoiceDueTimingFilter.DueSoon">@L["Filter.DueSoon"]</option>
                        </select>
                    </label>

                    <label class="block space-y-1.5">
                        <span class="text-sm font-medium text-foreground">@L["Filter.IssueDateFrom"]</span>
                        <input type="date"
                               class="h-11 w-full rounded-xl border border-border bg-card px-3 text-sm text-foreground"
                               value="@DateText(_draftDateFrom)"
                               @onchange="OnDraftDateFromChanged" />
                    </label>

                    <label class="block space-y-1.5">
                        <span class="text-sm font-medium text-foreground">@L["Filter.IssueDateTo"]</span>
                        <input type="date"
                               class="h-11 w-full rounded-xl border border-border bg-card px-3 text-sm text-foreground"
                               value="@DateText(_draftDateTo)"
                               @onchange="OnDraftDateToChanged" />
                    </label>

                    <div class="flex items-center justify-between border-t border-border pt-4">
                        <button type="button"
                                class="rounded-lg px-3 py-2 text-sm text-muted-foreground hover:bg-muted hover:text-foreground"
                                @onclick="ClearDrafts">
                            @L["Common.Reset"]
                        </button>
                        <button type="button"
                                class="rounded-xl bg-primary px-4 py-2 text-sm font-medium text-primary-foreground"
                                @onclick="ApplyFiltersAsync">
                            @L["Filter.Apply"]
                        </button>
                    </div>
                </div>
            }
        </div>

        <div class="flex gap-2 xl:ms-auto">
            <div class="relative shrink-0">
                <button type="button"
                        class="inline-flex h-[2.625rem] items-center gap-2 rounded-xl border border-border bg-card px-4 text-sm font-medium text-foreground hover:bg-muted"
                        aria-expanded="@_exportMenuOpen"
                        aria-haspopup="menu"
                        @onclick="ToggleExportMenu"
                        @onclick:stopPropagation="true">
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                        <polyline points="7 10 12 15 17 10" />
                        <line x1="12" y1="15" x2="12" y2="3" />
                    </svg>
                    @L["Invoices.Export"]
                    <svg class="h-3.5 w-3.5 text-muted-foreground transition-transform @(_exportMenuOpen ? "rotate-180" : null)" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="m6 9 6 6 6-6" />
                    </svg>
                </button>

                @if (_exportMenuOpen)
                {
                    <div class="ui-click-away"
                         @onclick="CloseExportMenu"
                         @onclick:stopPropagation="true"></div>
                    <div class="absolute end-0 z-[70] mt-1 min-w-56 overflow-hidden rounded-xl border border-border bg-popover py-1 text-popover-foreground shadow-[0_16px_40px_rgba(0,0,0,0.12)]"
                         role="menu"
                         @onclick:stopPropagation="true">
                        <button type="button"
                                role="menuitem"
                                class="flex w-full items-center gap-2.5 px-3 py-2.5 text-start text-sm text-foreground hover:bg-muted"
                                @onclick="ExportUnpaidAsync">
                            <svg class="h-4 w-4 shrink-0 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z" />
                                <path d="M14 2v6h6" />
                                <path d="M8 13h2" />
                                <path d="M8 17h2" />
                                <path d="M14 13h2" />
                                <path d="M14 17h2" />
                            </svg>
                            @L["Invoices.ExportUnpaid"]
                        </button>
                        <button type="button"
                                role="menuitem"
                                class="flex w-full items-center gap-2.5 px-3 py-2.5 text-start text-sm text-foreground hover:bg-muted"
                                @onclick="ExportMonthAsync">
                            <svg class="h-4 w-4 shrink-0 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z" />
                                <path d="M14 2v6h6" />
                                <path d="M10 9H8" />
                                <path d="M16 13H8" />
                                <path d="M16 17H8" />
                            </svg>
                            @L["Invoices.ExportMonth"]
                        </button>
                    </div>
                }
            </div>
            <button type="button"
                    class="inline-flex h-[2.625rem] items-center rounded-xl border border-border bg-card px-4 text-sm font-medium text-foreground hover:bg-muted"
                    @onclick="OnBulkCreate">
                @L["Invoices.BulkGenerate"]
            </button>
            <button type="button"
                    class="inline-flex h-[2.625rem] items-center rounded-xl bg-primary px-4 text-sm font-medium text-primary-foreground"
                    style="box-shadow: 0 0 16px rgba(245,192,0,0.25);"
                    @onclick="OnCreate">
                @L["Invoices.Create"]
            </button>
        </div>
    </div>

    @if (ActiveFilterCount > 0)
    {
        <div class="flex flex-wrap items-center gap-2">
            <span class="text-sm text-muted-foreground">@L["Filter.Active"]:</span>
            @if (!string.IsNullOrWhiteSpace(DueTimingFilter))
            {
                var timingChip = $"{L["Filter.PaymentTiming"]}: {TimingLabel(DueTimingFilter)}";
                <span class="inline-flex items-center gap-1 rounded-full border border-primary/30 bg-primary/10 px-2.5 py-1 text-sm text-foreground">
                    @timingChip
                    <button type="button"
                            class="rounded-full p-0.5 hover:bg-primary/15"
                            aria-label="@L["Filter.Remove", timingChip]"
                            @onclick="RemoveDueTimingAsync"
                            @onclick:stopPropagation="true">
                        <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18" /><path d="m6 6 12 12" /></svg>
                    </button>
                </span>
            }
            @if (!string.IsNullOrWhiteSpace(StatusFilter))
            {
                var statusChip = $"{L["Common.Status"]}: {StatusLabel(StatusFilter)}";
                <span class="inline-flex items-center gap-1 rounded-full border border-primary/30 bg-primary/10 px-2.5 py-1 text-sm text-foreground">
                    @statusChip
                    <button type="button"
                            class="rounded-full p-0.5 hover:bg-primary/15"
                            aria-label="@L["Filter.Remove", statusChip]"
                            @onclick="RemoveStatusAsync"
                            @onclick:stopPropagation="true">
                        <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18" /><path d="m6 6 12 12" /></svg>
                    </button>
                </span>
            }
            @if (DateFrom.HasValue)
            {
                var fromChip = $"{L["Filter.IssueDateFrom"]}: {FormatHelper.Date(DateFrom.Value)}";
                <span class="inline-flex items-center gap-1 rounded-full border border-primary/30 bg-primary/10 px-2.5 py-1 text-sm text-foreground">
                    @fromChip
                    <button type="button"
                            class="rounded-full p-0.5 hover:bg-primary/15"
                            aria-label="@L["Filter.Remove", fromChip]"
                            @onclick="RemoveDateFromAsync"
                            @onclick:stopPropagation="true">
                        <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18" /><path d="m6 6 12 12" /></svg>
                    </button>
                </span>
            }
            @if (DateTo.HasValue)
            {
                var toChip = $"{L["Filter.IssueDateTo"]}: {FormatHelper.Date(DateTo.Value)}";
                <span class="inline-flex items-center gap-1 rounded-full border border-primary/30 bg-primary/10 px-2.5 py-1 text-sm text-foreground">
                    @toChip
                    <button type="button"
                            class="rounded-full p-0.5 hover:bg-primary/15"
                            aria-label="@L["Filter.Remove", toChip]"
                            @onclick="RemoveDateToAsync"
                            @onclick:stopPropagation="true">
                        <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18" /><path d="m6 6 12 12" /></svg>
                    </button>
                </span>
            }
            <button type="button"
                    class="h-8 rounded-lg px-2 text-xs text-muted-foreground hover:bg-muted hover:text-foreground"
                    @onclick="ClearAppliedAsync">
                @L["Filter.ClearAll"]
            </button>
        </div>
    }

    <p class="text-xs text-muted-foreground">
        @(TotalCount == 1 ? L["Count.Invoices", TotalCount] : L["Count.InvoicesPlural", TotalCount])
    </p>
</div>

@code {
    [Parameter] public string CustomerFilter { get; set; } = "";
    [Parameter] public EventCallback<string> CustomerFilterChanged { get; set; }
    [Parameter] public string StatusFilter { get; set; } = "";
    [Parameter] public EventCallback<string> StatusFilterChanged { get; set; }
    [Parameter] public string DueTimingFilter { get; set; } = "";
    [Parameter] public EventCallback<string> DueTimingFilterChanged { get; set; }
    [Parameter] public DateTime? DateFrom { get; set; }
    [Parameter] public EventCallback<DateTime?> DateFromChanged { get; set; }
    [Parameter] public DateTime? DateTo { get; set; }
    [Parameter] public EventCallback<DateTime?> DateToChanged { get; set; }
    [Parameter] public int TotalCount { get; set; }
    [Parameter] public EventCallback OnFiltersChanged { get; set; }
    [Parameter] public EventCallback OnExportUnpaid { get; set; }
    [Parameter] public EventCallback OnExportMonth { get; set; }
    [Parameter] public EventCallback OnBulkCreate { get; set; }
    [Parameter] public EventCallback OnCreate { get; set; }

    private bool _filtersOpen;
    private bool _exportMenuOpen;
    private string _draftStatus = "";
    private string _draftDueTiming = "";
    private DateTime? _draftDateFrom;
    private DateTime? _draftDateTo;

    private int ActiveFilterCount =>
        (string.IsNullOrWhiteSpace(StatusFilter) ? 0 : 1)
        + (string.IsNullOrWhiteSpace(DueTimingFilter) ? 0 : 1)
        + (DateFrom.HasValue ? 1 : 0)
        + (DateTo.HasValue ? 1 : 0);

    private void ToggleFilters()
    {
        if (_filtersOpen)
        {
            CloseFilters();
            return;
        }

        _draftStatus = StatusFilter;
        _draftDueTiming = DueTimingFilter;
        _draftDateFrom = DateFrom;
        _draftDateTo = DateTo;
        _exportMenuOpen = false;
        _filtersOpen = true;
    }

    private void CloseFilters() => _filtersOpen = false;

    private void ToggleExportMenu()
    {
        _exportMenuOpen = !_exportMenuOpen;
        if (_exportMenuOpen)
            _filtersOpen = false;
    }

    private void CloseExportMenu() => _exportMenuOpen = false;

    private async Task ExportUnpaidAsync()
    {
        CloseExportMenu();
        await OnExportUnpaid.InvokeAsync();
    }

    private async Task ExportMonthAsync()
    {
        CloseExportMenu();
        await OnExportMonth.InvokeAsync();
    }

    private void ClearDrafts()
    {
        _draftStatus = "";
        _draftDueTiming = "";
        _draftDateFrom = null;
        _draftDateTo = null;
    }

    private void OnDraftStatusChanged(ChangeEventArgs e)
    {
        _draftStatus = e.Value?.ToString() ?? "";
        if (_draftStatus.Equals(nameof(InvoiceStatus.Paid), StringComparison.OrdinalIgnoreCase))
            _draftDueTiming = "";
    }

    private void OnDraftDueTimingChanged(ChangeEventArgs e)
    {
        _draftDueTiming = e.Value?.ToString() ?? "";
        if (!string.IsNullOrWhiteSpace(_draftDueTiming)
            && _draftStatus.Equals(nameof(InvoiceStatus.Paid), StringComparison.OrdinalIgnoreCase))
            _draftStatus = "";
    }

    private void OnDraftDateFromChanged(ChangeEventArgs e) =>
        _draftDateFrom = ParseDate(e.Value?.ToString());

    private void OnDraftDateToChanged(ChangeEventArgs e) =>
        _draftDateTo = ParseDate(e.Value?.ToString());

    private async Task ApplyFiltersAsync()
    {
        await StatusFilterChanged.InvokeAsync(_draftStatus);
        await DueTimingFilterChanged.InvokeAsync(_draftDueTiming);
        await DateFromChanged.InvokeAsync(_draftDateFrom);
        await DateToChanged.InvokeAsync(_draftDateTo);
        _filtersOpen = false;
        await OnFiltersChanged.InvokeAsync();
    }

    private async Task OnCustomerSelected(string value)
    {
        await CustomerFilterChanged.InvokeAsync(value);
        await OnFiltersChanged.InvokeAsync();
    }

    private async Task RemoveStatusAsync()
    {
        await StatusFilterChanged.InvokeAsync("");
        await OnFiltersChanged.InvokeAsync();
    }

    private async Task RemoveDateFromAsync()
    {
        await DateFromChanged.InvokeAsync(null);
        await OnFiltersChanged.InvokeAsync();
    }

    private async Task RemoveDateToAsync()
    {
        await DateToChanged.InvokeAsync(null);
        await OnFiltersChanged.InvokeAsync();
    }

    private async Task ClearAppliedAsync()
    {
        await StatusFilterChanged.InvokeAsync("");
        await DueTimingFilterChanged.InvokeAsync("");
        await DateFromChanged.InvokeAsync(null);
        await DateToChanged.InvokeAsync(null);
        await OnFiltersChanged.InvokeAsync();
    }

    private async Task RemoveDueTimingAsync()
    {
        await DueTimingFilterChanged.InvokeAsync("");
        await OnFiltersChanged.InvokeAsync();
    }

    private string StatusLabel(string status) => status switch
    {
        nameof(InvoiceStatus.Unpaid) => L["Status.Unpaid"].Value,
        nameof(InvoiceStatus.PartiallyPaid) => L["Status.PartiallyPaid"].Value,
        nameof(InvoiceStatus.Paid) => L["Status.Paid"].Value,
        _ => status
    };

    private string TimingLabel(string timing) => timing switch
    {
        nameof(InvoiceDueTimingFilter.Overdue) => L["Status.Overdue"].Value,
        nameof(InvoiceDueTimingFilter.DueToday) => L["Filter.DueToday"].Value,
        nameof(InvoiceDueTimingFilter.DueSoon) => L["Filter.DueSoon"].Value,
        _ => timing
    };

    private static string DateText(DateTime? value) =>
        value?.ToString("yyyy-MM-dd") ?? "";

    private static DateTime? ParseDate(string? text) =>
        string.IsNullOrWhiteSpace(text)
            ? null
            : DateTime.TryParseExact(text, "yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var d)
                ? d
                : null;
}
