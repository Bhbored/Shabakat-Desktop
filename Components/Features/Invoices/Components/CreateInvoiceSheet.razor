@namespace Shabakat.Components.Features.Invoices.Components
@inject IInvoiceService InvoiceService

<ConfirmDialog Open="Open"
               Role="dialog"
               Title="Create Invoice"
               Description="Generate one invoice from backend billing rules for a selected customer."
               MaxWidthClass="max-w-lg"
               ContentClass="mt-4 space-y-4 text-sm text-foreground"
               OnClose="OnClose">
    <ChildContent>
        <div>
            <label class="mb-1.5 block text-xs font-medium text-muted-foreground">Customer</label>
            <select class="w-full rounded-xl border border-border bg-card px-3 py-2.5 text-sm outline-none focus:border-primary"
                    @bind="Model.CustomerId"
                    @bind:after="HandleCustomerChangedAsync">
                <option value="">Select customer</option>
                @foreach (var cust in Customers)
                {
                    <option value="@cust.Id">@cust.Name</option>
                }
            </select>
        </div>

        @if (ShowBilledDays)
        {
            <div class="space-y-3 rounded-2xl border border-border bg-card p-4">
                <p class="text-sm font-medium text-foreground">Days Billed</p>
                <p class="text-xs text-muted-foreground">Set the date range for ampere proration. The billed amount will be calculated proportionally based on the number of days.</p>
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="mb-1.5 block text-xs font-medium text-muted-foreground">From</label>
                        <input type="date"
                               class="w-full rounded-xl border border-border bg-card px-3 py-2.5 text-sm outline-none focus:border-primary"
                               @bind="Model.BilledFrom" />
                    </div>
                    <div>
                        <label class="mb-1.5 block text-xs font-medium text-muted-foreground">To</label>
                        <input type="date"
                               class="w-full rounded-xl border border-border bg-card px-3 py-2.5 text-sm outline-none focus:border-primary"
                               @bind="Model.BilledTo" />
                    </div>
                </div>
                @if (BilledDays > 0)
                {
                    <p class="text-sm text-foreground">@BilledDays day(s) will be billed.</p>
                }
                else
                {
                    <p class="text-sm text-red-500">The 'To' date must be on or after the 'From' date.</p>
                }
            </div>
        }

        @if (IsFixedKilowatt)
        {
            <div class="space-y-2">
                <label class="block text-xs font-medium text-muted-foreground">Charge Mode</label>
                <div class="grid grid-cols-2 gap-1 rounded-xl border border-border bg-muted/40 p-1">
                    <button type="button"
                            class="rounded-lg px-3 py-2 text-sm @(Model.FixedMode == "payment" ? "bg-card font-medium shadow-sm" : "text-muted-foreground")"
                            @onclick='() => SetFixedModeAsync("payment")'>
                        By payment
                    </button>
                    <button type="button"
                            class="rounded-lg px-3 py-2 text-sm @(Model.FixedMode == "kilowatt" ? "bg-card font-medium shadow-sm" : "text-muted-foreground")"
                            @onclick='() => SetFixedModeAsync("kilowatt")'>
                        By kWh
                    </button>
                </div>
            </div>

            <div>
                <label class="mb-1.5 block text-xs font-medium text-muted-foreground">
                    @(Model.FixedMode == "payment" ? "Payment Amount" : "Kilowatt Amount")
                </label>
                @if (Model.FixedMode == "payment")
                {
                    <input type="number"
                           step="0.01"
                           min="0.0001"
                           class="w-full rounded-xl border border-border bg-card px-3 py-2.5 text-sm outline-none focus:border-primary"
                           @bind="Model.PaymentAmount"
                           @bind:after="RefreshPreviewAsync" />
                }
                else
                {
                    <input type="number"
                           step="0.01"
                           min="0.0001"
                           class="w-full rounded-xl border border-border bg-card px-3 py-2.5 text-sm outline-none focus:border-primary"
                           @bind="Model.KilowattAmount"
                           @bind:after="RefreshPreviewAsync" />
                }
            </div>

            <div>
                <label class="mb-1.5 block text-xs font-medium text-muted-foreground">Payment Method</label>
                <select class="w-full rounded-xl border border-border bg-card px-3 py-2.5 text-sm outline-none focus:border-primary"
                        @bind="Model.PaymentMethod">
                    <option value="">Select payment method</option>
                    <option value="@PaymentMethod.Cash">Cash</option>
                    <option value="@PaymentMethod.Wish">Wish</option>
                </select>
            </div>

            <div>
                <label class="mb-1.5 block text-xs font-medium text-muted-foreground">Notes</label>
                <input class="w-full rounded-xl border border-border bg-card px-3 py-2.5 text-sm outline-none focus:border-primary"
                       placeholder="Counter payment"
                       @bind="Model.Notes" />
                <p class="mt-2 text-xs text-muted-foreground">FixedKilowatt creates a paid invoice and credits kWh immediately.</p>
            </div>

            <div class="space-y-3 rounded-2xl border border-border bg-card p-4">
                <div class="flex items-center justify-between gap-3">
                    <p class="text-sm font-semibold text-foreground">Server Calculation Preview</p>
                    @if (_previewLoading)
                    {
                        <span class="text-xs text-muted-foreground">Calculating...</span>
                    }
                </div>

                @if (_preview is not null)
                {
                    <div class="grid gap-3 sm:grid-cols-2">
                        <div class="rounded-xl border border-border bg-muted/20 px-3 py-2">
                            <p class="text-[11px] uppercase tracking-[0.18em] text-muted-foreground">Payment</p>
                            <p class="mt-1 text-sm font-medium text-foreground">@FormatHelper.Currency(_preview.PaymentAmount)</p>
                        </div>
                        <div class="rounded-xl border border-border bg-muted/20 px-3 py-2">
                            <p class="text-[11px] uppercase tracking-[0.18em] text-muted-foreground">kWh Credit</p>
                            <p class="mt-1 text-sm font-medium text-foreground">@FormatHelper.Number(_preview.KilowattAmount)</p>
                        </div>
                        <div class="rounded-xl border border-border bg-muted/20 px-3 py-2">
                            <p class="text-[11px] uppercase tracking-[0.18em] text-muted-foreground">Unit Price</p>
                            <p class="mt-1 text-sm font-medium text-foreground">@FormatHelper.Currency(_preview.UnitPrice)</p>
                        </div>
                        <div class="rounded-xl border border-border bg-muted/20 px-3 py-2">
                            <p class="text-[11px] uppercase tracking-[0.18em] text-muted-foreground">Fixed Charge</p>
                            <p class="mt-1 text-sm font-medium text-foreground">@FormatHelper.Currency(_preview.FixedCharge)</p>
                        </div>
                        <div class="rounded-xl border border-border bg-muted/20 px-3 py-2">
                            <p class="text-[11px] uppercase tracking-[0.18em] text-muted-foreground">TVA</p>
                            <p class="mt-1 text-sm font-medium text-foreground">@($"{FormatHelper.Number(_preview.TVA)}%")</p>
                        </div>
                        <div class="rounded-xl border border-border bg-muted/20 px-3 py-2">
                            <p class="text-[11px] uppercase tracking-[0.18em] text-muted-foreground">Plan Value</p>
                            <p class="mt-1 text-sm font-medium text-foreground">@FormatHelper.Number(_preview.PlanValue)</p>
                        </div>
                    </div>
                }
                else if (!string.IsNullOrWhiteSpace(_previewError))
                {
                    <p class="text-sm text-red-500">@_previewError</p>
                }
                else
                {
                    <p class="text-sm text-muted-foreground">
                        Enter a payment or kWh amount to preview the exact backend calculation before creating the paid invoice.
                    </p>
                }
            </div>
        }
    </ChildContent>
    <Footer>
        <button type="button" class="rounded-xl border border-border px-4 py-2.5 text-sm hover:bg-muted" @onclick="OnClose">Cancel</button>
        <button type="button"
                class="inline-flex items-center gap-2 rounded-xl bg-primary px-4 py-2.5 text-sm font-medium text-primary-foreground disabled:opacity-50"
                disabled="@Saving"
                @onclick="OnSave">
            @if (Saving)
            {
                <svg class="h-4 w-4 animate-spin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 1 1-6.219-8.56" /></svg>
            }
            Create Invoice
        </button>
    </Footer>
</ConfirmDialog>

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public IReadOnlyList<CustomerResponse> Customers { get; set; } = [];
    [Parameter] public CreateFormModel Model { get; set; } = new();
    [Parameter] public bool Saving { get; set; }
    [Parameter] public bool AmpereProrateByDaysEnabled { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnSave { get; set; }
    [Parameter] public EventCallback OnCustomerChanged { get; set; }

    private FixedKilowattCalculateResponse? _preview;
    private bool _previewLoading;
    private string? _previewError;

    private CustomerResponse? SelectedCustomer =>
        Guid.TryParse(Model.CustomerId, out var id)
            ? Customers.FirstOrDefault(c => c.Id == id)
            : null;

    private bool IsFixedKilowatt =>
        SelectedCustomer?.Plan.Equals(nameof(PlanType.FixedKilowatt), StringComparison.OrdinalIgnoreCase) == true;

    private bool ShowBilledDays =>
        AmpereProrateByDaysEnabled
        && SelectedCustomer?.Plan.Equals(nameof(PlanType.Ampere), StringComparison.OrdinalIgnoreCase) == true;

    private int BilledDays => CalcBilledDays(Model.BilledFrom, Model.BilledTo);

    private async Task HandleCustomerChangedAsync()
    {
        _preview = null;
        _previewError = null;
        await OnCustomerChanged.InvokeAsync();
        await RefreshPreviewAsync();
    }

    private async Task SetFixedModeAsync(string mode)
    {
        Model.FixedMode = mode;
        if (mode == "payment")
            Model.KilowattAmount = null;
        else
            Model.PaymentAmount = null;
        await RefreshPreviewAsync();
    }

    private async Task RefreshPreviewAsync()
    {
        _preview = null;
        _previewError = null;
        if (!IsFixedKilowatt || SelectedCustomer is null)
            return;

        var paymentAmount = Model.FixedMode == "payment" ? Model.PaymentAmount : null;
        var kilowattAmount = Model.FixedMode == "kilowatt" ? Model.KilowattAmount : null;
        if ((paymentAmount is null or <= 0) && (kilowattAmount is null or <= 0))
            return;

        if (!Enum.TryParse<CustomerType>(SelectedCustomer.CustomerType, true, out var customerType))
            return;

        _previewLoading = true;
        try
        {
            _preview = await InvoiceService.CalculateFixedKilowattAsync(new FixedKilowattCalculateRequest(
                CustomerType: customerType,
                PlanValue: SelectedCustomer.PlanValue,
                PaymentAmount: paymentAmount,
                KilowattAmount: kilowattAmount));
        }
        catch (DomainException ex)
        {
            _previewError = ex.Message;
        }
        finally
        {
            _previewLoading = false;
        }
    }

    internal static int CalcBilledDays(DateTime from, DateTime to)
    {
        return DateOnly.FromDateTime(to).DayNumber - DateOnly.FromDateTime(from).DayNumber + 1;
    }

    public sealed class CreateFormModel
    {
        public string CustomerId { get; set; } = "";
        public DateTime BilledFrom { get; set; } = DateTime.Today;
        public DateTime BilledTo { get; set; } = EndOfMonth().ToDateTime(TimeOnly.MinValue);
        public string FixedMode { get; set; } = "payment";
        public decimal? PaymentAmount { get; set; }
        public decimal? KilowattAmount { get; set; }
        public string PaymentMethod { get; set; } = "";
        public string Notes { get; set; } = "";

        public static DateOnly EndOfMonth()
        {
            var today = DateTime.Today;
            return new DateOnly(today.Year, today.Month, DateTime.DaysInMonth(today.Year, today.Month));
        }
    }
}
