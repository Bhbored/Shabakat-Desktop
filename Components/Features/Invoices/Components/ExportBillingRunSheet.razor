@namespace Shabakat.Components.Features.Invoices.Components
@inject IStringLocalizer<SharedResource> L
@inject ICultureService CultureService
@implements IDisposable

<ConfirmDialog Open="Open"
               Title="@L["Invoices.ExportMonthTitle"].Value"
               Description="@L["Invoices.ExportMonthHint"].Value"
               MaxWidthClass="@(_step == ExportStep.Scope ? "max-w-xl" : "max-w-md")"
               OnClose="OnClose">
    <ChildContent>
        @if (Exporting || Progress > 0)
        {
            <div class="space-y-2 text-foreground">
                <div class="flex items-center justify-between text-xs text-muted-foreground">
                    <span>@L["Invoices.Exporting"]</span>
                    <span>@((Progress * 100).ToString("0"))%</span>
                </div>
                <div class="h-2.5 overflow-hidden rounded-full bg-muted">
                    <div class="h-full rounded-full bg-primary transition-[width] duration-300"
                         style="width: @((Progress * 100).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%"></div>
                </div>
            </div>
        }
        else
        {
            <div class="space-y-3 text-foreground">
                @if (_step == ExportStep.Month)
                {
                    <div>
                        <p class="mb-2 text-sm font-medium">@L["Invoices.ExportMonthLabel"]</p>
                        <div class="max-h-56 overflow-y-auto rounded-xl border border-border"
                         role="listbox"
                         aria-label="@L["Invoices.ExportMonthLabel"]">
                        @foreach (var option in _options)
                        {
                            var selected = option.Key == SelectedKey;
                            <button type="button"
                                    role="option"
                                    aria-selected="@selected"
                                    class="flex w-full items-center justify-between border-b border-border px-3 py-2.5 text-start text-sm last:border-b-0 @(selected ? "bg-primary/15 font-medium text-foreground" : "text-foreground hover:bg-muted")"
                                    @onclick="() => SelectMonthAsync(option.Key)">
                                <span>@option.Label</span>
                                @if (selected)
                                {
                                    <svg class="h-4 w-4 shrink-0 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <polyline points="20 6 9 17 4 12" />
                                    </svg>
                                }
                            </button>
                        }
                        </div>
                    </div>

                    <p class="text-xs leading-relaxed text-muted-foreground">@L["Invoices.ExportMonthRule"]</p>
                }
                else
                {
                    <div class="min-h-[26rem] space-y-4">
                        <div>
                            <p class="text-sm font-medium">@L["Invoices.ExportScope"]</p>
                            <p class="mt-1 text-xs leading-relaxed text-muted-foreground">@L["Invoices.ExportScopeHint"]</p>
                        </div>

                        <div class="rounded-xl border border-border bg-muted/30 px-3 py-2.5 text-sm text-muted-foreground">
                            @SelectedMonthLabel
                        </div>

                        <div>
                            <label class="mb-1.5 block text-xs font-medium text-muted-foreground">@L["Common.Area"]</label>
                            <AreaSearchSelect Value="@SelectedAreaId"
                                              ValueChanged="SelectAreaAsync"
                                              AllowEmpty="true"
                                              EmptyLabel="@L["Filter.AllAreas"]" />
                        </div>

                        @if (!string.IsNullOrWhiteSpace(SelectedAreaId))
                        {
                            <div>
                                <label class="mb-1.5 block text-xs font-medium text-muted-foreground">@L["Field.DistributionBox"]</label>
                                <BoxSearchSelect @key="SelectedAreaId"
                                                 Value="@SelectedBoxId"
                                                 ValueChanged="SelectBoxAsync"
                                                 AreaId="@SelectedAreaId"
                                                 AllowEmpty="true"
                                                 EmptyLabel="@L["Filter.AllBoxes"]" />
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </ChildContent>
    <Footer>
        <button type="button"
                class="rounded-xl border border-border px-4 py-2.5 text-sm hover:bg-muted"
                disabled="@Exporting"
                @onclick="OnClose">
            @L["Common.Cancel"]
        </button>
        @if (!Exporting && _step == ExportStep.Scope)
        {
            <button type="button"
                    class="rounded-xl border border-border px-4 py-2.5 text-sm hover:bg-muted"
                    @onclick="BackToMonth">
                @L["Invoices.ExportBack"]
            </button>
        }
        <button type="button"
                class="rounded-xl bg-primary px-4 py-2.5 text-sm font-medium text-primary-foreground disabled:opacity-50"
                disabled="@(Exporting || string.IsNullOrWhiteSpace(SelectedKey))"
                @onclick="HandlePrimaryAsync">
            @(Exporting
                ? L["Invoices.Exporting"]
                : _step == ExportStep.Month ? L["Invoices.ExportContinue"] : L["Invoices.ExportMonth"])
        </button>
    </Footer>
</ConfirmDialog>

@code {
    private readonly List<(string Key, string Label, int Year, int Month)> _options = [];
    private ExportStep _step = ExportStep.Month;

    [Parameter] public bool Open { get; set; }
    [Parameter] public bool Exporting { get; set; }
    [Parameter] public double Progress { get; set; }
    [Parameter] public string SelectedKey { get; set; } = "";
    [Parameter] public EventCallback<string> SelectedKeyChanged { get; set; }
    [Parameter] public string SelectedAreaId { get; set; } = "";
    [Parameter] public EventCallback<string> SelectedAreaIdChanged { get; set; }
    [Parameter] public string SelectedBoxId { get; set; } = "";
    [Parameter] public EventCallback<string> SelectedBoxIdChanged { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnExport { get; set; }

    protected override void OnInitialized()
    {
        CultureService.Changed += OnCultureChanged;
        RebuildOptions();
        EnsureSelection();
    }

    protected override void OnParametersSet()
    {
        if (!Open && !Exporting)
            _step = ExportStep.Month;

        if (_options.Count == 0)
            RebuildOptions();
        EnsureSelection();
    }

    private void RebuildOptions()
    {
        _options.Clear();
        var cursor = new DateOnly(DateTime.Now.Year, DateTime.Now.Month, 1).AddMonths(1);
        for (var i = 0; i < 19; i++)
        {
            var date = cursor.AddMonths(-i);
            _options.Add(($"{date.Year}-{date.Month}", FormatHelper.MonthYear(date.Year, date.Month), date.Year, date.Month));
        }
    }

    private void EnsureSelection()
    {
        if (_options.Count == 0)
            return;
        if (_options.Any(o => o.Key == SelectedKey))
            return;

        var current = new DateOnly(DateTime.Now.Year, DateTime.Now.Month, 1);
        var currentKey = $"{current.Year}-{current.Month}";
        SelectedKey = _options.Any(o => o.Key == currentKey)
            ? currentKey
            : _options[0].Key;
        _ = SelectedKeyChanged.InvokeAsync(SelectedKey);
    }

    private async Task SelectMonthAsync(string key)
    {
        SelectedKey = key;
        await SelectedKeyChanged.InvokeAsync(SelectedKey);
    }

    private void ContinueToScope()
    {
        if (!string.IsNullOrWhiteSpace(SelectedKey))
            _step = ExportStep.Scope;
    }

    private void BackToMonth() => _step = ExportStep.Month;

    private Task HandlePrimaryAsync()
    {
        if (_step == ExportStep.Month)
        {
            ContinueToScope();
            return Task.CompletedTask;
        }

        return OnExport.InvokeAsync();
    }

    private async Task SelectAreaAsync(string value)
    {
        SelectedAreaId = value;
        await SelectedAreaIdChanged.InvokeAsync(value);

        if (string.IsNullOrWhiteSpace(SelectedBoxId))
            return;

        SelectedBoxId = "";
        await SelectedBoxIdChanged.InvokeAsync(SelectedBoxId);
    }

    private async Task SelectBoxAsync(string value)
    {
        SelectedBoxId = value;
        await SelectedBoxIdChanged.InvokeAsync(value);
    }

    private void OnCultureChanged() => _ = InvokeAsync(() =>
    {
        RebuildOptions();
        StateHasChanged();
        return Task.CompletedTask;
    });

    public void Dispose() => CultureService.Changed -= OnCultureChanged;

    private string SelectedMonthLabel =>
        _options.FirstOrDefault(option => option.Key == SelectedKey).Label ?? SelectedKey;

    private enum ExportStep
    {
        Month,
        Scope
    }
}
