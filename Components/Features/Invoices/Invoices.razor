@page "/invoices"
@inject IInvoiceService InvoiceService
@inject ICustomerService CustomerService
@inject IToastService Toast

<div class="space-y-4">
    <InvoicesToolbar Customers="_customers"
                     Skipped="_skipped"
                     @bind-CustomerFilter="_customerFilter"
                     @bind-StatusFilter="_statusFilter"
                     @bind-DateFrom="_dateFrom"
                     @bind-DateTo="_dateTo"
                     TotalCount="_totalCount"
                     ShowSkipped="_showSkipped"
                     PaidTotal="_paidTotal"
                     UnpaidTotal="_unpaidTotal"
                     PartialTotal="_partialTotal"
                     OnFiltersChanged="ReloadFromFiltersAsync"
                     OnToggleSkipped="ToggleSkipped"
                     OnBulkCreate="OpenBulk"
                     OnCreate="OpenCreate" />

    <InvoicesList Items="_items"
                  IsLoading="_loading"
                  OpenMenuId="_openMenuId"
                  PageNumber="_pageNumber"
                  @bind-PageSize="_pageSize"
                  @bind-PageSize:after="ReloadFromFiltersAsync"
                  TotalCount="_totalCount"
                  TotalPages="_totalPages"
                  HasPrevious="_hasPrevious"
                  HasNext="_hasNext"
                  OnToggleMenu="ToggleMenu"
                  OnView="OpenDetails"
                  OnPay="OpenPay"
                  OnDelete="OpenDelete"
                  OnPreviousPage="PrevPageAsync"
                  OnNextPage="NextPageAsync" />
</div>

<CreateInvoiceSheet Open="_showCreate"
                    Customers="_customers"
                    Model="_create"
                    Saving="_saving"
                    OnClose="CloseCreate"
                    OnSave="CreateInvoiceAsync"
                    OnCustomerChanged="OnCreateCustomerChanged" />

<BulkCreateInvoiceSheet Open="_showBulk"
                        @bind-Plan="_bulkPlan"
                        Saving="_saving"
                        OnClose="CloseBulk"
                        OnSave="BulkCreateAsync" />

<PayInvoiceSheet Open="_showPay"
                 Invoice="_payInvoice"
                 Model="_pay"
                 Saving="_saving"
                 OnClose="ClosePay"
                 OnSave="SavePaymentAsync" />

<InvoiceDetailsSheet Open="_showDetails"
                     Invoice="_details"
                     Payments="_payments"
                     OnClose="CloseDetails"
                     OnRecordPayment="OpenPayFromDetails" />

<DeleteInvoiceDialog Open="@(_confirmDelete is not null)"
                     Invoice="_confirmDelete"
                     OnClose="CloseDelete"
                     OnConfirm="ConfirmDeleteAsync" />

@code {
    private readonly List<InvoiceSummaryResponse> _items = [];
    private readonly List<CustomerResponse> _customers = [];
    private readonly List<InvoiceSkippedResponse> _skipped = [];
    private readonly List<PaymentResponse> _payments = [];

    private bool _loading = true;
    private bool _saving;
    private bool _showCreate;
    private bool _showBulk;
    private bool _showPay;
    private bool _showDetails;
    private bool _showSkipped;
    private Guid? _openMenuId;

    private string _customerFilter = "";
    private string _statusFilter = "";
    private DateTime? _dateFrom;
    private DateTime? _dateTo;
    private int _pageNumber = 1;
    private int _pageSize = 10;
    private int _totalCount;
    private int _totalPages;
    private bool _hasPrevious;
    private bool _hasNext;

    private decimal _paidTotal;
    private decimal _unpaidTotal;
    private decimal _partialTotal;

    private CreateInvoiceSheet.CreateFormModel _create = new();
    private string _bulkPlan = "";
    private PayInvoiceSheet.PayFormModel _pay = new();
    private InvoiceSummaryResponse? _payInvoice;
    private InvoiceResponse? _details;
    private InvoiceSummaryResponse? _confirmDelete;

    protected override async Task OnInitializedAsync()
    {
        var customers = await UiActions.RunAsync(Toast, () => CustomerService.GetAllUnpagedAsync()) ?? [];
        _customers.Clear();
        _customers.AddRange(customers.OrderBy(c => c.Name));
        await LoadSkippedAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _openMenuId = null;

        Guid? customerId = Guid.TryParse(_customerFilter, out var c) ? c : null;
        InvoiceStatus? status = Enum.TryParse<InvoiceStatus>(_statusFilter, out var s) ? s : null;
        DateOnly? from = _dateFrom.HasValue ? DateOnly.FromDateTime(_dateFrom.Value) : null;
        DateOnly? to = _dateTo.HasValue ? DateOnly.FromDateTime(_dateTo.Value) : null;

        var filter = new InvoiceFilterRequest(
            CustomerId: customerId,
            InvoiceStatus: status,
            ConsumptionStartFrom: from,
            ConsumptionStartTo: to,
            PageNumber: _pageNumber,
            PageSize: _pageSize);

        var page = await UiActions.RunAsync(Toast, () => InvoiceService.GetAllAsync(filter));
        _items.Clear();
        if (page is not null)
        {
            _items.AddRange(page.Data);
            _totalCount = page.TotalCount;
            _totalPages = page.TotalPages;
            _hasPrevious = page.HasPreviousPage;
            _hasNext = page.HasNextPage;
            _pageNumber = page.PageNumber;
        }
        else
        {
            _totalCount = 0;
            _totalPages = 0;
            _hasPrevious = false;
            _hasNext = false;
        }

        RecalcSummaryCards();
        _loading = false;
    }

    private void RecalcSummaryCards()
    {
        _paidTotal = _items
            .Where(i => i.InvoiceStatus.Equals(nameof(InvoiceStatus.Paid), StringComparison.OrdinalIgnoreCase))
            .Sum(i => i.TotalAmount);
        _unpaidTotal = _items
            .Where(i => i.InvoiceStatus.Equals(nameof(InvoiceStatus.Unpaid), StringComparison.OrdinalIgnoreCase))
            .Sum(i => i.AmountDue);
        _partialTotal = _items
            .Where(i => i.InvoiceStatus.Equals(nameof(InvoiceStatus.PartiallyPaid), StringComparison.OrdinalIgnoreCase))
            .Sum(i => i.AmountDue);
    }

    private async Task LoadSkippedAsync()
    {
        var skipped = await UiActions.RunAsync(Toast, () => InvoiceService.GetSkippedAsync()) ?? [];
        _skipped.Clear();
        _skipped.AddRange(skipped);
    }

    private async Task ToggleSkipped()
    {
        _showSkipped = !_showSkipped;
        if (_showSkipped)
            await LoadSkippedAsync();
    }

    private async Task ReloadFromFiltersAsync()
    {
        _pageNumber = 1;
        await LoadAsync();
    }

    private async Task NextPageAsync()
    {
        if (!_hasNext) return;
        _pageNumber++;
        await LoadAsync();
    }

    private async Task PrevPageAsync()
    {
        if (!_hasPrevious) return;
        _pageNumber--;
        await LoadAsync();
    }

    private void ToggleMenu(Guid id) => _openMenuId = _openMenuId == id ? null : id;

    private void OpenCreate()
    {
        _openMenuId = null;
        _create = new CreateInvoiceSheet.CreateFormModel();
        _showCreate = true;
    }

    private void CloseCreate() => _showCreate = false;

    private void OnCreateCustomerChanged()
    {
        _create.BilledDays = null;
        _create.PaymentAmount = null;
        _create.KilowattAmount = null;
        _create.Notes = "";
        _create.FixedMode = "payment";
        _create.PaymentMethod = PaymentMethod.Cash;
    }

    private async Task CreateInvoiceAsync()
    {
        if (!Guid.TryParse(_create.CustomerId, out var customerId))
        {
            Toast.Error("Select a customer.");
            return;
        }

        var customer = _customers.FirstOrDefault(c => c.Id == customerId);
        int? billedDays = null;
        decimal? paymentAmount = null;
        decimal? kilowattAmount = null;
        PaymentMethod? paymentMethod = null;
        string? notes = null;

        if (customer?.Plan.Equals(nameof(PlanType.Ampere), StringComparison.OrdinalIgnoreCase) == true)
            billedDays = _create.BilledDays is > 0 ? _create.BilledDays : null;

        if (customer?.Plan.Equals(nameof(PlanType.FixedKilowatt), StringComparison.OrdinalIgnoreCase) == true)
        {
            if (_create.FixedMode == "payment")
                paymentAmount = _create.PaymentAmount;
            else
                kilowattAmount = _create.KilowattAmount;
            paymentMethod = _create.PaymentMethod;
            notes = string.IsNullOrWhiteSpace(_create.Notes) ? null : _create.Notes.Trim();
        }

        _saving = true;
        var succeeded = false;
        await UiActions.RunAsync(
            Toast,
            async () =>
            {
                await InvoiceService.CreateAsync(new CreateInvoiceRequest(
                    CustomerId: customerId,
                    BilledDays: billedDays,
                    PaymentAmount: paymentAmount,
                    KilowattAmount: kilowattAmount,
                    PaymentMethod: paymentMethod,
                    Notes: notes));
                succeeded = true;
            },
            "Invoice created");
        _saving = false;
        if (!succeeded) return;
        CloseCreate();
        await LoadAsync();
        await LoadSkippedAsync();
    }

    private void OpenBulk()
    {
        _openMenuId = null;
        _bulkPlan = "";
        _showBulk = true;
    }

    private void CloseBulk() => _showBulk = false;

    private async Task BulkCreateAsync()
    {
        PlanType? plan = Enum.TryParse<PlanType>(_bulkPlan, out var p) ? p : null;
        _saving = true;
        var result = await UiActions.RunAsync(Toast, () => InvoiceService.BulkCreateAsync(plan));
        _saving = false;
        if (result is not null)
        {
            Toast.Success(result.Message);
            CloseBulk();
            await LoadAsync();
            await LoadSkippedAsync();
        }
    }

    private void OpenPay(InvoiceSummaryResponse inv)
    {
        _openMenuId = null;
        _payInvoice = inv;
        _pay = new PayInvoiceSheet.PayFormModel
        {
            Amount = inv.AmountDue,
            PaymentMethod = PaymentMethod.Cash,
            Notes = ""
        };
        _showPay = true;
    }

    private void OpenPayFromDetails()
    {
        if (_details is null) return;
        _payInvoice = new InvoiceSummaryResponse(
            _details.Id,
            _details.InvoiceNumber,
            _details.CustomerName,
            _details.InvoiceStatus,
            _details.ConsumptionStart,
            _details.ConsumptionEnd,
            _details.TotalAmount,
            _details.PaidAmount,
            _details.AmountDue,
            _details.BilledConsumption,
            _details.CreatedAt);
        _pay = new PayInvoiceSheet.PayFormModel
        {
            Amount = _details.AmountDue,
            PaymentMethod = PaymentMethod.Cash,
            Notes = ""
        };
        _showDetails = false;
        _showPay = true;
    }

    private void ClosePay()
    {
        _showPay = false;
        _payInvoice = null;
    }

    private async Task SavePaymentAsync()
    {
        if (_payInvoice is null) return;
        if (_pay.Amount <= 0)
        {
            Toast.Error("Amount must be greater than zero.");
            return;
        }

        _saving = true;
        var invoiceId = _payInvoice.Id;
        var succeeded = false;
        await UiActions.RunAsync(
            Toast,
            async () =>
            {
                await InvoiceService.PayAsync(invoiceId, new AddPaymentRequest(
                    Amount: _pay.Amount,
                    PaymentMethod: _pay.PaymentMethod,
                    Notes: string.IsNullOrWhiteSpace(_pay.Notes) ? null : _pay.Notes.Trim()));
                succeeded = true;
            },
            "Payment recorded");
        _saving = false;
        if (!succeeded) return;
        ClosePay();
        await LoadAsync();
    }

    private async Task OpenDetails(InvoiceSummaryResponse inv)
    {
        _openMenuId = null;
        var detail = await UiActions.RunAsync(Toast, () => InvoiceService.GetByIdAsync(inv.Id));
        if (detail is null) return;
        _details = detail;
        var payments = await UiActions.RunAsync(Toast, () => InvoiceService.GetPaymentsAsync(inv.Id)) ?? detail.Payments;
        _payments.Clear();
        _payments.AddRange(payments);
        _showDetails = true;
    }

    private void CloseDetails()
    {
        _showDetails = false;
        _details = null;
        _payments.Clear();
    }

    private void OpenDelete(InvoiceSummaryResponse inv)
    {
        _openMenuId = null;
        _confirmDelete = inv;
    }

    private void CloseDelete() => _confirmDelete = null;

    private async Task ConfirmDeleteAsync()
    {
        if (_confirmDelete is null) return;
        var id = _confirmDelete.Id;
        var succeeded = false;
        await UiActions.RunAsync(Toast, async () =>
        {
            await InvoiceService.DeleteAsync(id);
            succeeded = true;
        }, "Invoice deleted");
        if (!succeeded) return;
        _confirmDelete = null;
        if (_details?.Id == id) CloseDetails();
        await LoadAsync();
    }
}
