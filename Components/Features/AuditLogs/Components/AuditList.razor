@namespace Shabakat.Components.Features.AuditLogs.Components
@inject IStringLocalizer<SharedResource> L

@if (IsLoading)
{
    <TableSkeleton Columns="5" Rows="6" MinWidthClass="min-w-[760px]" ShowPager="false" />
}
else if (Items.Count == 0)
{
    <section class="rounded-2xl border border-border bg-card">
        <div class="px-4 py-10 text-sm text-muted-foreground">@L["Empty.Audit"]</div>
    </section>
}
else
{
    <section class="rounded-2xl border border-border bg-card">
        <table class="w-full min-w-[760px]">
            <thead>
                <tr class="border-b border-border">
                    <th class="px-4 py-3.5 text-start text-xs font-semibold uppercase tracking-[0.18em] text-muted-foreground">@L["Table.Event"]</th>
                    <th class="px-4 py-3.5 text-start text-xs font-semibold uppercase tracking-[0.18em] text-muted-foreground">@L["Table.Action"]</th>
                    <th class="px-4 py-3.5 text-start text-xs font-semibold uppercase tracking-[0.18em] text-muted-foreground">@L["Table.Entity"]</th>
                    <th class="px-4 py-3.5 text-start text-xs font-semibold uppercase tracking-[0.18em] text-muted-foreground">@L["Common.Status"]</th>
                    <th class="px-4 py-3.5"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var entry in Items)
                {
                    <AuditRow Entry="entry" OnView="() => OnView.InvokeAsync(entry)" />
                }
            </tbody>
        </table>

        <div class="flex flex-col gap-3 border-t border-border px-4 py-3 text-sm text-muted-foreground md:flex-row md:items-center md:justify-between">
            <span>@L["Pager.Showing", (PageNumber - 1) * PageSize + 1, Math.Min(PageNumber * PageSize, TotalCount), TotalCount]</span>
            <div class="flex items-center gap-2 self-end md:self-auto">
                <select class="h-9 w-28 rounded-xl border border-border bg-card px-2 text-sm"
                        value="@PageSize"
                        @onchange="OnPageSizeChanged">
                    <option value="10">@L["Pager.PerPage", 10]</option>
                    <option value="20">@L["Pager.PerPage", 20]</option>
                    <option value="50">@L["Pager.PerPage", 50]</option>
                </select>
                <button type="button" class="rounded-xl border border-border px-3 py-1.5 text-sm disabled:opacity-40" disabled="@(!HasPrevious)" @onclick="OnPrevPage">@L["Common.Previous"]</button>
                <span class="min-w-24 text-center">@L["Pager.PageOf", PageNumber, Math.Max(1, TotalPages)]</span>
                <button type="button" class="rounded-xl border border-border px-3 py-1.5 text-sm disabled:opacity-40" disabled="@(!HasNext)" @onclick="OnNextPage">@L["Common.Next"]</button>
            </div>
        </div>
    </section>
}

@code {
    [Parameter] public IReadOnlyList<AuditLogResponse> Items { get; set; } = [];
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public int TotalCount { get; set; }
    [Parameter] public int PageNumber { get; set; } = 1;
    [Parameter] public int TotalPages { get; set; } = 1;
    [Parameter] public int PageSize { get; set; } = 20;
    [Parameter] public bool HasPrevious { get; set; }
    [Parameter] public bool HasNext { get; set; }
    [Parameter] public EventCallback<int> PageSizeChanged { get; set; }
    [Parameter] public EventCallback OnPrevPage { get; set; }
    [Parameter] public EventCallback OnNextPage { get; set; }
    [Parameter] public EventCallback<AuditLogResponse> OnView { get; set; }

    private async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var size))
            await PageSizeChanged.InvokeAsync(size);
    }
}
