@namespace Shabakat.Components.Features.AuditLogs.Components
@inject IStringLocalizer<SharedResource> L

@if (Status.Equals(nameof(AuditLogStatus.Failed), StringComparison.OrdinalIgnoreCase))
{
    <span class="inline-flex items-center gap-1 rounded-full border border-red-400/20 bg-red-400/10 px-2.5 py-0.5 text-xs font-semibold text-red-400">
        @L["Status.Failed"]
    </span>
}
else
{
    <span class="inline-flex items-center gap-1 rounded-full border border-emerald-400/20 bg-emerald-400/10 px-2.5 py-0.5 text-xs font-semibold text-emerald-400">
        @L["Status.Success"]
    </span>
}

@code {
    [Parameter] public string Status { get; set; } = nameof(AuditLogStatus.Success);
}
