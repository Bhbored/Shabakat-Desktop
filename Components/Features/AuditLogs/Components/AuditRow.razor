@namespace Shabakat.Components.Features.AuditLogs.Components
@inject IStringLocalizer<SharedResource> L

<tr class="cursor-pointer border-b border-border transition-colors hover:bg-muted/30"
    @onclick="OnView">
    <td class="px-4 py-3.5 align-middle">
        <p class="font-medium text-foreground">@AuditLabels.Summary(Entry, L)</p>
        <p class="mt-0.5 text-xs text-muted-foreground">@FormatHelper.Date(Entry.CreatedAt) · @Entry.CreatedAt.ToString("HH:mm")</p>
    </td>
    <td class="px-4 py-3.5 align-middle">
        <AuditActionBadge Action="@Entry.Action" />
    </td>
    <td class="px-4 py-3.5 align-middle">
        <span class="text-sm text-foreground">@AuditLabels.EntityType(Entry.EntityType, L)</span>
    </td>
    <td class="px-4 py-3.5 align-middle">
        <AuditStatusBadge Status="@Entry.Status" />
    </td>
    <td class="px-4 py-3.5 align-middle">
        <div class="flex justify-end">
            <button type="button"
                    class="rounded-lg p-1 text-muted-foreground hover:bg-muted hover:text-foreground"
                    aria-label="@L["Audit.ViewEvent"]"
                    @onclick="OnView"
                    @onclick:stopPropagation="true">
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
            </button>
        </div>
    </td>
</tr>

@code {
    [Parameter, EditorRequired] public AuditLogResponse Entry { get; set; } = null!;
    [Parameter] public EventCallback OnView { get; set; }
}
