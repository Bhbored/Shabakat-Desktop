@namespace Shabakat.Components.Features.Expenses.Components
@inject IStringLocalizer<SharedResource> L

<ConfirmDialog Open="Open"
               Title="@L["Expenses.DeleteTitle"]"
               Description="@DeleteDescription"
               OnClose="OnClose">
    <Footer>
        <button type="button" class="rounded-xl border border-border px-4 py-2.5 text-sm text-foreground hover:bg-muted" @onclick="OnClose">@L["Common.Cancel"]</button>
        <button type="button"
                class="rounded-xl bg-red-500 px-4 py-2.5 text-sm font-medium text-white hover:bg-red-500/90 disabled:opacity-50"
                disabled="@Saving"
                @onclick="OnConfirm">
            @(Saving ? L["Common.Deleting"] : L["Expenses.DeleteExpense"])
        </button>
    </Footer>
</ConfirmDialog>

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public ExpenseResponse? Expense { get; set; }
    [Parameter] public bool Saving { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnConfirm { get; set; }

    private string DeleteDescription
    {
        get
        {
            var name = string.IsNullOrWhiteSpace(Expense?.Label) ? L["Expenses.ThisExpense"].Value : Expense.Label;
            return L["Expenses.DeleteConfirm", name].Value;
        }
    }
}
