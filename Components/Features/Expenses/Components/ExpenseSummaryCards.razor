@namespace Shabakat.Components.Features.Expenses.Components

@if (IsLoading)
{
    <div class="grid gap-4 md:grid-cols-3">
        @for (var i = 0; i < 3; i++)
        {
            <MetricCardSkeleton />
        }
    </div>
}
else
{
    <div class="grid gap-4 md:grid-cols-3">
        <section class="rounded-2xl border border-border bg-card p-5">
            <div class="flex items-center gap-3">
                <div class="rounded-xl border border-border bg-muted/40 p-2 text-primary">
                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="14" x="2" y="6" rx="2"/><circle cx="16" cy="12" r="2"/><path d="M22 10v8a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6c0-1.1.9-2 2-2h16a2 2 0 0 1 2 2"/></svg>
                </div>
                <p class="text-xs font-semibold uppercase tracking-[0.18em] text-muted-foreground">Total Matching Spend</p>
            </div>
            <p class="mt-4 text-3xl font-semibold text-foreground">@FormatHelper.Currency(TotalAmount)</p>
            <p class="mt-3 text-sm text-muted-foreground">Across all server-matched rows, not only current page.</p>
        </section>
        <section class="rounded-2xl border border-border bg-card p-5">
            <div class="flex items-center gap-3">
                <div class="rounded-xl border border-border bg-muted/40 p-2 text-primary">
                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 2v20l2-1 2 1 2-1 2 1 2-1 2 1 2-1 2 1V2l-2 1-2-1-2 1-2-1-2 1-2-1-2 1Z"/><path d="M8 7h8"/><path d="M8 11h8"/><path d="M8 15h5"/></svg>
                </div>
                <p class="text-xs font-semibold uppercase tracking-[0.18em] text-muted-foreground">Matching Expenses</p>
            </div>
            <p class="mt-4 text-3xl font-semibold text-foreground">@TotalCount</p>
            <p class="mt-3 text-sm text-muted-foreground">Count of rows matching current backend filters.</p>
        </section>
        <section class="rounded-2xl border border-border bg-card p-5">
            <div class="flex items-center gap-3">
                <div class="rounded-xl border border-border bg-muted/40 p-2 text-primary">
                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M21 9H3"/><path d="M21 15H3"/></svg>
                </div>
                <p class="text-xs font-semibold uppercase tracking-[0.18em] text-muted-foreground">Current Page Spend</p>
            </div>
            <p class="mt-4 text-3xl font-semibold text-foreground">@FormatHelper.Currency(PageAmount)</p>
            <p class="mt-3 text-sm text-muted-foreground">
                Current page holds @CurrentPageCount @(CurrentPageCount == 1 ? "row." : "rows.")
            </p>
        </section>
    </div>
}

@code {
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public decimal TotalAmount { get; set; }
    [Parameter] public int TotalCount { get; set; }
    [Parameter] public decimal PageAmount { get; set; }
    [Parameter] public int CurrentPageCount { get; set; }
}
