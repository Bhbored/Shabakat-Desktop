@namespace Shabakat.Components.Features.Expenses.Components

<SideSheet Open="Open"
           Title="@(IsEdit ? "Edit Expense" : "Add Expense")"
           Description="@(IsEdit
               ? "Edit the expense line item and keep dashboard totals current."
               : "Track fuel, maintenance, payroll, and other operating costs.")"
           MaxWidthClass="sm:max-w-xl"
           OnClose="OnClose">
    <TitleIcon>
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 15h2a2 2 0 1 0 0-4h-3c-.6 0-1.1.2-1.4.6L3 17"/><path d="m7 21 1.6-1.4c.3-.4.8-.6 1.4-.6h4c1.1 0 2.1-.4 2.8-1.2l4.6-4.4a2 2 0 0 0-2.75-2.91l-4.2 3.9"/><path d="m2 16 6 6"/><circle cx="16" cy="9" r="2.9"/><circle cx="6" cy="5" r="3"/></svg>
    </TitleIcon>
    <ChildContent>
        <div class="space-y-6">
            <div class="grid gap-4 md:grid-cols-2">
                <div>
                    <label class="mb-1.5 block text-sm font-medium text-foreground">Expense Type</label>
                    <select class="@InputClass"
                            value="@Type"
                            @onchange="OnTypeChanged">
                        @foreach (var type in Enum.GetValues<ExpenseType>())
                        {
                            <option value="@type">@type</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="mb-1.5 block text-sm font-medium text-foreground">Amount</label>
                    <input type="number"
                           step="0.01"
                           min="0.0001"
                           placeholder="250"
                           class="@InputClass"
                           value="@Amount"
                           @onchange="OnAmountChanged" />
                </div>
            </div>

            <div class="grid gap-4 md:grid-cols-2">
                <div>
                    <label class="mb-1.5 block text-sm font-medium text-foreground">Expense Date</label>
                    <input type="date"
                           class="@InputClass"
                           value="@Date.ToString("yyyy-MM-dd")"
                           @onchange="OnDateChanged" />
                </div>
                <div>
                    <label class="mb-1.5 block text-sm font-medium text-foreground">
                        @(Type == ExpenseType.Other ? "Label" : "Label (Optional)")
                    </label>
                    <input type="text"
                           maxlength="100"
                           class="@InputClass"
                           value="@Label"
                           @onchange="OnLabelChanged"
                           placeholder="@(Type == ExpenseType.Other ? "Rent, Insurance..." : "Optional category")" />
                </div>
            </div>

            <div>
                <label class="mb-1.5 block text-sm font-medium text-foreground">Notes</label>
                <textarea maxlength="500"
                          rows="6"
                          class="@InputClass"
                          placeholder="Optional internal note..."
                          value="@Notes"
                          @onchange="OnNotesChanged"></textarea>
            </div>

            <p class="text-sm text-muted-foreground">@TypeDescription</p>

            <div class="flex flex-col gap-3 border-t border-border pt-5 md:flex-row md:items-center md:justify-between">
                <p class="text-sm text-muted-foreground">Expenses update dashboard totals after successful save.</p>
                <div class="flex items-center gap-3">
                    <button type="button"
                            class="rounded-xl border border-border px-4 py-2.5 text-sm font-medium text-foreground hover:bg-muted"
                            @onclick="OnClose">
                        Cancel
                    </button>
                    <button type="button"
                            class="inline-flex items-center gap-2 rounded-xl bg-primary px-4 py-2.5 text-sm font-medium text-primary-foreground disabled:opacity-50"
                            disabled="@Saving"
                            @onclick="OnSave">
                        @if (Saving)
                        {
                            <svg class="h-4 w-4 animate-spin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 1 1-6.219-8.56" /></svg>
                        }
                        @(IsEdit ? "Save Changes" : "Create Expense")
                    </button>
                </div>
            </div>
        </div>
    </ChildContent>
</SideSheet>

@code {
    private const string InputClass = "w-full rounded-xl border border-border bg-background px-3 py-2.5 text-sm text-foreground outline-none focus:border-primary";

    [Parameter] public bool Open { get; set; }
    [Parameter] public bool IsEdit { get; set; }
    [Parameter] public bool Saving { get; set; }
    [Parameter] public ExpenseType Type { get; set; } = ExpenseType.Fuel;
    [Parameter] public EventCallback<ExpenseType> TypeChanged { get; set; }
    [Parameter] public decimal Amount { get; set; }
    [Parameter] public EventCallback<decimal> AmountChanged { get; set; }
    [Parameter] public DateOnly Date { get; set; }
    [Parameter] public EventCallback<DateOnly> DateChanged { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public EventCallback<string?> LabelChanged { get; set; }
    [Parameter] public string? Notes { get; set; }
    [Parameter] public EventCallback<string?> NotesChanged { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnSave { get; set; }

    private string TypeDescription => Type switch
    {
        ExpenseType.Fuel => "Generator diesel, oil, and fuel logistics.",
        ExpenseType.Maintenance => "Servicing, repairs, and spare parts.",
        ExpenseType.Employees => "Payroll and operating staff costs.",
        _ => "Custom operational expense with label."
    };

    private async Task OnTypeChanged(ChangeEventArgs e)
    {
        if (Enum.TryParse<ExpenseType>(e.Value?.ToString(), out var type))
            await TypeChanged.InvokeAsync(type);
    }

    private async Task OnAmountChanged(ChangeEventArgs e)
    {
        if (decimal.TryParse(e.Value?.ToString(), out var amount))
            await AmountChanged.InvokeAsync(amount);
        else
            await AmountChanged.InvokeAsync(0);
    }

    private async Task OnDateChanged(ChangeEventArgs e)
    {
        if (DateOnly.TryParse(e.Value?.ToString(), out var date))
            await DateChanged.InvokeAsync(date);
    }

    private Task OnLabelChanged(ChangeEventArgs e)
        => LabelChanged.InvokeAsync(e.Value?.ToString());

    private Task OnNotesChanged(ChangeEventArgs e)
        => NotesChanged.InvokeAsync(e.Value?.ToString());
}
